import { ThemedButton } from "components/themed-button.slint";
import { ChoiceDropdown } from "components/choice-dropdown.slint";
import { KeyValueEditor, KeyValueRow } from "components/key-value-editor.slint";
import { LineEdit, TextEdit, ScrollView, Palette } from "std-widgets.slint";
export struct RequestItem {
    id: int,
    name: string,
    method: string,
    url: string,
}
export struct CollectionItem {
    id: int,
    name: string,
}
export struct VariableItem {
    key: string,
    value: string,
}
export struct EnvironmentItem {
    collection-id: int,
    collection-name: string,
    key: string,
    value: string,
}
export struct HistoryItem {
    request-id: int,
    request-name: string,
    collection-name: string,
    method: string,
    url: string,
    status: string,
    duration: string,
    date: string,
}
export struct ResponseHeaderItem {
    name: string,
    value: string,
}
export struct ResponseCookieItem {
    name: string,
    value: string,
    attributes: string,
}
export component AppWindow inherits Window {
    title: "Resonance";
    width: 1200px;
    height: 760px;
    default-font-family: "Cantarell";
    background: window-bg;
    forward-focus: shortcut-scope;

    callback send-request(string, string, string, string, string, string, string, string, string, int, int, string);
    callback save-request(int, int, string, string, string, string, string, string, string, string, string, string);
    callback serialize-param-rows([KeyValueRow]) -> string;
    callback serialize-header-rows([KeyValueRow]) -> string;
    callback load-collections();
    callback load-requests(int);
    callback search-requests(string);
    callback load-history(string);
    callback load-environments();
    callback run-collection(int);
    callback load-collection-variables(int);
    callback create-collection(string);
    callback rename-collection(int, string);
    callback delete-collection(int);
    callback save-collection-variable(int, string, string);
    callback delete-collection-variable(int, string);
    callback select-request(int);
    callback delete-request(int, int);
    callback refresh-system-theme();

    in-out property <[RequestItem]> saved-requests: [];
    in-out property <[CollectionItem]> collections: [];
    in-out property <[VariableItem]> collection-variables: [];
    in-out property <[EnvironmentItem]> environment-items: [];
    in-out property <[HistoryItem]> history-items: [];
    in-out property <int> active-request-id: -1;
    in-out property <int> selected-collection-id: -1;
    in-out property <int> collection-menu-id: -1;
    in-out property <int> editing-collection-id: -1;
    in-out property <string> collection-name-draft: "";
    in-out property <string> selected-collection-name: "";
    in-out property <string> request-search: "";
    in-out property <string> active-view: "Request";
    in-out property <string> history-sort: "Newest first";
    in-out property <string> new-collection-name: "";
    in-out property <bool> show-new-collection: false;
    in-out property <int> confirm-delete-collection-id: -1;
    in-out property <string> variable-key: "";
    in-out property <string> variable-value: "";
    in-out property <string> variables-message: "";
    in-out property <bool> show-variable-values: false;
    in-out property <string> theme-mode: "System";
    in-out property <bool> show-navigation-sidebar: true;
    in-out property <string> active-request: "New Request";
    in-out property <bool> editing-request-name: false;
    in-out property <string> request-name-draft: "";
    in-out property <string> active-method: "GET";
    in-out property <string> request-url: "";
    in-out property <string> active-tab: "Body";

    in-out property <string> request-params: "";
    in-out property <[KeyValueRow]> request-param-rows: [];
    in-out property <string> request-body: "";
    in-out property <string> body-format: "JSON";
    in-out property <string> request-headers: "Accept: application/json";
    in-out property <[KeyValueRow]> request-header-rows: [{ key: "Accept", value: "application/json", enabled: true }];
    in-out property <string> header-preset: "Add a preset…";
    in-out property <string> auth-type: "None";
    in-out property <string> auth-value: "";
    in-out property <string> auth-secret: "";
    in-out property <string> response-status: "No response yet";
    in-out property <string> response-body: "Send a request to inspect its response.";
    in-out property <string> response-time: "---";
    in-out property <string> response-state: "idle";
    in-out property <string> response-format: "Text";
    in-out property <string> response-headers: "";
    in-out property <string> response-cookies: "";
    in-out property <[ResponseHeaderItem]> response-header-items: [];
    in-out property <[ResponseCookieItem]> response-cookie-items: [];
    in-out property <string> response-tab: "Body";
    in-out property <bool> is-loading: false;

    // Keep the system appearance before applying an explicit per-app override.
    in-out property <bool> system-dark-mode: Palette.color-scheme == ColorScheme.dark;
    in-out property <string> previous-theme-mode: "System";

    property <bool> dark-mode:
        root.theme-mode == "Dark" ? true :
        root.theme-mode == "Light" ? false :
        root.system-dark-mode;

    // Keep explicit appearance overrides separate from the detected system preference.
    changed theme-mode => {
        if (root.previous-theme-mode == "System" && root.theme-mode != "System") {
            root.system-dark-mode = Palette.color-scheme == ColorScheme.dark;
        }

        if (root.theme-mode == "System") {
            root.refresh-system-theme();
        }

        Palette.color-scheme =
            root.theme-mode == "Dark" ? ColorScheme.dark :
            root.theme-mode == "Light" ? ColorScheme.light :
            root.system-dark-mode ? ColorScheme.dark : ColorScheme.light;
        root.previous-theme-mode = root.theme-mode;
    }

    changed system-dark-mode => {
        if (root.theme-mode == "System") {
            Palette.color-scheme = root.system-dark-mode ? ColorScheme.dark : ColorScheme.light;
        }
    }

    property <color> window-bg: dark-mode ? #222226 : #f6f5f4;
    property <color> sidebar-bg: dark-mode ? #2c2c30 : #efeeec;
    property <color> panel-bg: dark-mode ? #252528 : #ffffff;
    property <color> editor-bg: dark-mode ? #1e1e21 : #ffffff;
    property <color> border-color: dark-mode ? #3d3d42 : #deddda;
    property <color> text-primary: dark-mode ? #f6f5f4 : #241f31;
    property <color> text-secondary: dark-mode ? #b8b7b2 : #5e5c64;
    in-out property <color> system-accent-color: #3584e4;
    property <color> accent: root.system-accent-color;
    property <color> selected-bg: dark-mode ? #45454a : #e3e2e0;
    property <color> hover-bg: dark-mode ? #38383c : #e8e7e5;

    function add-header-preset(name: string) {
        if name != "Add a preset…" {
            let value = name == "Accept" ? "application/json" :
                name == "Content-Type" ? "application/json" :
                name == "Cache-Control" ? "no-cache" :
                name == "User-Agent" ? "Resonance" : "";
            let updated = root.request-header-rows;
            updated.push({ key: name, value: value, enabled: true });
            root.request-header-rows = updated;
            root.request-headers = root.serialize-header-rows(root.request-header-rows);
            root.header-preset = "Add a preset…";
        }
    }

    function start-new-request(collection-id: int, collection-name: string) {
        root.selected-collection-id = collection-id;
        root.selected-collection-name = collection-name;
        root.active-view = "Request";
        root.active-request-id = -1;
        root.active-request = "New Request";
        root.request-name-draft = "New Request";
        root.editing-request-name = false;
        root.is-loading = false;
        root.response-status = "No response yet";
        root.response-state = "idle";
        root.response-format = "Text";
        root.response-body = "Send a request to inspect its response.";
        root.response-headers = "";
        root.response-cookies = "";
        root.response-header-items = [];
        root.response-cookie-items = [];
        root.response-time = "---";
        root.active-method = "GET";
        root.request-url = "";
        root.request-params = "";
        root.request-param-rows = [];
        root.request-body = "";
        root.body-format = "JSON";
        root.request-headers = "Accept: application/json";
        root.request-header-rows = [{ key: "Accept", value: "application/json", enabled: true }];
        root.auth-type = "None";
        root.auth-value = "";
        root.auth-secret = "";
        root.active-tab = "Body";
        root.collection-menu-id = -1;
        root.confirm-delete-collection-id = -1;
        if collection-id > 0 {
            root.load-requests(collection-id);
            root.load-collection-variables(collection-id);
        }
    }

    function save-current-request() {
        if root.active-view == "Request" && root.selected-collection-id > 0 && root.request-url != "" && root.active-request != "" {
            root.save-request(
                root.active-request-id,
                root.selected-collection-id,
                root.active-request,
                root.active-method,
                root.request-url,
                root.request-headers,
                root.request-params,
                root.request-body,
                root.body-format,
                root.auth-type,
                root.auth-value,
                root.auth-secret
            );
        }
    }

    function send-current-request() {
        if root.active-view == "Request" && !root.is-loading && root.selected-collection-id > 0 && root.request-url != "" && root.active-request != "" {
            root.is-loading = true;
            root.response-status = "Sending...";
            root.response-state = "loading";
            root.response-format = "Text";
            root.response-body = "Waiting for response...";
            root.response-headers = "";
            root.response-cookies = "";
            root.response-header-items = [];
            root.response-cookie-items = [];
            root.response-time = "---";
            root.response-tab = "Body";
            root.send-request(
                root.active-method,
                root.request-url,
                root.request-body,
                root.request-headers,
                root.request-params,
                root.body-format,
                root.auth-type,
                root.auth-value,
                root.auth-secret,
                root.selected-collection-id,
                root.active-request-id,
                root.active-request
            );
        }
    }

    shortcut-scope := FocusScope {
        width: 100%;
        height: 100%;

    HorizontalLayout {
        spacing: 0;

        // LEFT PANE — Navigation
        Rectangle {
            width: root.show-navigation-sidebar ? 220px : 0px;
            opacity: root.show-navigation-sidebar ? 1 : 0;
            clip: true;
            background: sidebar-bg;
            animate width { duration: 260ms; easing: cubic-bezier(0.2, 0, 0, 1); }
            animate opacity { duration: 180ms; easing: ease-out; }

            VerticalLayout {
                padding: 14px;
                spacing: 12px;

                HorizontalLayout {
                    spacing: 9px;
                    height: 42px;

                    Rectangle {
                        width: 28px;
                        height: 42px;
                        background: transparent;
                        Image {
                            x: 0px;
                            y: 7px;
                            width: 28px;
                            height: 28px;
                            source: @image-url("../assets/logo/resonance-logo.svg");
                            image-fit: contain;
                        }
                    }

                    Text {
                        text: "Resonance";
                        color: text-primary;
                        height: 42px;
                        font-size: 18px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }

                ThemedButton {
                    accent-color: root.accent;
                    text: "New Request";
                    icon: @image-url("../assets/icons/new.png");
                    dark-mode: root.dark-mode;
                    accent-button: true;
                    width: 100%;

                    clicked => {
                        root.start-new-request(root.selected-collection-id, root.selected-collection-name);
                    }
                }

                Rectangle {
                    height: 1px;
                    background: border-color;
                }

                Text {
                    text: "WORKSPACE";
                    color: text-secondary;
                    font-size: 10px;
                    font-weight: 700;
                }

                for item in ["Collections", "History", "Environments"] : Rectangle {
                    height: 36px;
                    border-radius: 8px;
                    background: nav-touch.has-hover ? hover-bg : transparent;

                    nav-touch := TouchArea {
                        clicked => {
                            if item == "History" {
                                root.active-view = "History";
                                root.load-history(root.history-sort);
                            } else if item == "Collections" {
                                root.active-view = "Collections";
                            } else {
                                root.active-view = "Environments";
                                root.load-environments();
                            }
                        }
                    }

                    Text {
                        x: 11px;
                        text: item;
                        color: text-primary;
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    height: 1px;
                    background: border-color;
                }

                HorizontalLayout {
                    height: 28px;
                    spacing: 6px;

                    Text {
                        text: "COLLECTIONS";
                        color: text-secondary;
                        font-size: 10px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        background: transparent;
                    }

                    ThemedButton {
                        accent-color: root.accent;
                        width: 28px;
                        height: 28px;
                        icon: @image-url("../assets/icons/new.png");
                        dark-mode: root.dark-mode;
                        accent-button: false;
                        clicked => {
                            root.show-new-collection = !root.show-new-collection;
                            root.variables-message = "";
                            if root.show-new-collection {
                                root.new-collection-name = "";
                            }
                        }
                    }
                }

                if root.show-new-collection : Rectangle {
                    background: panel-bg;
                    border-width: 1px;
                    border-color: border-color;
                    border-radius: 9px;

                    VerticalLayout {
                        padding: 9px;
                        spacing: 7px;

                        Text {
                            text: "Create a collection";
                            color: text-primary;
                            font-size: 12px;
                            font-weight: 600;
                        }

                        LineEdit {
                            text: root.new-collection-name;
                            placeholder-text: "Collection name";
                            edited(value) => { root.new-collection-name = value; }
                        }

                        HorizontalLayout {
                            spacing: 6px;
                            ThemedButton {
                                accent-color: root.accent;
                                horizontal-stretch: 1;
                                text: "Create";
                                icon: @image-url("../assets/icons/new.png");
                                dark-mode: root.dark-mode;
                                accent-button: true;
                                enabled: root.new-collection-name != "";
                                clicked => root.create-collection(root.new-collection-name);
                            }
                            ThemedButton {
                                accent-color: root.accent;
                                width: 68px;
                                text: "Cancel";
                                icon: @image-url("../assets/icons/close.png");
                                dark-mode: root.dark-mode;
                                accent-button: false;
                                clicked => {
                                    root.show-new-collection = false;
                                    root.new-collection-name = "";
                                    root.variables-message = "";
                                }
                            }
                        }

                        if root.variables-message != "" : Text {
                            text: root.variables-message;
                            color: root.dark-mode ? #ff7b63 : #c01c28;
                            font-size: 10px;
                            wrap: word-wrap;
                        }
                    }
                }

                for collection in root.collections : VerticalLayout {
                    spacing: 2px;

                    collection-row := Rectangle {
                        height: 36px;
                        border-radius: 8px;
                        background: root.selected-collection-id == collection.id ? selected-bg
                            : collection-touch.has-hover ? hover-bg : transparent;

                        collection-touch := TouchArea {
                            clicked => {
                                root.start-new-request(collection.id, collection.name);
                            }
                            pointer-event(event) => {
                                if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                                    root.confirm-delete-collection-id = -1;
                                    root.editing-collection-id = -1;
                                    root.collection-menu-id = collection.id;
                                    collection-menu-popup.show();
                                }
                            }
                        }

                        HorizontalLayout {
                            x: 10px;
                            y: 3px;
                            width: parent.width - 16px;
                            height: 30px;
                            spacing: 4px;

                            if root.editing-collection-id == collection.id : LineEdit {
                                horizontal-stretch: 1;
                                height: 28px;
                                text: root.collection-name-draft;
                                placeholder-text: "Collection name";
                                edited(value) => { root.collection-name-draft = value; }
                            }
                            if root.editing-collection-id != collection.id : Text {
                                horizontal-stretch: 1;
                                text: collection.name;
                                color: root.selected-collection-id == collection.id ? text-primary : text-secondary;
                                font-size: 13px;
                                font-weight: root.selected-collection-id == collection.id ? 600 : 400;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            if root.editing-collection-id == collection.id : ThemedButton {
                                accent-color: root.accent;
                                width: 28px;
                                height: 28px;
                                icon: @image-url("../assets/icons/save(right).png");
                                dark-mode: root.dark-mode;
                                accent-button: true;
                                enabled: root.collection-name-draft != "";
                                clicked => root.rename-collection(collection.id, root.collection-name-draft);
                            }

                            if root.editing-collection-id == collection.id : ThemedButton {
                                accent-color: root.accent;
                                width: 28px;
                                height: 28px;
                                icon: @image-url("../assets/icons/close.png");
                                dark-mode: root.dark-mode;
                                accent-button: false;
                                clicked => { root.editing-collection-id = -1; }
                            }

                            if root.editing-collection-id != collection.id : ThemedButton {
                                accent-color: root.accent;
                                width: 28px;
                                height: 28px;
                                text: "⋯";
                                dark-mode: root.dark-mode;
                                accent-button: false;
                                clicked => {
                                    root.collection-menu-id = collection.id;
                                    collection-menu-popup.show();
                                }
                            }
                        }

                        collection-menu-popup := PopupWindow {
                            x: 0px;
                            y: collection-row.y > 430px ? -262px : collection-row.height + 4px;
                            width: collection-row.width;
                            height: 258px;
                            close-policy: close-on-click-outside;
                            forward-focus: menu-focus;

                            Rectangle {
                                background: root.dark-mode ? #303034 : #ffffff;
                                border-width: 1px;
                                border-color: root.dark-mode ? #4b4b51 : #deddda;
                                border-radius: 13px;
                                drop-shadow-color: #00000066;
                                drop-shadow-blur: 16px;
                                drop-shadow-offset-y: 5px;

                                VerticalLayout {
                                    padding: 10px;
                                    spacing: 4px;

                                    VerticalLayout {
                                        spacing: 2px;
                                        Text {
                                            text: "COLLECTION";
                                            font-family: "Cantarell";
                                            color: accent;
                                            font-size: 9px;
                                            font-weight: 700;
                                            letter-spacing: 0.5px;
                                        }
                                        Text {
                                            text: collection.name;
                                            font-family: "Cantarell";
                                            color: text-primary;
                                            font-size: 14px;
                                            font-weight: 700;
                                            overflow: elide;
                                        }
                                    }

                                    Rectangle { height: 1px; background: border-color; }

                                    Rectangle {
                                        height: 34px;
                                        border-radius: 8px;
                                        background: root.dark-mode ? #294c70 : #e5f0ff;
                                        HorizontalLayout {
                                            x: 10px;
                                            width: parent.width - 20px;
                                            height: parent.height;
                                            spacing: 9px;
                                            Image {
                                                y: (parent.height - self.height) / 2;
                                                width: 15px;
                                                height: 15px;
                                                source: @image-url("../assets/icons/new.png");
                                                image-fit: contain;
                                                colorize: accent;
                                            }
                                            Text {
                                                text: "New request";
                                                font-family: "Cantarell";
                                                color: text-primary;
                                                height: parent.height;
                                                font-size: 12px;
                                                font-weight: 600;
                                                vertical-alignment: center;
                                            }
                                        }
                                        new-request-touch := TouchArea {
                                            width: parent.width;
                                            height: parent.height;
                                            clicked => {
                                                root.collection-menu-id = -1;
                                                collection-menu-popup.close();
                                                root.start-new-request(collection.id, collection.name);
                                            }
                                        }
                                    }

                                    Rectangle {
                                        height: 34px;
                                        border-radius: 8px;
                                        background: run-touch.has-hover ? hover-bg : transparent;
                                        HorizontalLayout {
                                            x: 10px;
                                            width: parent.width - 20px;
                                            height: parent.height;
                                            spacing: 9px;
                                            Image {
                                                y: (parent.height - self.height) / 2;
                                                width: 15px;
                                                height: 15px;
                                                source: @image-url("../assets/icons/send.png");
                                                image-fit: contain;
                                                colorize: text-secondary;
                                            }
                                            Text { text: "Run all requests"; font-family: "Cantarell"; color: text-primary; height: parent.height; font-size: 12px; vertical-alignment: center; }
                                        }
                                        run-touch := TouchArea {
                                            width: parent.width;
                                            height: parent.height;
                                            clicked => {
                                                root.collection-menu-id = -1;
                                                collection-menu-popup.close();
                                                root.run-collection(collection.id);
                                            }
                                        }
                                    }

                                    Rectangle {
                                        height: 34px;
                                        border-radius: 8px;
                                        background: variables-touch.has-hover ? hover-bg : transparent;
                                        HorizontalLayout {
                                            x: 10px;
                                            width: parent.width - 20px;
                                            height: parent.height;
                                            spacing: 9px;
                                            Image {
                                                y: (parent.height - self.height) / 2;
                                                width: 15px;
                                                height: 15px;
                                                source: @image-url("../assets/icons/menu.png");
                                                image-fit: contain;
                                                colorize: text-secondary;
                                            }
                                            Text { text: "Collection variables"; font-family: "Cantarell"; color: text-primary; height: parent.height; font-size: 12px; vertical-alignment: center; }
                                        }
                                        variables-touch := TouchArea {
                                            width: parent.width;
                                            height: parent.height;
                                            clicked => {
                                                root.selected-collection-id = collection.id;
                                                root.selected-collection-name = collection.name;
                                                root.active-view = "Variables";
                                                root.variables-message = "";
                                                root.collection-menu-id = -1;
                                                collection-menu-popup.close();
                                                root.load-collection-variables(collection.id);
                                            }
                                        }
                                    }

                                    Rectangle { height: 1px; background: border-color; }

                                    Rectangle {
                                        height: 34px;
                                        border-radius: 8px;
                                        background: rename-touch.has-hover ? hover-bg : transparent;
                                        HorizontalLayout {
                                            x: 10px;
                                            width: parent.width - 20px;
                                            height: parent.height;
                                            spacing: 9px;
                                            Image {
                                                y: (parent.height - self.height) / 2;
                                                width: 15px;
                                                height: 15px;
                                                source: @image-url("../assets/icons/edit.png");
                                                image-fit: contain;
                                                colorize: text-secondary;
                                            }
                                            Text { text: "Rename collection"; font-family: "Cantarell"; color: text-primary; height: parent.height; font-size: 12px; vertical-alignment: center; }
                                        }
                                        rename-touch := TouchArea {
                                            width: parent.width;
                                            height: parent.height;
                                            clicked => {
                                                root.editing-collection-id = collection.id;
                                                root.collection-name-draft = collection.name;
                                                root.collection-menu-id = -1;
                                                collection-menu-popup.close();
                                            }
                                        }
                                    }

                                    Rectangle {
                                        height: 34px;
                                        border-radius: 8px;
                                        background: delete-touch.has-hover ? (root.dark-mode ? #48292a : #fce3e1) : transparent;
                                        HorizontalLayout {
                                            x: 10px;
                                            width: parent.width - 20px;
                                            height: parent.height;
                                            spacing: 9px;
                                            Image {
                                                y: (parent.height - self.height) / 2;
                                                width: 15px;
                                                height: 15px;
                                                source: @image-url("../assets/icons/close.png");
                                                image-fit: contain;
                                                colorize: root.dark-mode ? #ff7b63 : #c01c28;
                                            }
                                            Text {
                                                text: "Delete collection";
                                                font-family: "Cantarell";
                                                color: root.dark-mode ? #ff7b63 : #c01c28;
                                                height: parent.height;
                                                font-size: 12px;
                                                vertical-alignment: center;
                                            }
                                        }
                                        delete-touch := TouchArea {
                                            width: parent.width;
                                            height: parent.height;
                                            enabled: root.collections.length > 1;
                                            clicked => {
                                                root.confirm-delete-collection-id = collection.id;
                                                root.collection-menu-id = -1;
                                                collection-menu-popup.close();
                                            }
                                        }
                                    }
                                }
                            }

                            menu-focus := FocusScope {
                                key-pressed(event) => {
                                    if event.text == Key.Escape {
                                        root.collection-menu-id = -1;
                                        collection-menu-popup.close();
                                        return accept;
                                    }
                                    return reject;
                                }
                            }
                        }
                    }

                    if root.confirm-delete-collection-id == collection.id : Rectangle {
                        background: panel-bg;
                        border-width: 1px;
                        border-color: root.dark-mode ? #70443f : #e5b7b2;
                        border-radius: 8px;
                        VerticalLayout {
                            padding: 8px;
                            spacing: 6px;
                            Text {
                                text: "Delete collection and its requests?";
                                color: text-secondary;
                                font-size: 10px;
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                spacing: 5px;
                                ThemedButton {
                                    accent-color: root.accent;
                                    horizontal-stretch: 1;
                                    height: 27px;
                                    text: "Cancel";
                                    dark-mode: root.dark-mode;
                                    accent-button: false;
                                    clicked => { root.confirm-delete-collection-id = -1; }
                                }
                                ThemedButton {
                                    accent-color: root.accent;
                                    horizontal-stretch: 1;
                                    height: 27px;
                                    text: "Delete";
                                    dark-mode: root.dark-mode;
                                    accent-button: false;
                                    destructive-button: true;
                                    enabled: root.collections.length > 1;
                                    clicked => root.delete-collection(collection.id);
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                    background: transparent;
                }

                Text {
                    text: "APPEARANCE";
                    color: text-secondary;
                    font-size: 10px;
                    font-weight: 700;
                }

                HorizontalLayout {
                    spacing: 3px;

                    for mode in ["System", "Light", "Dark"] : Rectangle {
                        height: 32px;
                        horizontal-stretch: 1;
                        border-radius: 6px;
                        background: root.theme-mode == mode ? selected-bg
                            : mode-touch.has-hover ? hover-bg : transparent;

                        mode-touch := TouchArea {
                            clicked => {
                                root.theme-mode = mode;
                            }
                        }

                        Text {
                            text: mode;
                            color: root.theme-mode == mode ? text-primary : text-secondary;
                            font-size: 11px;
                            font-weight: root.theme-mode == mode ? 700 : 500;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                Text {
                    text: "v0.1.0 · Early Development";
                    color: text-secondary;
                    font-size: 10px;
                    horizontal-alignment: center;
                }
            }
        }

        // MIDDLE PANE — Request list
        Rectangle {
            width: 250px;
            background: panel-bg;
            border-width: 1px;
            border-color: border-color;

            VerticalLayout {
                padding: 14px;
                spacing: 12px;

                HorizontalLayout {
                    spacing: 6px;

                    ThemedButton {
                        accent-color: root.accent;
                        width: 30px;
                        height: 30px;
                        icon: @image-url("../assets/icons/menu.png");
                        dark-mode: root.dark-mode;
                        accent-button: false;
                        clicked => {
                            root.show-navigation-sidebar = !root.show-navigation-sidebar;
                        }
                    }

                    Text {
                        text: "Requests";
                        color: text-primary;
                        font-size: 17px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        background: transparent;
                    }

                    ThemedButton {
                        accent-color: root.accent;
                        width: 92px;
                        height: 30px;
                        text: "Env vars";
                        dark-mode: root.dark-mode;
                        accent-button: root.active-view == "Variables";
                        clicked => {
                            root.active-view = "Variables";
                            root.variables-message = "";
                        }
                    }
                }

                request-search-field := LineEdit {
                    text: root.request-search;
                    placeholder-text: "Search requests...";
                    edited(value) => {
                        root.request-search = value;
                        root.search-requests(value);
                    }
                }

                HorizontalLayout {
                    spacing: 6px;

                    Text {
                        horizontal-stretch: 1;
                        text: "Saved requests";
                        color: text-secondary;
                        font-size: 11px;
                        font-weight: 600;
                    }

                    Text {
                        text: "(" + root.saved-requests.length + ")";
                        color: text-secondary;
                        font-size: 11px;
                    }
                }

                Text {
                    text: root.saved-requests.length == 0
                        ? (root.request-search == "" ? "Send or save a request to add it here" : "No requests match your search")
                        : "Select a request to edit · × to delete";
                    color: text-secondary;
                    font-size: 9px;
                    overflow: elide;
                }

                if root.saved-requests.length == 0 : Text {
                    text: "No saved requests yet";
                    color: text-secondary;
                    font-size: 12px;
                    horizontal-alignment: center;
                }

                for request in root.saved-requests: Rectangle {
                    width: 218px;
                    height: 56px;
                    background: transparent;

                    HorizontalLayout {
                        width: parent.width;
                        height: parent.height;
                        spacing: 4px;

                        Rectangle {
                            horizontal-stretch: 1;
                            border-radius: 8px;
                            background: root.active-request-id == request.id
                                ? selected-bg
                                : request-touch.has-hover ? hover-bg : transparent;

                            if root.active-request-id == request.id : Rectangle {
                                x: 0px;
                                y: 14px;
                                width: 3px;
                                height: 28px;
                                border-radius: 2px;
                                background: accent;
                            }

                            request-touch := TouchArea {
                                clicked => {
                                    root.select-request(request.id);
                                }
                            }

                            VerticalLayout {
                                padding: 8px;
                                spacing: 3px;

                                Text {
                                    width: 168px;
                                    text: request.method + "  " + request.name;
                                    color: text-primary;
                                    font-size: 12px;
                                    font-weight: 600;
                                    overflow: elide;
                                }

                                Text {
                                    width: 168px;
                                    text: request.url;
                                    color: text-secondary;
                                    font-size: 10px;
                                    overflow: elide;
                                }
                            }
                        }

                        ThemedButton {
                            accent-color: root.accent;
                            icon: @image-url("../assets/icons/close.png");
                            width: 30px;
                            height: 30px;
                            dark-mode: root.dark-mode;
                            accent-button: false;
                            destructive-button: true;

                            clicked => {
                                root.delete-request(request.id, root.selected-collection-id);
                            }
                        }
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                    background: transparent;
                }
            }
        }

        // RIGHT PANE — Request editor and response
        Rectangle {
            horizontal-stretch: 1;
            background: window-bg;

            if root.active-view == "Collections" : VerticalLayout {
                padding: 24px;
                spacing: 14px;
                HorizontalLayout {
                    height: 54px;
                    VerticalLayout {
                        spacing: 3px;
                        Text { text: "Collections"; color: text-primary; font-size: 22px; font-weight: 700; }
                        Text { text: "Browse your workspaces and open a collection's requests."; color: text-secondary; font-size: 11px; }
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    ThemedButton {
                        accent-color: root.accent;
                        text: "+ New collection";
                        dark-mode: root.dark-mode;
                        accent-button: true;
                        clicked => { root.show-new-collection = true; }
                    }
                }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 10px;
                        if root.collections.length == 0 : Rectangle {
                            height: 180px;
                            background: panel-bg;
                            border-width: 1px;
                            border-color: border-color;
                            border-radius: 12px;
                            VerticalLayout {
                                alignment: center;
                                spacing: 8px;
                                Text { text: "No collections yet"; color: text-primary; font-size: 15px; font-weight: 600; horizontal-alignment: center; }
                                Text { text: "Create a collection to organize requests and variables."; color: text-secondary; font-size: 11px; horizontal-alignment: center; }
                            }
                        }
                        for collection in root.collections : Rectangle {
                            height: 86px;
                            background: collection.id == root.selected-collection-id ? (root.dark-mode ? #303944 : #e8f1fb) : panel-bg;
                            border-width: 1px;
                            border-color: collection.id == root.selected-collection-id ? accent : border-color;
                            border-radius: 11px;
                            HorizontalLayout {
                                padding: 14px;
                                spacing: 12px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    spacing: 4px;
                                    Text { text: collection.name; color: text-primary; font-size: 15px; font-weight: 650; }
                                    Text { text: collection.id == root.selected-collection-id ? "Currently selected" : "Collection"; color: text-secondary; font-size: 11px; }
                                }
                                ThemedButton {
                                    accent-color: root.accent;
                                    text: "Open requests →";
                                    dark-mode: root.dark-mode;
                                    accent-button: collection.id == root.selected-collection-id;
                                    clicked => {
                                        root.selected-collection-id = collection.id;
                                        root.selected-collection-name = collection.name;
                                        root.active-view = "Request";
                                        root.load-requests(collection.id);
                                        root.load-collection-variables(collection.id);
                                    }
                                }
                            }
                        }
                    }
                }
            }

            if root.active-view == "Environments" : VerticalLayout {
                padding: 24px;
                spacing: 14px;
                HorizontalLayout {
                    height: 54px;
                    VerticalLayout {
                        spacing: 3px;
                        Text { text: "Environments"; color: text-primary; font-size: 22px; font-weight: 700; }
                        Text { text: "Collection variables grouped by collection."; color: text-secondary; font-size: 11px; }
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    ThemedButton {
                        accent-color: root.accent;
                        text: root.show-variable-values ? "Hide values" : "Show values";
                        dark-mode: root.dark-mode;
                        accent-button: false;
                        clicked => { root.show-variable-values = !root.show-variable-values; }
                    }
                }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 8px;
                        if root.environment-items.length == 0 : Rectangle {
                            height: 180px;
                            background: panel-bg;
                            border-width: 1px;
                            border-color: border-color;
                            border-radius: 12px;
                            VerticalLayout {
                                alignment: center;
                                spacing: 8px;
                                Text { text: "No collection variables yet"; color: text-primary; font-size: 15px; font-weight: 600; horizontal-alignment: center; }
                                Text { text: "Add variables from a collection's variable editor to see them here."; color: text-secondary; font-size: 11px; horizontal-alignment: center; }
                            }
                        }
                        for item in root.environment-items : Rectangle {
                            height: 64px;
                            background: panel-bg;
                            border-width: 1px;
                            border-color: border-color;
                            border-radius: 9px;
                            HorizontalLayout {
                                padding: 10px;
                                spacing: 12px;
                                VerticalLayout {
                                    width: 170px;
                                    alignment: center;
                                    spacing: 3px;
                                    Text { text: item.key; color: text-primary; font-size: 12px; font-weight: 600; overflow: elide; }
                                    Text { text: item.collection-name; color: text-secondary; font-size: 10px; overflow: elide; }
                                }
                                Text {
                                    horizontal-stretch: 1;
                                    text: root.show-variable-values ? item.value : "••••••••";
                                    color: text-secondary;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                ThemedButton {
                                    accent-color: root.accent;
                                    text: "Manage";
                                    dark-mode: root.dark-mode;
                                    accent-button: false;
                                    clicked => {
                                        root.selected-collection-id = item.collection-id;
                                        root.selected-collection-name = item.collection-name;
                                        root.load-collection-variables(item.collection-id);
                                        root.active-view = "Variables";
                                    }
                                }
                            }
                        }
                    }
                }
                Text { text: "Stored locally in SQLite. Values are not encrypted."; color: text-secondary; font-size: 10px; }
            }

            if root.active-view == "History" : VerticalLayout {
                padding: 24px;
                spacing: 14px;
                HorizontalLayout {
                    height: 50px;
                    Text {
                        text: "Request history";
                        color: text-primary;
                        font-size: 22px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    ChoiceDropdown {
                        accent-color: root.accent;
                        width: 150px;
                        options: ["Newest first", "Oldest first"];
                        current-value: root.history-sort;
                        dark-mode: root.dark-mode;
                        selected(value) => {
                            root.history-sort = value;
                            root.load-history(value);
                        }
                    }
                    Text {
                        text: "Last 500 sent requests";
                        color: text-secondary;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                }
                if root.history-items.length == 0 : Rectangle {
                    vertical-stretch: 1;
                    background: panel-bg;
                    border-width: 1px;
                    border-color: border-color;
                    border-radius: 12px;
                    Text {
                        text: "Requests you send will appear here";
                        color: text-secondary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                if root.history-items.length > 0 : ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 10px;
                        for item in root.history-items : Rectangle {
                            height: 66px;
                            background: panel-bg;
                            border-width: 1px;
                            border-color: border-color;
                            border-radius: 9px;
                            history-touch := TouchArea {
                                clicked => {
                                    root.selected-collection-name = item.collection-name;
                                    root.select-request(item.request-id);
                                }
                            }
                            HorizontalLayout {
                                padding: 10px;
                                spacing: 12px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 3px;
                                    Text { text: item.method + "  " + item.request-name; color: text-primary; font-size: 12px; font-weight: 600; overflow: elide; }
                                    Text { text: item.collection-name + " · " + item.url; color: text-secondary; font-size: 10px; overflow: elide; }
                                }
                                Text { text: item.status + " · " + item.duration; color: item.status.starts-with("2") ? #2ec27e : text-secondary; font-size: 11px; vertical-alignment: center; }
                                Text { text: item.date; color: text-secondary; font-size: 10px; vertical-alignment: center; }
                            }
                        }
                    }
                }
            }

            if root.active-view == "Request" : VerticalLayout {
                padding: 20px;
                spacing: 14px;

                HorizontalLayout {
                    spacing: 12px;
                    height: 52px;

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 3px;

                        if root.editing-request-name : HorizontalLayout {
                            spacing: 6px;
                            LineEdit {
                                horizontal-stretch: 1;
                                height: 36px;
                                text: root.request-name-draft;
                                placeholder-text: "Request name";
                                font-size: 20px;
                                edited(value) => { root.request-name-draft = value; }
                            }
                            ThemedButton {
                                accent-color: root.accent;
                                text: "Save name";
                                icon: @image-url("../assets/icons/save(right).png");
                                dark-mode: root.dark-mode;
                                accent-button: true;
                                enabled: root.request-name-draft != "";
                                clicked => {
                                    root.active-request = root.request-name-draft;
                                    root.editing-request-name = false;
                                    if root.active-request-id > 0 && root.request-url != "" {
                                        root.save-request(
                                            root.active-request-id,
                                            root.selected-collection-id,
                                            root.active-request,
                                            root.active-method,
                                            root.request-url,
                                            root.request-headers,
                                            root.request-params,
                                            root.request-body,
                                            root.body-format,
                                            root.auth-type,
                                            root.auth-value,
                                            root.auth-secret
                                        );
                                    }
                                }
                            }
                            ThemedButton {
                                accent-color: root.accent;
                                text: "Cancel";
                                icon: @image-url("../assets/icons/close.png");
                                dark-mode: root.dark-mode;
                                accent-button: false;
                                clicked => { root.editing-request-name = false; }
                            }
                        }
                        if !root.editing-request-name : HorizontalLayout {
                            spacing: 8px;
                            Text {
                                horizontal-stretch: 1;
                                text: root.active-request;
                                color: text-primary;
                                font-size: 22px;
                                font-weight: 700;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            ThemedButton {
                                accent-color: root.accent;
                                text: "Edit name";
                                icon: @image-url("../assets/icons/edit.png");
                                dark-mode: root.dark-mode;
                                accent-button: false;
                                clicked => {
                                    root.request-name-draft = root.active-request;
                                    root.editing-request-name = true;
                                }
                            }
                        }

                        Text {
                            text: root.active-request-id < 0
                                ? "Draft · " + root.selected-collection-name + " · Send saves automatically"
                                : "Saved · " + root.selected-collection-name + " · Send updates automatically";
                            color: text-secondary;
                            font-size: 11px;
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        background: transparent;
                    }

                    ThemedButton {
                        accent-color: root.accent;
                        text: "Save request";
                        icon: @image-url("../assets/icons/save(right).png");
                        dark-mode: root.dark-mode;
                        accent-button: false;
                        enabled: root.selected-collection-id > 0 && root.request-url != "" && root.active-request != "";

                        clicked => root.save-current-request();
                    }
                }

                // URL and method controls
                Rectangle {
                    background: panel-bg;
                    border-width: 1px;
                    border-color: border-color;
                    border-radius: 12px;

                    HorizontalLayout {
                        padding: 9px;
                        spacing: 9px;

                        ChoiceDropdown {
                            width: 88px;
                            options: ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"];
                            current-value: root.active-method;
                            dark-mode: root.dark-mode;
                            accent-button: true;
                            accent-color: root.active-method == "GET" ? #2ec27e :
                                root.active-method == "POST" ? #c64600 :
                                root.active-method == "PUT" ? #3584e4 : #c01c28;
                            selected(value) => { root.active-method = value; }
                        }

                        LineEdit {
                            horizontal-stretch: 1;
                            text: root.request-url;
                            placeholder-text: "Enter request URL...";
                            edited(value) => {
                                root.request-url = value;
                            }
                        }

                        ThemedButton {
                            accent-color: root.accent;
                            width: 144px;
                            text: root.is-loading ? "Sending..." : "Send";
                            icon: @image-url("../assets/icons/send.png");
                            dark-mode: root.dark-mode;
                            accent-button: true;
                            enabled: !root.is-loading && root.selected-collection-id > 0 && root.request-url != "" && root.active-request != "";

                            clicked => root.send-current-request();
                        }
                    }
                }

                // Request configuration tabs
                HorizontalLayout {
                    spacing: 5px;

                    for tab in ["Params", "Headers", "Body", "Auth"] : Rectangle {
                        height: 36px;
                        border-radius: 8px;
                        background: root.active-tab == tab ? selected-bg
                            : tab-touch.has-hover ? hover-bg : transparent;

                        tab-touch := TouchArea {
                            clicked => {
                                root.active-tab = tab;
                            }
                        }

                        Text {
                            text: tab;
                            color: root.active-tab == tab ? text-primary : text-secondary;
                            font-size: 12px;
                            font-weight: root.active-tab == tab ? 700 : 500;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: border-color;
                }

                HorizontalLayout {
                    height: 34px;
                    Text {
                        text: root.active-tab == "Body" ? "Request body" :
                              root.active-tab == "Headers" ? "Request headers" :
                              root.active-tab == "Params" ? "Query parameters" : "Authentication";
                        color: text-primary;
                        font-size: 14px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    if root.active-tab == "Body" : ChoiceDropdown {
                        accent-color: root.accent;
                        width: 104px;
                        height: 30px;
                        options: ["JSON", "Text", "HTML", "XML"];
                        current-value: root.body-format;
                        dark-mode: root.dark-mode;
                        selected(value) => { root.body-format = value; }
                    }
                    if root.active-tab == "Headers" : ChoiceDropdown {
                        accent-color: root.accent;
                        width: 172px;
                        height: 30px;
                        options: ["Add a preset…", "Accept", "Content-Type", "Cache-Control", "User-Agent", "X-Request-ID"];
                        current-value: root.header-preset;
                        dark-mode: root.dark-mode;
                        selected(value) => { root.add-header-preset(value); }
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                    min-height: 100px;
                    background: panel-bg;
                    border-width: 1px;
                    border-color: border-color;
                    border-radius: 12px;

                    if root.active-tab == "Body" : TextEdit {
                        text: root.request-body;
                        font-family: "monospace";
                        font-size: 12px;
                        wrap: word-wrap;
                        edited(value) => {
                            root.request-body = value;
                        }
                    }

                    if root.active-tab == "Headers" : KeyValueEditor {
                        accent-color: root.accent;
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: parent.height;
                        rows: root.request-header-rows;
                        key-placeholder: "Header name";
                        value-placeholder: "Header value";
                        add-label: "Add header";
                        dark-mode: root.dark-mode;
                        changed(rows) => {
                            root.request-header-rows = rows;
                            root.request-headers = root.serialize-header-rows(root.request-header-rows);
                        }
                    }

                    if root.active-tab == "Params" : KeyValueEditor {
                        accent-color: root.accent;
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: parent.height;
                        rows: root.request-param-rows;
                        key-placeholder: "Parameter name";
                        value-placeholder: "Parameter value";
                        add-label: "Add parameter";
                        dark-mode: root.dark-mode;
                        changed(rows) => {
                            root.request-param-rows = rows;
                            root.request-params = root.serialize-param-rows(root.request-param-rows);
                        }
                    }

                    if root.active-tab == "Auth" : VerticalLayout {
                        padding: 16px;
                        spacing: 10px;
                        Text {
                            text: "Authentication type";
                            color: text-secondary;
                            font-size: 11px;
                        }
                        ChoiceDropdown {
                            accent-color: root.accent;
                            width: 180px;
                            options: ["None", "Bearer", "Basic"];
                            current-value: root.auth-type;
                            dark-mode: root.dark-mode;
                            selected(value) => {
                                root.auth-type = value;
                                root.auth-value = "";
                                root.auth-secret = "";
                            }
                        }
                        if root.auth-type == "Bearer" : LineEdit {
                            width: 340px;
                            text: root.auth-value;
                            placeholder-text: "Bearer token";
                            input-type: password;
                            edited(value) => { root.auth-value = value; }
                        }
                        if root.auth-type == "Basic" : HorizontalLayout {
                            spacing: 8px;
                            LineEdit {
                                horizontal-stretch: 1;
                                text: root.auth-value;
                                placeholder-text: "Username";
                                edited(value) => { root.auth-value = value; }
                            }
                            LineEdit {
                                horizontal-stretch: 1;
                                text: root.auth-secret;
                                placeholder-text: "Password";
                                input-type: password;
                                edited(value) => { root.auth-secret = value; }
                            }
                        }
                        Rectangle { vertical-stretch: 1; background: transparent; }
                    }

                    if root.active-tab == "Body" && root.request-body == "" : Text {
                        x: 16px;
                        y: 14px;
                        text: "Write " + root.body-format + " request data here…";
                        color: text-secondary;
                        font-size: 12px;
                    }

                }

                Rectangle {
                    height: 1px;
                    background: border-color;
                }

                HorizontalLayout {
                    height: 34px;
                    spacing: 10px;

                    Text {
                        text: "Response";
                        color: text-primary;
                        font-size: 16px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        height: 24px;
                        width: 124px;
                        border-radius: 7px;
                        background: root.response-state == "success" ? (root.dark-mode ? #183c2d : #d8f3e4)
                            : root.response-state == "http-error" || root.response-state == "error" ? (root.dark-mode ? #48292a : #fce3e1)
                            : root.response-state == "loading" ? (root.dark-mode ? #25384c : #e2efff)
                            : transparent;
                        Text {
                            text: root.response-status;
                            overflow: elide;
                            color: root.response-state == "success" ? (root.dark-mode ? #8ff0b4 : #176b3a)
                                : root.response-state == "http-error" || root.response-state == "error" ? (root.dark-mode ? #ffaaa0 : #a51d2d)
                                : root.response-state == "loading" ? accent : text-secondary;
                            font-size: 11px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle { horizontal-stretch: 1; background: transparent; }

                    Text {
                        text: root.response-time == "---" ? "" : "◷  " + root.response-time;
                        color: text-secondary;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    height: 238px;
                    background: panel-bg;
                    border-width: 1px;
                    border-color: border-color;
                    border-radius: 12px;
                    clip: true;

                    VerticalLayout {
                        spacing: 0px;

                        HorizontalLayout {
                            height: 38px;
                            padding-left: 12px;
                            padding-right: 12px;
                            Text {
                                text: root.response-tab == "Body" ? "Response body · " + root.response-format : "Response " + root.response-tab;
                                color: text-secondary;
                                font-size: 11px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            for tab in ["Body", "Headers", "Cookies"] : Rectangle {
                                width: tab == "Headers" ? 84px : tab == "Cookies" ? 82px : 54px;
                                height: 28px;
                                border-radius: 7px;
                                background: root.response-tab == tab ? selected-bg : transparent;
                                response-tab-touch := TouchArea {
                                    clicked => { root.response-tab = tab; }
                                }
                                Text {
                                    text: tab == "Headers" ? "Headers  " + root.response-header-items.length
                                        : tab == "Cookies" ? "Cookies  " + root.response-cookie-items.length
                                        : tab;
                                    color: root.response-tab == tab ? text-primary : text-secondary;
                                    font-size: 10px;
                                    font-weight: root.response-tab == tab ? 600 : 400;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        Rectangle { height: 1px; background: border-color; }

                        Rectangle {
                            vertical-stretch: 1;
                            background: editor-bg;

                            if root.response-state == "idle" || root.response-state == "loading" : VerticalLayout {
                                alignment: center;
                                spacing: 7px;
                                Text {
                                    text: root.response-state == "loading" ? "•••" : "↗";
                                    color: accent;
                                    font-size: 22px;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: root.response-state == "loading" ? "Waiting for response" : "Your response will appear here";
                                    color: text-primary;
                                    font-size: 13px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: root.response-state == "loading" ? "The request is in progress." : "Send a request to inspect status, timing, and body.";
                                    color: text-secondary;
                                    font-size: 11px;
                                    horizontal-alignment: center;
                                }
                            }

                            if root.response-state != "idle" && root.response-state != "loading" && root.response-tab == "Body" : ScrollView {
                                mouse-drag-pan-enabled: true;
                                vertical-scrollbar-policy: always-on;
                                content-width: self.width;
                                content-height: response-body-text.height + 24px;

                                response-body-text := Text {
                                    x: 12px;
                                    y: 12px;
                                    width: parent.width - 24px;
                                    text: root.response-body == "" ? "The server returned an empty response body." : root.response-body;
                                    color: text-primary;
                                    font-family: "monospace";
                                    font-size: 12px;
                                    line-height-factor: 1.45;
                                    wrap: word-wrap;
                                }
                            }

                            if root.response-state != "idle" && root.response-state != "loading" && root.response-tab == "Headers" && root.response-header-items.length == 0 : VerticalLayout {
                                alignment: center;
                                spacing: 6px;
                                Text {
                                    text: "No response headers";
                                    color: text-primary;
                                    font-size: 13px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: "The server did not return any headers.";
                                    color: text-secondary;
                                    font-size: 11px;
                                    horizontal-alignment: center;
                                }
                            }

                            if root.response-state != "idle" && root.response-state != "loading" && root.response-tab == "Headers" && root.response-header-items.length > 0 : ScrollView {
                                mouse-drag-pan-enabled: true;
                                vertical-scrollbar-policy: always-on;
                                content-width: self.width;
                                content-height: root.response-header-items.length * 46px + 20px;

                                response-headers-list := VerticalLayout {
                                    x: 12px;
                                    y: 10px;
                                    width: parent.width - 24px;
                                    height: root.response-header-items.length * 46px;
                                    spacing: 2px;

                                    for item in root.response-header-items : Rectangle {
                                        width: parent.width;
                                        height: 44px;
                                        border-radius: 6px;
                                        background: transparent;

                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            spacing: 12px;

                                            Rectangle {
                                                width: 180px;
                                                height: 24px;
                                                border-radius: 5px;
                                                background: selected-bg;
                                                Text {
                                                    x: 8px;
                                                    width: parent.width - 16px;
                                                    height: parent.height;
                                                    text: item.name;
                                                    color: text-primary;
                                                    font-size: 10px;
                                                    font-weight: 600;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                }
                                            }

                                            response-header-value := Text {
                                                horizontal-stretch: 1;
                                                height: parent.height - 12px;
                                                text: item.value;
                                                color: text-primary;
                                                font-family: "monospace";
                                                font-size: 11px;
                                                vertical-alignment: center;
                                                wrap: word-wrap;
                                            }
                                        }
                                    }
                                }
                            }

                            if root.response-state != "idle" && root.response-state != "loading" && root.response-tab == "Cookies" && root.response-cookie-items.length == 0 : VerticalLayout {
                                alignment: center;
                                spacing: 6px;
                                Text {
                                    text: "No cookies returned";
                                    color: text-primary;
                                    font-size: 13px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: "This response did not include any Set-Cookie values.";
                                    color: text-secondary;
                                    font-size: 11px;
                                    horizontal-alignment: center;
                                }
                            }

                            if root.response-state != "idle" && root.response-state != "loading" && root.response-tab == "Cookies" && root.response-cookie-items.length > 0 : ScrollView {
                                mouse-drag-pan-enabled: true;
                                vertical-scrollbar-policy: always-on;
                                content-width: self.width;
                                content-height: root.response-cookie-items.length * 116px + 20px;

                                response-cookies-list := VerticalLayout {
                                    width: parent.width;
                                    height: root.response-cookie-items.length * 116px;
                                    padding: 10px;
                                    spacing: 8px;

                                    for item in root.response-cookie-items : Rectangle {
                                        width: parent.width - 20px;
                                        height: 100px;
                                        border-radius: 8px;
                                        border-width: 1px;
                                        border-color: border-color;
                                        background: panel-bg;

                                        VerticalLayout {
                                            padding: 10px;
                                            spacing: 5px;

                                            HorizontalLayout {
                                                spacing: 8px;
                                                Rectangle {
                                                    width: 48px;
                                                    height: 20px;
                                                    border-radius: 5px;
                                                    background: selected-bg;
                                                    Text {
                                                        text: "COOKIE";
                                                        color: text-secondary;
                                                        font-size: 8px;
                                                        font-weight: 700;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                                Text {
                                                    text: item.name;
                                                    color: text-primary;
                                                    font-size: 12px;
                                                    font-weight: 600;
                                                    vertical-alignment: center;
                                                }
                                            }

                                            HorizontalLayout {
                                                spacing: 8px;
                                                Text {
                                                    width: 50px;
                                                    text: "Value";
                                                    color: text-secondary;
                                                    font-size: 10px;
                                                    vertical-alignment: center;
                                                }
                                                Text {
                                                    horizontal-stretch: 1;
                                                    text: item.value == "" ? "(empty)" : item.value;
                                                    color: text-primary;
                                                    font-family: "monospace";
                                                    font-size: 11px;
                                                    vertical-alignment: center;
                                                    wrap: word-wrap;
                                                }
                                            }

                                            if item.attributes != "" : HorizontalLayout {
                                                spacing: 8px;
                                                Text {
                                                    width: 50px;
                                                    text: "Flags";
                                                    color: text-secondary;
                                                    font-size: 10px;
                                                    vertical-alignment: center;
                                                }
                                                Text {
                                                    horizontal-stretch: 1;
                                                    text: item.attributes;
                                                    color: text-secondary;
                                                    font-size: 10px;
                                                    vertical-alignment: center;
                                                    wrap: word-wrap;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            if root.active-view == "Variables" : VerticalLayout {
                padding: 24px;
                spacing: 16px;

                HorizontalLayout {
                    height: 54px;
                    spacing: 12px;

                    VerticalLayout {
                        spacing: 3px;
                        Text {
                            text: "Collection variables";
                            color: text-primary;
                            font-size: 22px;
                            font-weight: 700;
                        }
                        Text {
                            text: "Values available to requests in " + root.selected-collection-name;
                            color: text-secondary;
                            font-size: 11px;
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        background: transparent;
                    }

                    ThemedButton {
                        accent-color: root.accent;
                        text: "← Requests";
                        dark-mode: root.dark-mode;
                        accent-button: false;
                        clicked => { root.active-view = "Request"; }
                    }
                }

                Rectangle {
                    background: panel-bg;
                    border-width: 1px;
                    border-color: border-color;
                    border-radius: 12px;

                    VerticalLayout {
                        padding: 18px;
                        spacing: 10px;

                        Text {
                            text: "Add or update a variable";
                            color: text-primary;
                            font-size: 14px;
                            font-weight: 600;
                        }
                        Text {
                            text: "Use {variable_name} in a request or {{variable_name}} for compatibility.";
                            color: text-secondary;
                            font-size: 11px;
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            height: 38px;

                            LineEdit {
                                width: 180px;
                                text: root.variable-key;
                                placeholder-text: "Variable name";
                                edited(value) => { root.variable-key = value; }
                            }
                            LineEdit {
                                horizontal-stretch: 1;
                                text: root.variable-value;
                                placeholder-text: "Value";
                                edited(value) => { root.variable-value = value; }
                            }
                            ThemedButton {
                                accent-color: root.accent;
                                width: 112px;
                                text: "Save variable";
                                icon: @image-url("../assets/icons/save(right).png");
                                dark-mode: root.dark-mode;
                                accent-button: true;
                                enabled: root.selected-collection-id > 0 && root.variable-key != "";
                                clicked => {
                                    root.save-collection-variable(
                                        root.selected-collection-id,
                                        root.variable-key,
                                        root.variable-value
                                    );
                                }
                            }
                        }
                        Text {
                            text: root.variables-message;
                            color: root.variables-message == "Variable saved." || root.variables-message == "Variable deleted."
                                ? accent
                                : root.variables-message == "" ? text-secondary
                                : root.dark-mode ? #ff7b63 : #c01c28;
                            font-size: 11px;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "Variables · " + root.collection-variables.length;
                        color: text-primary;
                        font-size: 16px;
                        font-weight: 700;
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    ThemedButton {
                        accent-color: root.accent;
                        width: 116px;
                        height: 30px;
                        text: root.show-variable-values ? "Hide values" : "Show values";
                        dark-mode: root.dark-mode;
                        accent-button: false;
                        clicked => { root.show-variable-values = !root.show-variable-values; }
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                    background: transparent;

                    ScrollView {
                        VerticalLayout {
                            spacing: 8px;

                            if root.collection-variables.length == 0 : Rectangle {
                                height: 190px;
                                background: panel-bg;
                                border-width: 1px;
                                border-color: border-color;
                                border-radius: 12px;
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 8px;
                                    Text {
                                        text: "◇";
                                        color: accent;
                                        font-size: 24px;
                                        horizontal-alignment: center;
                                    }
                                    Text {
                                        text: "No variables in this collection yet";
                                        color: text-primary;
                                        font-size: 14px;
                                        font-weight: 600;
                                        horizontal-alignment: center;
                                    }
                                    Text {
                                        text: "Add a key and value above to reuse it in requests.";
                                        color: text-secondary;
                                        font-size: 11px;
                                        horizontal-alignment: center;
                                    }
                                }
                            }

                            for variable in root.collection-variables : Rectangle {
                                height: 56px;
                                background: panel-bg;
                                border-width: 1px;
                                border-color: border-color;
                                border-radius: 9px;
                                HorizontalLayout {
                                    padding: 10px;
                                    spacing: 12px;
                                    VerticalLayout {
                                        width: 180px;
                                        spacing: 2px;
                                        Text {
                                            text: variable.key;
                                            color: text-primary;
                                            font-size: 12px;
                                            font-weight: 600;
                                        }
                                        Text {
                                            text: "Collection variable";
                                            color: text-secondary;
                                            font-size: 10px;
                                        }
                                    }
                                    Text {
                                        horizontal-stretch: 1;
                                        text: root.show-variable-values ? variable.value : "••••••••";
                                        color: text-secondary;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                    }
                                    ThemedButton {
                                        accent-color: root.accent;
                                        width: 52px;
                                        text: "Edit";
                                        icon: @image-url("../assets/icons/edit.png");
                                        dark-mode: root.dark-mode;
                                        accent-button: false;
                                        clicked => {
                                            root.variable-key = variable.key;
                                            root.variable-value = variable.value;
                                            root.variables-message = "Edit the value, then save.";
                                        }
                                    }
                                    ThemedButton {
                                        accent-color: root.accent;
                                        width: 36px;
                                        icon: @image-url("../assets/icons/close.png");
                                        dark-mode: root.dark-mode;
                                        accent-button: false;
                                        destructive-button: true;
                                        clicked => {
                                            root.delete-collection-variable(root.selected-collection-id, variable.key);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                Text {
                    text: "Stored locally in SQLite. Values are not encrypted.";
                    color: text-secondary;
                    font-size: 10px;
                }
            }
        }
    }

        KeyBinding {
            keys: @keys(Control + S);
            enabled: root.active-view == "Request";
            activated => root.save-current-request();
        }
        KeyBinding {
            keys: @keys(Control + Return);
            enabled: root.active-view == "Request";
            activated => root.send-current-request();
        }
        KeyBinding {
            keys: @keys(Control + F);
            enabled: root.active-view == "Request";
            activated => request-search-field.focus();
        }
        KeyBinding {
            keys: @keys(Control + N);
            enabled: root.selected-collection-id > 0;
            activated => root.start-new-request(root.selected-collection-id, root.selected-collection-name);
        }
        KeyBinding {
            keys: @keys(Control + Shift + N);
            activated => {
                root.show-new-collection = true;
                root.new-collection-name = "";
                root.variables-message = "";
            }
        }
        KeyBinding {
            keys: @keys(Escape);
            activated => {
                if root.collection-menu-id > 0 {
                    root.collection-menu-id = -1;
                } else if root.confirm-delete-collection-id > 0 {
                    root.confirm-delete-collection-id = -1;
                } else if root.editing-request-name {
                    root.request-name-draft = root.active-request;
                    root.editing-request-name = false;
                } else if root.show-new-collection {
                    root.show-new-collection = false;
                    root.new-collection-name = "";
                }
            }
        }
    }
}
