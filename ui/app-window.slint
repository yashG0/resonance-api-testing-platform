import { ChoiceDropdown } from "components/choice-dropdown.slint";
import { KeyValueEditor, KeyValueRow } from "components/key-value-editor.slint";
import { ScrollView, ListView, Palette } from "std-widgets.slint";
import { AdwLineEdit, AdwTextEdit, AdwSelectableText, AutoPairAction } from "components/adw-inputs.slint";
import { Theme } from "components/theme.slint";
import { Icons } from "components/icons.slint";
import { Btn } from "components/btn.slint";
import { TabBar } from "components/tab-bar.slint";
import { MethodBadge } from "components/method-badge.slint";
import { StatusPill } from "components/status-pill.slint";
import { NavRow } from "components/nav-row.slint";
import { MenuItem } from "components/menu-item.slint";
import { ResponseBody, JsonLine, JsonTreeNode } from "components/response-body.slint";
import { ShortcutsDialog } from "components/shortcuts-dialog.slint";
import { AboutDialog } from "components/about-dialog.slint";
import { CurlImportDialog } from "components/curl-import-dialog.slint";
import { CollectionRunPanes, CollectionRunResult, ResponseHeaderItem } from "views/collection-run.slint";
import { HistoryItem, HistoryView } from "views/history.slint";
import { EnvironmentItem, EnvironmentView } from "views/environments.slint";
import { CollectionItem, CollectionsView } from "views/collections.slint";

export { Theme, CollectionRunResult, ResponseHeaderItem, HistoryItem, EnvironmentItem, CollectionItem }

export struct RequestItem {
    id: int,
    name: string,
    method: string,
    url: string,
}
export struct ResponseCookieItem {
    name: string,
    value: string,
    attributes: string,
}
export struct RequestTabItem {
    key: int,
    request-id: int,
    collection-id: int,
    collection-name: string,
    name: string,
    method: string,
    url: string,
    headers: [KeyValueRow],
    params: [KeyValueRow],
    body: string,
    body-format: string,
    auth-type: string,
    auth-value: string,
    auth-secret: string,
    timeout-ms: string,
    follow-redirects: bool,
    assertions-json: string,
    response-status: string,
    response-body: string,
    response-body-formatted: string,
    response-time: string,
    response-state: string,
    response-format: string,
    response-headers: string,
    response-cookies: string,
    response-large: bool,
    response-header-items: [ResponseHeaderItem],
    response-cookie-items: [ResponseCookieItem],
}
export struct RequestDraft {
    request-id: int,
    collection-id: int,
    tab-key: int,
    name: string,
    method: string,
    url: string,
    headers: string,
    params: string,
    body: string,
    body-format: string,
    auth-type: string,
    auth-value: string,
    auth-secret: string,
    assertions-json: string,
    timeout-ms: string,
    follow-redirects: bool,
}
export struct VariableItem {
    key: string,
    value: string,
    is-secret: bool,
}
export struct AssertionItem { index: int, title: string, summary: string, kind: string, first: string, second: string }
export struct CurlDraft {
    error: string, method: string, url: string, headers: string, body: string,
    body-format: string, auth-type: string, auth-value: string, auth-secret: string,
}

export component AppWindow inherits Window {
    title: "Cosmic API";
    in property <bool> custom-frame: false;
    no-frame: root.custom-frame;
    // GNOME-style client-side shadow: the surface is larger than the visible window by
    // `shadow-margin` on every side. The margin is transparent, holds the drop shadow and
    // doubles as the resize grip. It collapses when maximized / fullscreen (no shadow, square).
    resize-border-width: root.custom-frame && !root.chrome-flat ? 20px : 0px;
    preferred-width: root.custom-frame ? 1160px : 1120px;
    preferred-height: root.custom-frame ? 780px : 740px;
    min-width: root.custom-frame ? 780px : 740px;
    min-height: root.custom-frame ? 660px : 620px;
    default-font-family: Theme.font-ui;
    background: transparent;
    forward-focus: shortcut-scope;

    callback send-request(RequestDraft);
    callback save-request(RequestDraft);
    callback suggest-request-name(int) -> string;
    callback open-latest-request(int);
    callback serialize-param-rows([KeyValueRow]) -> string;
    callback serialize-header-rows([KeyValueRow]) -> string;
    callback append-assertion(string, string, string, string) -> string;
    callback remove-assertion(string, int) -> string;
    callback update-assertion(string, int, string, string, string) -> string;
    callback parse-assertions(string) -> [AssertionItem];
    callback parse-curl(string) -> CurlDraft;
    callback build-curl(string, string, string, string, string, string, string, string, string) -> string;
    callback parse-header-rows(string) -> [KeyValueRow];
    callback load-collections();
    callback load-requests(int);
    callback search-requests(string);
    callback load-history(string);
    callback filter-history(string) -> [HistoryItem];
    callback paginate-history(int, int) -> [HistoryItem];
    callback load-environments();
    callback run-collection(int, bool, string, string);
    callback load-collection-variables(int);
    callback create-collection(string);
    callback rename-collection(int, string);
    callback delete-collection(int);
    callback create-collection-variable(int, string, string, bool);
    callback update-collection-variable(int, string, string, string, bool);
    callback delete-collection-variable(int, string);
    callback select-request(int);
    callback delete-request(int, int);
    callback refresh-system-theme();
    callback auto-pair-request-body(string, int, int, string, string) -> AutoPairAction;
    callback tokenize-response(string, string, bool, float) -> [JsonLine];
    callback build-json-tree(string, string, bool) -> [JsonTreeNode];
    callback parse-response-headers(string) -> [ResponseHeaderItem];
    callback toggle-json-tree-node(string, string);
    // Implement in Rust (e.g. `arboard`). Unimplemented = Copy does nothing.
    callback copy-text(string);

    in-out property <[RequestItem]> saved-requests: [];
    in-out property <[RequestItem]> all-saved-requests: [];
    in-out property <[RequestTabItem]> request-tabs: [];
    in-out property <int> active-request-tab-key: -1;
    in-out property <int> active-request-tab-index: -1;
    in-out property <int> next-request-tab-key: 1;
    in-out property <string> active-request: "";
    // Updated from change handlers (not a binding) so the tab-bar layout can depend on it
    // without creating a layout <-> window-width binding loop.
    property <bool> request-tabs-overflow: false;
    function refresh-tab-overflow() {
        root.request-tabs-overflow =
            root.request-tabs.length * 224px > root.width - (root.show-navigation-sidebar ? 272px : 64px) - 128px;
    }
    changed width => {
        root.refresh-tab-overflow();
        if root.width < 960px { root.show-navigation-sidebar = false; }
    }
    changed request-tabs => { root.refresh-tab-overflow(); }
    changed request-assertions => { root.assertion-items = root.parse-assertions(root.request-assertions); }
    changed show-navigation-sidebar => { root.refresh-tab-overflow(); }
    in-out property <[CollectionItem]> collections: [];
    in-out property <[VariableItem]> collection-variables: [];
    in-out property <[EnvironmentItem]> environment-items: [];
    in-out property <[HistoryItem]> history-items: [];
    in-out property <[HistoryItem]> history-visible-items: [];
    in-out property <[HistoryItem]> history-page-items: [];
    in-out property <bool> history-loading: false;
    in-out property <bool> history-loader-visible: false;
    in-out property <int> history-load-generation: 0;
    in-out property <float> history-spinner-phase: 0;
    in-out property <string> history-load-error: "";
    in-out property <int> history-page: 1;
    in-out property <int> history-page-size: 20;
    property <int> history-page-count: max(1, (root.history-visible-items.length + root.history-page-size - 1) / root.history-page-size);
    in-out property <[CollectionRunResult]> collection-run-results: [];
    in-out property <string> collection-run-name: "";
    in-out property <bool> collection-run-stop-on-failure: false;
    in-out property <string> collection-run-retries: "0";
    in-out property <string> collection-run-delay-ms: "0";
    in-out property <string> collection-run-state: "idle";
    in-out property <string> collection-run-duration: "";
    in-out property <string> collection-run-error: "";
    in-out property <int> collection-run-total: 0;
    in-out property <int> collection-run-completed: 0;
    in-out property <int> collection-run-passed: 0;
    in-out property <int> collection-run-failed: 0;
    in-out property <int> collection-run-skipped: 0;
    in-out property <int> collection-run-selected: -1;
    in-out property <string> collection-run-response-tab: "Body";
    in-out property <[ResponseHeaderItem]> collection-run-header-items: [];
    in-out property <int> active-request-id: -1;
    in-out property <int> selected-collection-id: -1;
    in-out property <int> expanded-collection-id: -1;
    in-out property <int> collection-menu-id: -1;
    in-out property <int> editing-collection-id: -1;
    in-out property <string> collection-name-draft: "";
    in-out property <string> selected-collection-name: "";
    in-out property <string> request-search: "";
    in-out property <string> active-view: "Request";
    in-out property <string> history-sort: "Newest first";
    in-out property <string> new-collection-name: "";
    in-out property <bool> show-new-collection: false;
    in-out property <int> confirm-delete-collection-id: -1;
    in-out property <string> variable-key: "";
    in-out property <string> variable-value: "";
    in-out property <bool> variable-is-secret: false;
    in-out property <string> variables-message: "";
    in-out property <string> editing-variable-key: "";
    in-out property <int> editing-variable-collection-id: -1;
    in-out property <string> editing-variable-draft-key: "";
    in-out property <string> editing-variable-draft-value: "";
    in-out property <bool> editing-variable-draft-secret: false;
    in-out property <string> editing-variable-message: "";
    in-out property <bool> show-variable-values: false;
    in-out property <string> theme-mode: "System";
    in-out property <bool> show-navigation-sidebar: true;
    in-out property <bool> editing-request-name: false;
    in-out property <string> request-name-draft: "";
    in-out property <string> active-method: "GET";
    in-out property <string> request-url: "";
    in-out property <string> active-tab: "Body";

    in-out property <string> request-params: "";
    in-out property <[KeyValueRow]> request-param-rows: [];
    in-out property <string> request-body: "";
    in-out property <string> body-format: "JSON";
    in-out property <string> request-timeout-ms: "30000";
    in-out property <bool> follow-redirects: true;

    in-out property <string> request-headers: "Accept: application/json";
    in-out property <[KeyValueRow]> request-header-rows: [{ key: "Accept", value: "application/json", enabled: true }];
    in-out property <string> header-preset: "Add a preset…";
    in-out property <string> auth-type: "None";
    in-out property <string> auth-value: "";
    in-out property <string> auth-secret: "";
    in-out property <string> request-assertions: "[]";
    in-out property <[AssertionItem]> assertion-items: [];
    in-out property <bool> assertion-advanced: false;
    in-out property <string> assertion-editor-message: "";
    in-out property <bool> show-curl-import: false;
    in-out property <string> curl-import-command: "";
    in-out property <string> curl-import-error: "";
    in-out property <string> assertion-kind: "HTTP status";
    in-out property <string> assertion-first-value: "";
    in-out property <string> assertion-second-value: "";
    in-out property <int> editing-assertion-index: -1;
    in-out property <string> response-status: "No response yet";
    in-out property <string> response-body: "Send a request to inspect its response.";
    in-out property <string> response-time: "---";
    in-out property <string> response-state: "idle";
    in-out property <string> response-format: "Text";
in-out property <bool> response-large: false;
    in-out property <string> response-headers: "";
    in-out property <string> response-cookies: "";
    in-out property <[ResponseHeaderItem]> response-header-items: [];
    in-out property <[ResponseCookieItem]> response-cookie-items: [];

    in-out property <string> response-tab: "Body";
    in-out property <bool> is-loading: false;
    // Kept so existing Rust setters still compile; the Pretty/Raw toggle now lives inside ResponseBody.
    in-out property <bool> show-response-body-formatted: false;
    in-out property <string> response-body-formatted: "";

    // New UI state
    in-out property <float> split-ratio: 0.5;
    in-out property <bool> show-shortcuts: false;
    in-out property <bool> show-about: false;
    in-out property <string> shortcut-modifier: "Ctrl";
    in-out property <string> shortcut-alt-modifier: "Alt";
    property <bool> app-shortcuts-enabled: !root.show-shortcuts && !root.show-about;
    in-out property <string> history-filter: "All";   // All | Success | Failed

    in-out property <bool> system-dark-mode: Palette.color-scheme == ColorScheme.dark;
    in-out property <string> previous-theme-mode: "System";
    in-out property <color> system-accent-color: #3584e4;
    in-out property <color> accent: root.system-accent-color;

    property <bool> chrome-flat: root.full-screen || root.maximized;
    property <length> shadow-margin: root.custom-frame && !root.chrome-flat ? 20px : 0px;

    property <bool> dark-mode:
        root.theme-mode == "Dark" ? true :
        root.theme-mode == "Light" ? false :
        root.system-dark-mode;

    init => {
        Theme.dark = root.dark-mode;
        Theme.accent = root.accent;
        root.refresh-tab-overflow();
    }
    changed active-view => {
        if root.active-view != "Variables" {
            root.cancel-variable-edit();
        }
    }
    changed dark-mode => { Theme.dark = root.dark-mode; }
    changed accent => { Theme.accent = root.accent; }
    changed theme-mode => {
        if (root.previous-theme-mode == "System" && root.theme-mode != "System") {
            root.system-dark-mode = Palette.color-scheme == ColorScheme.dark;
        }
        if (root.theme-mode == "System") {
            root.refresh-system-theme();
        }
        Palette.color-scheme =
            root.theme-mode == "Dark" ? ColorScheme.dark :
            root.theme-mode == "Light" ? ColorScheme.light :
            root.system-dark-mode ? ColorScheme.dark : ColorScheme.light;
        root.previous-theme-mode = root.theme-mode;
    }
    changed system-dark-mode => {
        if (root.theme-mode == "System") {
            Palette.color-scheme = root.system-dark-mode ? ColorScheme.dark : ColorScheme.light;
        }
    }

    function add-header-preset(name: string) {
        if name != "Add a preset…" {
            let value = name == "Accept" ? "application/json" :
                name == "Content-Type" ? "application/json" :
                name == "Cache-Control" ? "no-cache" :
                name == "User-Agent" ? "Cosmic API" : "";
            let updated = root.request-header-rows;
            updated.push({ key: name, value: value, enabled: true });
            root.request-header-rows = updated;
            root.request-headers = root.serialize-header-rows(root.request-header-rows);
            root.header-preset = "Add a preset…";
        }
    }

    function open-view(view: string) {
        root.active-view = view;
        root.collection-menu-id = -1;
        if view == "History" {
            root.history-load-generation += 1;
            root.history-loading = true;
            root.history-loader-visible = true;
            root.history-load-error = "";
            root.history-page = 1;
            root.load-history(root.history-sort);
        }
        if view == "Environments" { root.load-environments(); }
    }

    function refresh-history-page() {
        root.history-page = min(root.history-page, root.history-page-count);
        root.history-page-items = root.paginate-history(root.history-page, root.history-page-size);
    }

    function begin-new-collection() {
        root.show-navigation-sidebar = true;
        root.show-new-collection = true;
        root.new-collection-name = "";
        root.variables-message = "";
    }

    function begin-variable-edit(key: string, value: string, is-secret: bool) {
        root.editing-variable-key = key;
        root.editing-variable-collection-id = root.selected-collection-id;
        root.editing-variable-draft-key = key;
        root.editing-variable-draft-value = value;
        root.editing-variable-draft-secret = is-secret;
        root.editing-variable-message = "";
    }

    function cancel-variable-edit() {
        root.editing-variable-key = "";
        root.editing-variable-collection-id = -1;
        root.editing-variable-draft-key = "";
        root.editing-variable-draft-value = "";
        root.editing-variable-draft-secret = false;
        root.editing-variable-message = "";
    }

    public function focus-request-url() {
        url-field.focus();
    }

    function set-request-tab(tab: string) {
        root.active-view = "Request";
        root.active-tab = tab;
    }

    public function store-active-request-tab() {
        if root.active-request-tab-index < 0 { return; }
        let tab = root.request-tabs[root.active-request-tab-index];
        root.request-tabs[root.active-request-tab-index] = {
            key: tab.key,
            request-id: root.active-request-id,
            collection-id: root.selected-collection-id,
            collection-name: root.selected-collection-name,
            name: root.active-request,
            method: root.active-method,
            url: root.request-url,
            headers: root.request-header-rows,
            params: root.request-param-rows,
            body: root.request-body,
            body-format: root.body-format,
            auth-type: root.auth-type,
            auth-value: root.auth-value,
            auth-secret: root.auth-secret,
            timeout-ms: root.request-timeout-ms,
            follow-redirects: root.follow-redirects,
            assertions-json: root.request-assertions,
            response-status: root.response-status,
            response-body: root.response-body,
            response-body-formatted: root.response-body-formatted,
            response-time: root.response-time,
            response-state: root.response-state,
            response-format: root.response-format,
            response-headers: root.response-headers,
            response-cookies: root.response-cookies,
            response-large: root.response-large,
            response-header-items: root.response-header-items,
            response-cookie-items: root.response-cookie-items,
        };
    }

    public function activate-request-tab(index: int) {
        root.store-active-request-tab();
        let tab = root.request-tabs[index];
        root.active-request-tab-index = index;
        root.active-request-tab-key = tab.key;
        root.active-request-id = tab.request-id;
        root.selected-collection-id = tab.collection-id;
        root.expanded-collection-id = tab.collection-id;
        root.selected-collection-name = tab.collection-name;
        root.active-request = tab.name;
        root.request-name-draft = root.active-request;
        root.active-method = tab.method;
        root.request-url = tab.url;
        root.request-headers = root.serialize-header-rows(tab.headers);
        root.request-header-rows = tab.headers;
        root.request-params = root.serialize-param-rows(tab.params);
        root.request-param-rows = tab.params;
        root.request-body = tab.body;
        root.body-format = tab.body-format;
        root.auth-type = tab.auth-type;
        root.auth-value = tab.auth-value;
        root.auth-secret = tab.auth-secret;
        root.request-timeout-ms = tab.timeout-ms;
        root.follow-redirects = tab.follow-redirects;
        root.request-assertions = tab.assertions-json;
        root.editing-request-name = false;
        root.active-view = "Request";
        root.response-status = tab.response-status;
        root.response-body = tab.response-body;
        root.response-body-formatted = tab.response-body-formatted;
        root.response-time = tab.response-time;
        let tab-loading = tab.response-state == "loading";
        root.response-state = tab.response-state;
        root.response-format = tab.response-format;
        root.response-headers = tab.response-headers;
        root.response-cookies = tab.response-cookies;
        root.response-large = tab.response-large;
        root.response-header-items = tab.response-header-items;
        root.response-cookie-items = tab.response-cookie-items;
        root.is-loading = tab-loading;
        root.load-requests(tab.collection-id);
        root.load-collection-variables(tab.collection-id);
    }

    public function set-request-tab-response(index: int, key: int, status: string, body: string, formatted-body: string, elapsed: string, state: string, format: string, headers: string, cookies: string, large: bool, header-items: [ResponseHeaderItem], cookie-items: [ResponseCookieItem]) {
        if index >= 0 && index < root.request-tabs.length {
            let tab = root.request-tabs[index];
            if tab.key == key {
                root.request-tabs[index] = {
                    key: tab.key, request-id: tab.request-id, collection-id: tab.collection-id,
                    collection-name: tab.collection-name, name: tab.name, method: tab.method,
                    url: tab.url, headers: tab.headers, params: tab.params, body: tab.body,
                    body-format: tab.body-format, auth-type: tab.auth-type, auth-value: tab.auth-value,
                    auth-secret: tab.auth-secret, assertions-json: tab.assertions-json, response-status: status, response-body: body,
                    timeout-ms: tab.timeout-ms,
                    follow-redirects: tab.follow-redirects,
                    response-body-formatted: formatted-body,
                    response-time: elapsed, response-state: state, response-format: format,
                    response-headers: headers, response-cookies: cookies, response-large: large,
                    response-header-items: header-items, response-cookie-items: cookie-items,
                };
                if root.active-request-tab-key == key {
                    root.response-status = status; root.response-body = body;
                    root.response-body-formatted = formatted-body; root.response-time = elapsed;
                    root.response-state = state; root.response-format = format; root.response-headers = headers;
                    root.response-cookies = cookies; root.response-large = large;
                    root.response-header-items = header-items; root.response-cookie-items = cookie-items;
                    root.is-loading = state == "loading";
                }
                return;
            }
        }
    }

    public function set-request-tab-identity(index: int, key: int, request-id: int, name: string) {
        if index >= 0 && index < root.request-tabs.length {
            let tab = root.request-tabs[index];
            if tab.key == key {
                root.request-tabs[index] = {
                    key: tab.key, request-id: request-id, collection-id: tab.collection-id,
                    collection-name: tab.collection-name, name: name, method: tab.method,
                    url: tab.url, headers: tab.headers, params: tab.params, body: tab.body,
                    body-format: tab.body-format, auth-type: tab.auth-type, auth-value: tab.auth-value,
                    auth-secret: tab.auth-secret, assertions-json: tab.assertions-json, response-status: tab.response-status,
                    timeout-ms: tab.timeout-ms,
                    follow-redirects: tab.follow-redirects,
                    response-body: tab.response-body,
                    response-body-formatted: tab.response-body-formatted,
                    response-time: tab.response-time,
                    response-state: tab.response-state, response-format: tab.response-format,
                    response-headers: tab.response-headers, response-cookies: tab.response-cookies,
                    response-large: tab.response-large, response-header-items: tab.response-header-items,
                    response-cookie-items: tab.response-cookie-items,
                };
                if root.active-request-tab-key == key {
                    root.active-request-id = request-id;
                    root.active-request = name;
                    root.request-name-draft = name;
                }
                return;
            }
        }
    }

    public function register-active-request-tab() {
        let key = root.next-request-tab-key;
        root.next-request-tab-key += 1;
        let new-index = root.request-tabs.length;
        let updated = root.request-tabs;
        updated.push({
            key: key,
            request-id: root.active-request-id,
            collection-id: root.selected-collection-id,
            collection-name: root.selected-collection-name,
            name: root.active-request,
            method: root.active-method,
            url: root.request-url,
            headers: root.request-header-rows,
            params: root.request-param-rows,
            body: root.request-body,
            body-format: root.body-format,
            auth-type: root.auth-type,
            auth-value: root.auth-value,
            auth-secret: root.auth-secret,
            timeout-ms: root.request-timeout-ms,
            follow-redirects: root.follow-redirects,
            assertions-json: root.request-assertions,
            response-status: root.response-status,
            response-body: root.response-body,
            response-body-formatted: root.response-body-formatted,
            response-time: root.response-time,
            response-state: root.response-state,
            response-format: root.response-format,
            response-headers: root.response-headers,
            response-cookies: root.response-cookies,
            response-large: root.response-large,
            response-header-items: root.response-header-items,
            response-cookie-items: root.response-cookie-items,
        });
        root.active-request-tab-key = key;
        root.active-request-tab-index = new-index;
        root.request-tabs = updated;
    }

    function open-saved-request-tab(request-id: int) {
        root.store-active-request-tab();
        root.active-view = "Request";
        if root.active-request-id != request-id {
            root.select-request(request-id);
        }
    }

    public function close-request-tab(index: int) {
        root.store-active-request-tab();
        let updated = root.request-tabs;
        updated.remove(index);
        let remaining-count = updated.length;
        root.request-tabs = updated;
        if root.active-request-tab-index == index {
            if remaining-count > 0 {
                let next-index = min(index, remaining-count - 1);
                root.active-request-tab-index = -1;
                root.activate-request-tab(next-index);
            } else {
                root.active-request-tab-index = -1;
                root.active-request-tab-key = -1;
                root.active-request-id = -1;
                root.selected-collection-id = -1;
                root.selected-collection-name = "";
                root.active-request = "";
                root.request-url = "";
                root.request-header-rows = [];
                root.request-param-rows = [];
                root.request-body = "";
                root.is-loading = false;
                root.response-state = "idle";
                root.response-status = "No response yet";
                root.response-body = "Send a request to inspect its response.";
                root.response-body-formatted = "";
                root.response-time = "---";
            }
        } else if index < root.active-request-tab-index {
            root.active-request-tab-index -= 1;
        }
    }

    function cycle-request-tab(direction: int) {
        let count = root.request-tabs.length;
        if count < 2 || root.active-request-tab-index < 0 { return; }
        let next = direction > 0
            ? (root.active-request-tab-index + 1 >= count ? 0 : root.active-request-tab-index + 1)
            : (root.active-request-tab-index == 0 ? count - 1 : root.active-request-tab-index - 1);
        root.activate-request-tab(next);
    }

    function current-request-draft() -> RequestDraft {
        return {
            request-id: root.active-request-id,
            collection-id: root.selected-collection-id,
            tab-key: root.active-request-tab-key,
            name: root.active-request,
            method: root.active-method,
            url: root.request-url,
            headers: root.request-headers,
            params: root.request-params,
            body: root.request-body,
            body-format: root.body-format,
            auth-type: root.auth-type,
            auth-value: root.auth-value,
            auth-secret: root.auth-secret,
            assertions-json: root.request-assertions,
            timeout-ms: root.request-timeout-ms,
            follow-redirects: root.follow-redirects,
        };
    }

    function begin-rename() {
        if root.active-view == "Request" {
            root.request-name-draft = root.active-request;
            root.editing-request-name = true;
        }
    }

    function commit-request-name() {
        root.active-request = root.request-name-draft;
        root.editing-request-name = false;
        if root.active-request-id > 0 && root.request-url != "" {
            root.save-request(root.current-request-draft());
        }
    }

    function copy-response() {
        root.copy-text(root.response-body-formatted != "" ? root.response-body-formatted : root.response-body);
    }

    function start-new-request(collection-id: int, collection-name: string) {
        root.cancel-variable-edit();
        root.store-active-request-tab();
        root.selected-collection-id = collection-id;
        root.expanded-collection-id = collection-id;
        root.selected-collection-name = collection-name;
        root.active-view = "Request";
        root.active-request-id = -1;
        let next-title = root.suggest-request-name(collection-id);
        root.active-request = next-title;
        root.request-name-draft = root.active-request;
        root.editing-request-name = false;
        root.is-loading = false;
        root.response-status = "No response yet";
        root.response-state = "idle";
        root.response-format = "Text";
        root.response-body = "Send a request to inspect its response.";
        root.response-body-formatted = "";
        root.response-headers = "";
        root.response-cookies = "";
        root.response-header-items = [];
        root.response-cookie-items = [];
        root.response-time = "---";
        root.active-method = "GET";
        root.request-url = "";
        root.request-params = "";
        root.request-param-rows = [];
        root.request-body = "";
        root.body-format = "JSON";
        root.request-headers = "Accept: application/json";
        root.request-header-rows = [{ key: "Accept", value: "application/json", enabled: true }];
        root.auth-type = "None";
        root.auth-value = "";
        root.auth-secret = "";
        root.request-timeout-ms = "30000";
        root.follow-redirects = true;
        root.request-assertions = "[]";
        root.active-tab = "Body";
        let key = root.next-request-tab-key;
        root.next-request-tab-key += 1;
        root.active-request-tab-key = key;
        let new-index = root.request-tabs.length;
        let updated = root.request-tabs;
        updated.push({
            key: key,
            request-id: -1,
            collection-id: collection-id,
            collection-name: collection-name,
            name: root.active-request,
            method: "GET",
            url: "",
            headers: [{ key: "Accept", value: "application/json", enabled: true }],
            params: [],
            body: "",
            body-format: "JSON",
            auth-type: "None",
            auth-value: "",
            auth-secret: "",
            timeout-ms: "30000",
            follow-redirects: true,
            assertions-json: "[]",
            response-status: "No response yet",
            response-body: "Send a request to inspect its response.",
            response-body-formatted: "",
            response-time: "---",
            response-state: "idle",
            response-format: "Text",
            response-headers: "",
            response-cookies: "",
            response-large: false,
            response-header-items: [],
            response-cookie-items: [],
        });
        root.active-request-tab-index = new-index;
        root.request-tabs = updated;
        root.collection-menu-id = -1;
        root.confirm-delete-collection-id = -1;
        if collection-id > 0 {
            root.load-requests(collection-id);
            root.load-collection-variables(collection-id);
        }
        url-field.focus();
    }

    function open-collection-request(collection-id: int, collection-name: string) {
        root.cancel-variable-edit();
        root.store-active-request-tab();
        root.selected-collection-id = collection-id;
        root.expanded-collection-id = collection-id;
        root.selected-collection-name = collection-name;
        root.active-view = "Request";
        root.load-requests(collection-id);
        root.load-collection-variables(collection-id);
        root.open-latest-request(collection-id);
    }

    public function show-empty-collection() {
        root.active-request-tab-index = -1;
        root.active-request-tab-key = -1;
        root.active-request-id = -1;
        root.active-request = "";
        root.request-name-draft = "";
        root.is-loading = false;
        root.active-method = "GET";
        root.request-url = "";
        root.request-params = "";
        root.request-param-rows = [];
        root.request-body = "";
        root.body-format = "JSON";
        root.request-headers = "Accept: application/json";
        root.request-header-rows = [{ key: "Accept", value: "application/json", enabled: true }];
        root.auth-type = "None";
        root.auth-value = "";
        root.auth-secret = "";
        root.request-timeout-ms = "30000";
        root.follow-redirects = true;
        root.request-assertions = "[]";
        root.response-status = "No response yet";
        root.response-body = "Send a request to inspect its response.";
        root.response-body-formatted = "";
        root.response-time = "---";
        root.response-state = "idle";
        root.response-format = "Text";
        root.response-headers = "";
        root.response-cookies = "";
        root.response-header-items = [];
        root.response-cookie-items = [];
        root.active-tab = "Body";
    }

    function save-current-request() {
        if root.active-view == "Request" && root.selected-collection-id > 0 && root.request-url != "" && root.active-request != "" {
            root.save-request(root.current-request-draft());
        }
    }

    function send-current-request() {
        if root.active-view == "Request" && !root.is-loading && root.selected-collection-id > 0 && root.request-url != "" && root.active-request != "" {
            root.is-loading = true;
            root.response-status = "Sending...";
            root.response-state = "loading";
            root.response-format = "Text";
            root.response-body = "Waiting for response...";
            root.response-body-formatted = "";
            root.response-headers = "";
            root.response-cookies = "";
            root.response-header-items = [];
            root.response-cookie-items = [];
            root.response-time = "---";
            root.response-tab = "Body";
            root.store-active-request-tab();
            root.send-request(root.current-request-draft());
        }
    }

    shortcut-scope := FocusScope {
        width: 100%;
        height: 100%;

        Timer {
            interval: 16ms;
            running: root.history-loading;
            triggered => {
                root.history-spinner-phase += 4.2667;
                if root.history-spinner-phase >= 360 {
                    root.history-spinner-phase -= 360;
                }
            }
        }

        Rectangle {
            x: root.shadow-margin;
            y: root.shadow-margin;
            width: parent.width - 2 * root.shadow-margin;
            height: parent.height - 2 * root.shadow-margin;
            background: Theme.window-bg;
            border-radius: root.chrome-flat || !root.custom-frame ? 0px : Theme.radius-window;
            border-width: 1px;
            border-color: Theme.dark ? #ffffff24 : #00000026;
            drop-shadow-blur: root.chrome-flat || !root.custom-frame ? 0px : 20px;
            drop-shadow-offset-y: root.chrome-flat || !root.custom-frame ? 0px : 4px;
            drop-shadow-color: Theme.dark ? #000000a0 : #00000040;
            clip: true;

            VerticalLayout {
                spacing: 0;

            // Integrated client-side titlebar
                Rectangle {
                    height: 48px;
                    background: Theme.titlebar-bg;
                    // Sidebar-coloured section: header and sidebar read as one split view.
                    Rectangle {
                        x: 0px;
                        width: root.show-navigation-sidebar ? 272px : 64px;
                        height: parent.height;
                        background: Theme.sidebar-bg;
                        animate width { duration: 180ms; easing: ease-out; }
                    }
                    WindowMoveArea {
                        width: 100%;
                        height: 48px;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 12px;
                            spacing: 8px;

                            Rectangle {
                                width: (root.show-navigation-sidebar ? 272px : 64px) - 18px;
                                animate width { duration: 180ms; easing: ease-out; }
                                Btn {
                                    x: 0px;
                                    width: Theme.control-h;
                                    kind: "flat";
                                    y: 7px;
                                    icon: Icons.panel-left;
                                    accessible-name: "Toggle navigation sidebar";
                                    tooltip: "Toggle Sidebar";

                                    active: root.show-navigation-sidebar;
                                    clicked => { root.show-navigation-sidebar = !root.show-navigation-sidebar; }
                                }
                            }

                            if root.active-view == "Request" && !root.editing-request-name && (root.active-request-id > 0 || root.active-request-tab-index >= 0) : HorizontalLayout {
                                horizontal-stretch: 1;
                                spacing: 8px;
                                padding-left: 6px;
                                alignment: center;
                                Text {
                                    text: root.selected-collection-name != "" ? root.selected-collection-name : "No collection";
                                    color: Theme.fg-3;
                                    font-size: Theme.fs-label;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    max-width: 220px;
                                }
                                Image { source: Icons.chevron-right; width: 14px; height: 14px; y: (parent.height - self.height) / 2; colorize: Theme.fg-3; }
                                Text {
                                    text: root.active-request;
                                    color: Theme.fg;
                                    font-size: Theme.fs-body;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    max-width: 260px;
                                }
                                if root.active-request-id <= 0 && root.active-request-tab-index >= 0 : Rectangle {
                                    width: 62px;
                                    height: 22px;
                                    background: Theme.active;
                                    border-radius: 11px;
                                    Text {
                                        text: "Unsaved";
                                        color: Theme.fg-2;
                                        font-size: Theme.fs-small;
                                        font-weight: 600;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                                Btn { kind: "flat"; y: 7px; icon: Icons.pencil; icon-size: 15px; accessible-name: "Rename request"; tooltip: "Rename Request"; clicked => { root.begin-rename(); } }
                            }

                            if root.active-view == "Request" && root.active-request-id <= 0 && root.active-request-tab-index < 0 : Text {
                                horizontal-stretch: 1;
                                text: root.selected-collection-id > 0 ? "Choose a request" : "Get started";
                                color: Theme.fg;
                                font-size: Theme.fs-body;
                                font-weight: 700;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                            }

                            if root.active-view == "Request" && root.editing-request-name : HorizontalLayout {
                                horizontal-stretch: 1;
                                spacing: 6px;
                                padding-left: 6px;
                                AdwLineEdit {
                                    horizontal-stretch: 1;
                                    height: 34px;
                                    y: 7px;
                                    text: root.request-name-draft;
                                    placeholder-text: "Request name";
                                    edited(value) => { root.request-name-draft = value; }
                                    accepted(value) => { if value != "" { root.request-name-draft = value; root.commit-request-name(); } }
                                }
                                Btn { kind: "suggested"; y: 7px; icon: Icons.check; accessible-name: "Save request name"; enabled: root.request-name-draft != ""; clicked => { root.commit-request-name(); } }
                                Btn { kind: "flat"; y: 7px; icon: Icons.x; accessible-name: "Cancel rename"; clicked => { root.editing-request-name = false; } }
                            }

                            if root.active-view != "Request" : Text {
                                horizontal-stretch: 1;
                                text: root.active-view == "Collections" ? "Collections"
                                    : root.active-view == "History" ? "History"
                                    : root.active-view == "Environments" ? "Environments"
                                    : root.active-view == "Regression" ? "Regression testing" : "Collection variables";
                                color: Theme.fg;
                                font-size: Theme.fs-body;
                                font-weight: 700;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                            }

                            if root.custom-frame : Btn { kind: "flat"; y: 7px; icon: Icons.maximize; accessible-name: "Toggle full screen"; tooltip: "Toggle Full Screen"; clicked => { root.full-screen = !root.full-screen; } }
                            if root.active-view == "Request" && (root.active-request-id > 0 || root.active-request-tab-index >= 0) : Btn {
                                y: 7px;
                                text: "Save";
                                icon: Icons.check;
                                enabled: root.selected-collection-id > 0 && root.request-url != "" && root.active-request != "";
                                tooltip: "Save Request";

                                clicked => { root.save-current-request(); }
                            }

                            Btn {
                                kind: "flat";
                                y: 7px;
                                icon: root.theme-mode == "Dark" ? Icons.moon : root.theme-mode == "Light" ? Icons.sun : Icons.monitor;
                                accessible-name: "Theme mode: " + root.theme-mode + ". Activate to change.";
                                tooltip: "Theme: " + root.theme-mode;

                                active: root.theme-mode != "System";
                                clicked => {
                                    root.theme-mode = root.theme-mode == "System" ? "Light"
                                        : root.theme-mode == "Light" ? "Dark" : "System";
                                }
                            }
                            app-menu-anchor := Rectangle {
                                width: Theme.control-h;
                                height: Theme.control-h;
                                y: 7px;
                                Btn {
                                    width: 100%;
                                    height: 100%;
                                    kind: "flat";
                                    icon: Icons.menu;
                                    accessible-name: "Main Menu";
                                    tooltip: "Main Menu";

                                    clicked => { app-menu-popup.show(); }
                                }
                                app-menu-popup := PopupWindow {
                                    x: -206px;
                                    y: 36px;
                                    width: 240px;
                                    height: 136px;
                                    close-policy: close-on-click-outside;
                                    forward-focus: app-menu-focus;
                                    Rectangle {
                                        background: Theme.popover-bg;
                                        border-width: 1px;
                                        border-color: Theme.border;
                                        border-radius: Theme.radius-popover;
                                        drop-shadow-color: #00000066;
                                        drop-shadow-blur: 24px;
                                        drop-shadow-offset-y: 8px;
                                        VerticalLayout {
                                            padding: 8px;
                                            spacing: 2px;
                                            MenuItem {
                                                icon: Icons.help;
                                                text: "Keyboard Shortcuts";
                                                clicked => {
                                                    app-menu-popup.close();
                                                    root.show-shortcuts = true;
                                                }
                                            }
                                            Rectangle { height: 1px; background: Theme.border; }
                                            MenuItem {
                                                icon: Icons.info;
                                                text: "About Cosmic API";
                                                clicked => {
                                                    app-menu-popup.close();
                                                    root.show-about = true;
                                                }
                                            }
                                            Rectangle { height: 1px; background: Theme.border; }
                                            MenuItem {
                                                icon: Icons.x;
                                                text: "Quit Cosmic API";
                                                clicked => {
                                                    app-menu-popup.close();
                                                    root.close();
                                                }
                                            }
                                        }
                                    }
                                    app-menu-focus := FocusScope {
                                        key-pressed(event) => {
                                            if event.text == Key.Escape {
                                                app-menu-popup.close();
                                                return accept;
                                            }
                                            return reject;
                                        }
                                    }
                                }
                            }
                            if root.custom-frame : Btn { kind: "close"; y: 12px; icon: Icons.x; accessible-name: "Close window"; tooltip: "Close Window"; clicked => { root.close(); } }
                        }
                    }
                }

        HorizontalLayout {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            spacing: 0;

            // ───────────── SIDEBAR (expanded 272px, icon rail 64px) ─────────────
            Rectangle {
                width: root.show-navigation-sidebar ? 272px : 64px;
                background: Theme.sidebar-bg;
                clip: true;
                animate width { duration: 180ms; easing: ease-out; }

                Rectangle { x: parent.width - 1px; width: 1px; background: Theme.border; }

                // Expanded
                Rectangle {
                    visible: root.show-navigation-sidebar;
                    x: 0px;
                    width: 272px;
                    height: parent.height;

                    VerticalLayout {
                        padding: 12px;
                        padding-right: 13px;
                        spacing: 8px;

                        HorizontalLayout {
                            height: 40px;
                            spacing: 10px;
                            padding-left: 4px;
                            Image {
                                width: 24px;
                                height: 24px;
                                y: (parent.height - self.height) / 2;
                                source: @image-url("../assets/logo/cosmic-api-logo.svg");
                                image-fit: contain;
                            }
                            Text {
                                text: "Cosmic API";
                                color: Theme.fg;
                                font-size: 17px;
                                font-weight: 800;
                                vertical-alignment: center;
                            }
                        }

                        Btn {
                            kind: "suggested";
                            text: "New request";
                            icon: Icons.plus;
                            clicked => {
                                if root.selected-collection-id > 0 {
                                    root.start-new-request(root.selected-collection-id, root.selected-collection-name);
                                } else if root.collections.length == 0 {
                                    root.begin-new-collection();
                                } else {
                                    root.open-view("Collections");
                                }
                            }
                        }

                        request-search-field := AdwLineEdit {
                            text: root.request-search;
                            placeholder-text: "Search requests  (Ctrl+K)";
                            edited(value) => {
                                root.request-search = value;
                                root.search-requests(value);
                            }
                        }

                        Rectangle { height: 4px; }

                        NavRow { icon: Icons.folder; text: "Collections"; active: root.active-view == "Collections"; clicked => { root.open-view("Collections"); } }
                        NavRow { icon: Icons.play; text: "Regression testing"; active: root.active-view == "Regression"; clicked => { root.open-view("Regression"); } }
                        NavRow { icon: Icons.history; text: "History"; active: root.active-view == "History"; clicked => { root.open-view("History"); } }
                        NavRow { icon: Icons.globe; text: "Environments"; active: root.active-view == "Environments" || root.active-view == "Variables"; clicked => { root.open-view("Environments"); } }

                        Rectangle { height: 1px; background: Theme.border; }

                        HorizontalLayout {
                            height: 30px;
                            spacing: 6px;
                            padding-left: 4px;
                            Text { text: "Collections"; color: Theme.fg-3; font-size: Theme.fs-small; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
                            Btn {
                                kind: "flat";
                                height: 28px;
                                min-width: 28px;
                                icon: Icons.plus;
                                accessible-name: "Create collection";
                                active: root.show-new-collection;
                                clicked => {
                                    if root.show-new-collection {
                                        root.show-new-collection = false;
                                    } else {
                                        root.begin-new-collection();
                                    }
                                }
                            }
                        }

                        if root.show-new-collection : Rectangle {
                            background: Theme.card-bg;
                            border-width: 1px;
                            border-color: Theme.border;
                            border-radius: 10px;
                            VerticalLayout {
                                padding: 10px;
                                spacing: 8px;
                                Text { text: "New collection"; color: Theme.fg; font-size: Theme.fs-body; font-weight: 700; }
                                AdwLineEdit {
                                    text: root.new-collection-name;
                                    placeholder-text: "Collection name";
                                    edited(value) => { root.new-collection-name = value; }
                                    accepted(value) => { if value != "" { root.create-collection(value); } }
                                }
                                HorizontalLayout {
                                    spacing: 6px;
                                    Btn {
                                        horizontal-stretch: 1;
                                        kind: "suggested";
                                        text: "Create";
                                        enabled: root.new-collection-name != "";
                                        clicked => { root.create-collection(root.new-collection-name); }
                                    }
                                    Btn {
                                        text: "Cancel";
                                        clicked => {
                                            root.show-new-collection = false;
                                            root.new-collection-name = "";
                                            root.variables-message = "";
                                        }
                                    }
                                }
                                if root.variables-message != "" : Text {
                                    text: root.variables-message;
                                    color: Theme.danger;
                                    font-size: Theme.fs-small;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        ScrollView {
                            vertical-stretch: 1;

                            VerticalLayout {
                                alignment: start;
                                spacing: 2px;

                                for collection in root.collections : VerticalLayout {
                                    spacing: 1px;

                                    collection-row := Rectangle {
                                        height: 36px;
                                        border-radius: Theme.radius-control;
                                        background: root.selected-collection-id == collection.id ? Theme.active
                                            : collection-touch.has-hover ? Theme.hover : transparent;

                                        collection-touch := TouchArea {
                                            clicked => {
                                                root.open-collection-request(collection.id, collection.name);
                                            }
                                            pointer-event(event) => {
                                                if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                                                    root.confirm-delete-collection-id = -1;
                                                    root.editing-collection-id = -1;
                                                    root.collection-menu-id = collection.id;
                                                    collection-menu-popup.show();
                                                }
                                            }
                                        }

                                        HorizontalLayout {
                                            x: 8px;
                                            y: 3px;
                                            width: parent.width - 12px;
                                            height: 30px;
                                            spacing: 6px;

                                            if root.editing-collection-id != collection.id : TouchArea {
                                                width: 20px;
                                                height: 30px;
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    if root.expanded-collection-id == collection.id {
                                                        root.expanded-collection-id = -1;
                                                    } else {
                                                        root.expanded-collection-id = collection.id;
                                                        root.load-requests(collection.id);
                                                    }
                                                }
                                                Image {
                                                    source: root.expanded-collection-id == collection.id ? Icons.chevron-down : Icons.chevron-right;
                                                    width: 14px;
                                                    height: 14px;
                                                    x: (parent.width - self.width) / 2;
                                                    y: (parent.height - self.height) / 2;
                                                    colorize: Theme.fg-3;
                                                }
                                            }

                                            if root.editing-collection-id == collection.id : AdwLineEdit {
                                                horizontal-stretch: 1;
                                                height: 28px;
                                                text: root.collection-name-draft;
                                                placeholder-text: "Collection name";
                                                edited(value) => { root.collection-name-draft = value; }
                                                accepted(value) => { if value != "" { root.rename-collection(collection.id, value); } }
                                            }
                                            if root.editing-collection-id != collection.id : Text {
                                                horizontal-stretch: 1;
                                                text: collection.name;
                                                color: root.selected-collection-id == collection.id ? Theme.fg : Theme.fg-2;
                                                font-size: Theme.fs-label;
                                                font-weight: root.selected-collection-id == collection.id ? 700 : 500;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }

                                            if root.editing-collection-id == collection.id : Btn {
                                                kind: "suggested";
                                                height: 28px;
                                                min-width: 28px;
                                                icon: Icons.check;
                                                accessible-name: "Save collection name";
                                                enabled: root.collection-name-draft != "";
                                                clicked => { root.rename-collection(collection.id, root.collection-name-draft); }
                                            }
                                            if root.editing-collection-id == collection.id : Btn {
                                                kind: "flat";
                                                height: 28px;
                                                min-width: 28px;
                                                icon: Icons.x;
                                                accessible-name: "Cancel collection rename";
                                                clicked => { root.editing-collection-id = -1; }
                                            }
                                            if root.editing-collection-id != collection.id : Btn {
                                                kind: "flat";
                                                height: 28px;
                                                min-width: 28px;
                                                text: "⋯";
                                                clicked => {
                                                    root.collection-menu-id = collection.id;
                                                    collection-menu-popup.show();
                                                }
                                            }
                                        }

                                        collection-menu-popup := PopupWindow {
                                            x: 0px;
                                            y: collection-row.absolute-position.y > root.height - 300px ? -258px : collection-row.height + 4px;
                                            width: max(collection-row.width, 232px);
                                            height: 254px;
                                            close-policy: close-on-click-outside;
                                            forward-focus: menu-focus;

                                            Rectangle {
                                                background: Theme.popover-bg;
                                                border-width: 1px;
                                                border-color: Theme.border;
                                                border-radius: 12px;
                                                drop-shadow-color: #00000066;
                                                drop-shadow-blur: 24px;
                                                drop-shadow-offset-y: 8px;

                                                VerticalLayout {
                                                    padding: 8px;
                                                    spacing: 2px;

                                                    VerticalLayout {
                                                        padding-left: 10px;
                                                        padding-top: 4px;
                                                        padding-bottom: 6px;
                                                        spacing: 1px;
                                                        Text { text: "Collection"; color: Theme.accent-text; font-size: Theme.fs-caption; font-weight: 700; }
                                                        Text { text: collection.name; color: Theme.fg; font-size: Theme.fs-label; font-weight: 700; overflow: elide; }
                                                    }

                                                    Rectangle { height: 1px; background: Theme.border; }

                                                    MenuItem {
                                                        icon: Icons.plus;
                                                        text: "New request";
                                                        clicked => {
                                                            root.collection-menu-id = -1;
                                                            collection-menu-popup.close();
                                                            root.start-new-request(collection.id, collection.name);
                                                        }
                                                    }
                                                    MenuItem {
                                                        icon: Icons.play;
                                                        text: "Run all requests";
                                                        clicked => {
                                                            root.collection-menu-id = -1;
                                                            collection-menu-popup.close();
                                                            root.run-collection(collection.id, root.collection-run-stop-on-failure, root.collection-run-retries, root.collection-run-delay-ms);
                                                        }
                                                    }
                                                    MenuItem {
                                                        icon: Icons.braces;
                                                        text: "Collection variables";
                                                        clicked => {
                                                            root.cancel-variable-edit();
                                                            root.selected-collection-id = collection.id;
                                                            root.expanded-collection-id = collection.id;
                                                            root.selected-collection-name = collection.name;
                                                            root.active-view = "Variables";
                                                            root.variables-message = "";
                                                            root.collection-menu-id = -1;
                                                            collection-menu-popup.close();
                                                            root.load-collection-variables(collection.id);
                                                        }
                                                    }

                                                    Rectangle { height: 1px; background: Theme.border; }

                                                    MenuItem {
                                                        icon: Icons.pencil;
                                                        text: "Rename collection";
                                                        clicked => {
                                                            root.editing-collection-id = collection.id;
                                                            root.collection-name-draft = collection.name;
                                                            root.collection-menu-id = -1;
                                                            collection-menu-popup.close();
                                                        }
                                                    }
                                                    MenuItem {
                                                        icon: Icons.trash;
                                                        text: "Delete collection";
                                                        destructive: true;
                                                        enabled: root.collections.length > 1;
                                                        clicked => {
                                                            root.confirm-delete-collection-id = collection.id;
                                                            root.collection-menu-id = -1;
                                                            collection-menu-popup.close();
                                                        }
                                                    }
                                                }
                                            }

                                            menu-focus := FocusScope {
                                                key-pressed(event) => {
                                                    if event.text == Key.Escape {
                                                        root.collection-menu-id = -1;
                                                        collection-menu-popup.close();
                                                        return accept;
                                                    }
                                                    return reject;
                                                }
                                            }
                                        }
                                    }

                                    if root.confirm-delete-collection-id == collection.id : Rectangle {
                                        background: Theme.danger-bg;
                                        border-radius: 8px;
                                        VerticalLayout {
                                            padding: 10px;
                                            spacing: 8px;
                                            Text { text: "Delete this collection and all its requests?"; color: Theme.fg; font-size: Theme.fs-small; wrap: word-wrap; }
                                            HorizontalLayout {
                                                spacing: 6px;
                                                Btn { horizontal-stretch: 1; height: 30px; text: "Cancel"; clicked => { root.confirm-delete-collection-id = -1; } }
                                                Btn {
                                                    horizontal-stretch: 1;
                                                    height: 30px;
                                                    text: "Delete";
                                                    kind: "destructive";
                                                    enabled: root.collections.length > 1;
                                                    clicked => { root.delete-collection(collection.id); }
                                                }
                                            }
                                        }
                                    }

                                    // Requests nest under the open collection (file-tree style).
                                    if root.expanded-collection-id == collection.id && root.saved-requests.length == 0 && !(root.active-request-id <= 0 && root.active-request-tab-index >= 0 && root.selected-collection-id == collection.id && root.request-search == "") : VerticalLayout {
                                        padding-left: 10px;
                                        padding-right: 8px;
                                        padding-top: 4px;
                                        padding-bottom: 8px;
                                        spacing: 3px;
                                        Text {
                                            text: root.request-search == "" ? "No saved requests" : "No matching requests";
                                            color: Theme.fg-2;
                                            font-size: Theme.fs-small;
                                            font-weight: 600;
                                        }
                                        if root.request-search == "" : Text {
                                            text: "Send a request to add it to this collection.";
                                            color: Theme.fg-3;
                                            font-size: Theme.fs-caption;
                                            wrap: word-wrap;
                                        }
                                    }

                                    if root.expanded-collection-id == collection.id : VerticalLayout {
                                        spacing: 1px;
                                        padding-left: 14px;

                                        for request in root.saved-requests : Rectangle {
                                            height: 36px;
                                            border-radius: 8px;
                                            background: root.active-request-id == request.id ? Theme.active
                                                : request-touch.has-hover ? Theme.hover : transparent;

                            request-touch := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.open-saved-request-tab(request.id); }
                                            }

                                            if root.active-request-id == request.id : Rectangle {
                                                x: 0px;
                                                y: 9px;
                                                width: 3px;
                                                height: 18px;
                                                border-radius: 2px;
                                                background: Theme.accent;
                                            }

                                            HorizontalLayout {
                                                padding-left: 10px;
                                                padding-right: 4px;
                                                spacing: 8px;
                                                MethodBadge {
                                                    value: request.method;
                                                    badge-width: 46px;
                                                    y: (parent.height - self.height) / 2;
                                                }
                                                Text {
                                                    horizontal-stretch: 1;
                                                    text: request.name;
                                                    color: root.active-request-id == request.id ? Theme.fg : Theme.fg-2;
                                                    font-size: Theme.fs-body;
                                                    font-weight: root.active-request-id == request.id ? 700 : 500;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                }
                                                Btn {
                                                    kind: "destructive";
                                                    height: 28px;
                                                    min-width: 28px;
                                                    y: 4px;
                                                    icon: Icons.trash;
                                                    icon-size: 14px;
                                                    accessible-name: "Delete request";
                                                    clicked => { root.delete-request(request.id, root.selected-collection-id); }
                                                }
                                            }
                                        }

                                        if root.active-request-id <= 0 && root.active-request-tab-index >= 0 && root.selected-collection-id == collection.id && root.request-search == "" : Rectangle {
                                            height: 36px;
                                            border-radius: 8px;
                                            background: Theme.active;
                                            TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    root.active-view = "Request";
                                                    url-field.focus();
                                                }
                                            }
                                            Rectangle {
                                                x: 0px;
                                                y: 9px;
                                                width: 3px;
                                                height: 18px;
                                                border-radius: 2px;
                                                background: Theme.accent;
                                            }
                                            HorizontalLayout {
                                                padding-left: 10px;
                                                padding-right: 8px;
                                                spacing: 7px;
                                                MethodBadge {
                                                    value: root.active-method;
                                                    badge-width: 46px;
                                                    y: (parent.height - self.height) / 2;
                                                }
                                                Text {
                                                    horizontal-stretch: 1;
                                                    text: root.active-request;
                                                    color: Theme.fg;
                                                    font-size: Theme.fs-body;
                                                    font-weight: 700;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                }
                                                Rectangle {
                                                    width: 56px;
                                                    height: 20px;
                                                    background: Theme.button-bg;
                                                    border-radius: 10px;
                                                    Text {
                                                        text: "Unsaved";
                                                        color: Theme.fg-3;
                                                        font-size: Theme.fs-caption;
                                                        font-weight: 600;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        Rectangle { height: 1px; background: Theme.border; }

                        HorizontalLayout {
                            height: 38px;
                            spacing: 8px;
                            Rectangle { horizontal-stretch: 1; }
                            Btn { kind: "flat"; icon: Icons.help; accessible-name: "Keyboard shortcuts"; clicked => { root.show-shortcuts = true; } }
                        }

                        Text {
                            text: "v0.1.1 · Early development";
                            color: Theme.fg-3;
                            font-size: Theme.fs-caption;
                            horizontal-alignment: center;
                        }
                    }
                }

                // Icon rail (collapsed)
                Rectangle {
                    visible: !root.show-navigation-sidebar;
                    x: 0px;
                    width: 64px;
                    height: parent.height;

                    VerticalLayout {
                        padding: 10px;
                        padding-top: 8px;
                        spacing: 6px;
                        alignment: start;

                        // Keep Cosmic API branding visible when the navigation is collapsed.
                        Rectangle {
                            width: 44px;
                            height: 44px;
                            background: transparent;
                            Image {
                                width: 28px;
                                height: 28px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                source: @image-url("../assets/logo/cosmic-api-logo.svg");
                                image-fit: contain;
                            }
                        }
                        Btn { kind: "suggested"; height: 44px; icon: Icons.plus; accessible-name: "New request"; clicked => { root.start-new-request(root.selected-collection-id, root.selected-collection-name); } }
                        Rectangle { height: 6px; }
                        Btn { kind: "flat"; height: 44px; icon: Icons.folder; accessible-name: "Collections"; active: root.active-view == "Collections"; clicked => { root.open-view("Collections"); } }
                        Btn { kind: "flat"; height: 44px; icon: Icons.play; active: root.active-view == "Regression"; accessible-name: "Regression testing"; clicked => { root.open-view("Regression"); } }
                        Btn { kind: "flat"; height: 44px; icon: Icons.history; accessible-name: "History"; active: root.active-view == "History"; clicked => { root.open-view("History"); } }
                        Btn { kind: "flat"; height: 44px; icon: Icons.globe; accessible-name: "Environments"; active: root.active-view == "Environments" || root.active-view == "Variables"; clicked => { root.open-view("Environments"); } }
                        Rectangle { vertical-stretch: 1; }
                        Btn { kind: "flat"; height: 44px; icon: Icons.help; accessible-name: "Keyboard shortcuts"; clicked => { root.show-shortcuts = true; } }
                    }
                }
            }

            // ───────────── MAIN COLUMN ─────────────
            VerticalLayout {
                // Let the parent allocate all remaining window width instead
                // of inheriting the tab strip's content-based preferred size.
                horizontal-stretch: 1;
                min-width: 0px;
                preferred-width: 0px;
                max-width: 100000px;
                spacing: 0;

                if root.active-view == "Request" && root.request-tabs.length > 0 : Rectangle {
                    horizontal-stretch: 1;
                    height: 46px;
                    background: Theme.headerbar-bg;
                    border-width: 1px;
                    border-color: Theme.border;
                    HorizontalLayout {
                        alignment: start;
                        cross-axis-alignment: center;
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 4px;
                        if root.request-tabs-overflow : Btn {
                            kind: "flat";
                            width: 30px;
                            text: "‹";
                            accessible-name: "Scroll tabs left";
                            tooltip: "Scroll tabs left";
                            enabled: request-tab-scroll.content-x < 0px;
                            clicked => {
                                request-tab-scroll.content-x = request-tab-scroll.content-x + 224px < 0px
                                    ? request-tab-scroll.content-x + 224px : 0px;
                            }
                        }
                        request-tab-scroll := Flickable {
                            horizontal-stretch: 1;
                            max-width: root.request-tabs.length * 228px;
                            height: 40px;
                            content-width: root.request-tabs.length * 224px;
                            content-height: 34px;
                            interactive: true;
                            tab-strip := HorizontalLayout {
                                width: root.request-tabs.length * 224px;
                                height: 34px;
                                spacing: 4px;
                                cross-axis-alignment: center;
                                for tab[index] in root.request-tabs : Rectangle {
                                    width: 220px;
                                    height: 32px;
                                    border-radius: Theme.radius-control;
                                    background: tab.key == root.active-request-tab-key ? Theme.active
                                        : tab-touch.has-hover ? Theme.hover : transparent;
                                    tab-touch := TouchArea {
                                        clicked => { root.activate-request-tab(index); }
                                    }
                                    HorizontalLayout {
                                        cross-axis-alignment: center;
                                        padding-left: 10px;
                                        padding-right: 4px;
                                        spacing: 6px;
                                        Text {
                                            horizontal-stretch: 1;
                                            text: tab.collection-name + "  ›  " + tab.name;
                                            color: tab.key == root.active-request-tab-key ? Theme.fg : Theme.fg-2;
                                            font-size: Theme.fs-small;
                                            font-weight: tab.key == root.active-request-tab-key ? 700 : 500;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                        if tab.request-id <= 0 : Rectangle {
                                            width: 8px;
                                            height: 8px;
                                            border-radius: 4px;
                                            background: Theme.warning;
                                            accessible-role: none;
                                        }
                                        Btn {
                                            kind: "flat";
                                            min-width: 24px;
                                            height: 24px;
                                            icon: Icons.x;
                                            icon-size: 12px;
                                            accessible-name: "Close " + tab.name;
                                            clicked => { root.close-request-tab(index); }
                                        }
                                    }
                                }
                            }
                        }
                        if root.request-tabs-overflow : Btn {
                            kind: "flat";
                            width: 30px;
                            text: "›";
                            accessible-name: "Scroll tabs right";
                            tooltip: "Scroll tabs right";
                            enabled: request-tab-scroll.content-x > request-tab-scroll.width - request-tab-scroll.content-width;
                            clicked => {
                                request-tab-scroll.content-x = request-tab-scroll.content-x - 224px > request-tab-scroll.width - request-tab-scroll.content-width
                                    ? request-tab-scroll.content-x - 224px
                                    : request-tab-scroll.width - request-tab-scroll.content-width;
                            }
                        }
                        Btn {
                            kind: "flat";
                            width: 36px;
                            height: 34px;
                            icon: Icons.plus;
                            accessible-name: "New request tab";
                            tooltip: "New Request";
                            enabled: root.selected-collection-id > 0;
                            clicked => { root.start-new-request(root.selected-collection-id, root.selected-collection-name); }
                        }
                    }
                }


                // View area
                Rectangle {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    background: Theme.window-bg;

                    if root.active-view == "Collections" : CollectionsView {
                        collections: root.collections;
                        selected-collection-id: root.selected-collection-id;
                        new-collection => { root.begin-new-collection(); }
                        open-collection(id, name) => { root.open-collection-request(id, name); }
                    }

                    if root.active-view == "Regression" && root.collection-run-name == "" : HorizontalLayout {
                        padding: 24px;
                        Rectangle { horizontal-stretch: 1; }
                        VerticalLayout {
                            horizontal-stretch: 100;
                            max-width: 880px;
                            vertical-stretch: 1;
                            spacing: 18px;
                            HorizontalLayout {
                                height: 64px;
                                spacing: 14px;
                                Rectangle {
                                    width: 48px;
                                    height: 48px;
                                    border-radius: 14px;
                                    background: Theme.accent.with-alpha(0.16);
                                    Image {
                                        source: Icons.play;
                                        width: 22px;
                                        height: 22px;
                                        x: 13px;
                                        y: 13px;
                                        colorize: Theme.accent-text;
                                    }
                                }
                                VerticalLayout {
                                    cross-axis-alignment: start;
                                    alignment: center;
                                    spacing: 3px;
                                    Text { text: "REGRESSION TESTING"; color: Theme.accent-text; font-size: Theme.fs-caption; font-weight: 700; }
                                    Text { text: "Choose a collection"; color: Theme.fg; font-size: 24px; font-weight: 700; }
                                }
                            }
                            Text {
                                text: "Run every saved request in a collection and inspect each response in one focused workspace.";
                                color: Theme.fg-2;
                                font-size: Theme.fs-body;
                                wrap: word-wrap;
                            }
                            if root.collections.length == 0 : Rectangle {
                                vertical-stretch: 1;
                                border-radius: Theme.radius-card;
                                background: Theme.view-bg;
                                border-width: 1px;
                                border-color: Theme.border;
                                VerticalLayout {
                                    alignment: center;
                                    cross-axis-alignment: center;
                                    spacing: 10px;
                                    Image { source: Icons.folder; width: 30px; height: 30px; colorize: Theme.fg-3; }
                                    Text { text: "No collections yet"; color: Theme.fg; font-size: Theme.fs-heading; font-weight: 700; horizontal-alignment: center; }
                                    Text { text: "Create a collection first, then run its saved requests together."; color: Theme.fg-2; font-size: Theme.fs-body; horizontal-alignment: center; }
                                    Btn {
                                        text: "Create a collection";
                                        kind: "suggested";
                                        icon: Icons.plus;
                                        clicked => {
                                            root.open-view("Collections");
                                            root.begin-new-collection();
                                        }
                                    }
                                }
                            }
                            if root.collections.length > 0 : VerticalLayout {
                                vertical-stretch: 1;
                                spacing: 10px;
                                HorizontalLayout {
                                    height: 38px;
                                    Text { horizontal-stretch: 1; text: "Choose a collection"; color: Theme.fg; font-size: Theme.fs-label; font-weight: 700; vertical-alignment: center; }
                                    Btn {
                                        kind: root.collection-run-stop-on-failure ? "default" : "flat";
                                        active: root.collection-run-stop-on-failure;
                                        text: "Stop after first failure: " + (root.collection-run-stop-on-failure ? "On" : "Off");
                                        accessible-name: "Stop collection after the first failed request";
                                        clicked => { root.collection-run-stop-on-failure = !root.collection-run-stop-on-failure; }
                                    }
                                }
                                HorizontalLayout {
                                    height: 36px;
                                    spacing: 8px;
                                    Text { text: "Retries"; color: Theme.fg-2; font-size: Theme.fs-small; vertical-alignment: center; }
                                    AdwLineEdit { width: 64px; text: root.collection-run-retries; placeholder-text: "0"; input-type: number; edited(value) => { root.collection-run-retries = value; } }
                                    Text { text: "Delay (ms)"; color: Theme.fg-2; font-size: Theme.fs-small; vertical-alignment: center; }
                                    AdwLineEdit { width: 82px; text: root.collection-run-delay-ms; placeholder-text: "0"; input-type: number; edited(value) => { root.collection-run-delay-ms = value; } }
                                    Text { horizontal-stretch: 1; text: "Retries apply to failed requests; delay separates requests."; color: Theme.fg-3; font-size: Theme.fs-caption; vertical-alignment: center; overflow: elide; }
                                }
                                ScrollView {
                                    vertical-stretch: 1;
                                    VerticalLayout {
                                        spacing: 8px;
                                        for collection in root.collections : Rectangle {
                                            height: 76px;
                                            background: collection-choice-touch.has-hover ? Theme.hover : Theme.view-bg;
                                            border-width: 1px;
                                            border-color: collection-choice-touch.has-hover ? Theme.accent.with-alpha(0.6) : Theme.border;
                                            border-radius: Theme.radius-card;
                                            collection-choice-touch := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.run-collection(collection.id, root.collection-run-stop-on-failure, root.collection-run-retries, root.collection-run-delay-ms); }
                                            }
                                            HorizontalLayout {
                                                padding: 12px;
                                                spacing: 12px;
                                                Rectangle {
                                                    width: 42px;
                                                    height: 42px;
                                                    border-radius: 11px;
                                                    background: Theme.accent.with-alpha(0.14);
                                                    Image {
                                                        source: Icons.folder;
                                                        width: 20px;
                                                        height: 20px;
                                                        x: 11px;
                                                        y: 11px;
                                                        colorize: Theme.accent-text;
                                                    }
                                                }
                                                VerticalLayout {
                                                    horizontal-stretch: 1;
                                                    alignment: center;
                                                    spacing: 3px;
                                                    Text { text: collection.name; color: Theme.fg; font-size: Theme.fs-label; font-weight: 700; overflow: elide; }
                                                    Text { text: "Run all saved requests in this collection"; color: Theme.fg-3; font-size: Theme.fs-small; }
                                                }
                                                Btn {
                                                    text: "Run collection";
                                                    kind: "suggested";
                                                    icon: Icons.play;
                                                    clicked => { root.run-collection(collection.id, root.collection-run-stop-on-failure, root.collection-run-retries, root.collection-run-delay-ms); }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }

                    if root.active-view == "Regression" && root.collection-run-name != "" : VerticalLayout {
                        padding: 24px;
                        spacing: 16px;
                        HorizontalLayout {
                            height: 54px;
                            spacing: 12px;
                            cross-axis-alignment: center;
                            Btn {
                                kind: "flat";
                                icon: Icons.arrow-left;
                                accessible-name: "Back to regression testing";
                                tooltip: "Back to regression testing";
                                enabled: root.collection-run-state != "running";
                                clicked => {
                                    root.collection-run-name = "";
                                    root.collection-run-state = "idle";
                                    root.collection-run-error = "";
                                }
                            }
                            Text { text: "Regression testing"; color: Theme.fg-2; font-size: Theme.fs-label; vertical-alignment: center; }
                            Image {
                                source: Icons.chevron-right;
                                width: 14px;
                                height: 14px;
                                colorize: Theme.fg-3;
                            }
                            Text {
                                text: root.collection-run-name;
                                color: Theme.fg;
                                font-size: Theme.fs-label;
                                font-weight: 700;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            Rectangle { horizontal-stretch: 1; }
                            Text { text: root.collection-run-state == "running" ? "Running · " + root.collection-run-completed + " of " + root.collection-run-total : root.collection-run-state == "completed" ? "Completed in " + root.collection-run-duration : root.collection-run-state; color: root.collection-run-failed > 0 ? Theme.danger : Theme.fg-2; font-size: Theme.fs-label; vertical-alignment: center; }
                        }
                        Rectangle { height: 1px; background: Theme.border; }
                        HorizontalLayout { height: 74px; spacing: 10px;
                            for metric in [{title: "TOTAL", value: root.collection-run-total, tint: Theme.fg}, {title: "PASSED", value: root.collection-run-passed, tint: Theme.success}, {title: "FAILED", value: root.collection-run-failed, tint: Theme.danger}, {title: "SKIPPED", value: root.collection-run-skipped, tint: Theme.fg-2}] : Rectangle {
                                horizontal-stretch: 1; border-radius: 10px; background: Theme.view-bg; border-width: 1px; border-color: Theme.border;
                                VerticalLayout { padding: 12px; spacing: 3px;
                                    Text { text: metric.title; color: Theme.fg-3; font-size: Theme.fs-caption; font-weight: 700; }
                                    Text { text: "" + metric.value; color: metric.tint; font-size: 22px; font-weight: 700; }
                                }
                            }
                        }
                        if root.collection-run-state == "running" : Rectangle {
                            height: 3px; background: Theme.border; border-radius: 2px;
                            Rectangle { width: root.collection-run-total > 0 ? parent.width * root.collection-run-completed / root.collection-run-total : 0px; height: parent.height; background: Theme.accent; border-radius: 2px; animate width { duration: 180ms; } }
                        }
                        CollectionRunPanes {
                            vertical-stretch: 1;
                            results: root.collection-run-results;
                            selected-index: root.collection-run-selected;
                            run-state: root.collection-run-state;
                            error-message: root.collection-run-error;
                            header-items: root.collection-run-header-items;
                            response-tab: root.collection-run-response-tab;
                            dark: root.dark-mode;
                            stacked: root.width < 1180px;
                            request-selected(index) => {
                                root.collection-run-selected = index;
                                root.collection-run-response-tab = "Body";
                                root.collection-run-header-items = root.parse-response-headers(root.collection-run-results[index].headers);
                            }
                            tab-selected(tab) => { root.collection-run-response-tab = tab; }
                            tokenize-response(source, format, dark, columns) => { root.tokenize-response(source, format, dark, columns); }
                            build-json-tree(scope, source, dark) => { root.build-json-tree(scope, source, dark); }
                            toggle-json-tree-node(scope, path) => { root.toggle-json-tree-node(scope, path); }
                            copy-text(text) => { root.copy-text(text); }
                        }
                    }

                    if root.active-view == "Environments" : EnvironmentView {
                        environment-items: root.environment-items;
                        show-variable-values: root.show-variable-values;
                        toggle-values => { root.show-variable-values = !root.show-variable-values; }
                        manage-collection(id, name) => {
                            root.cancel-variable-edit();
                            root.selected-collection-id = id;
                            root.expanded-collection-id = id;
                            root.selected-collection-name = name;
                            root.load-collection-variables(id);
                            root.active-view = "Variables";
                        }
                    }

                    if root.active-view == "History" : HistoryView {
                        history-items: root.history-items;
                        history-visible-items: root.history-visible-items;
                        history-page-items: root.history-page-items;
                        history-loading: root.history-loading;
                        history-loader-visible: root.history-loader-visible;
                        history-load-error: root.history-load-error;
                        history-spinner-phase: root.history-spinner-phase;
                        history-page: root.history-page;
                        history-page-size: root.history-page-size;
                        history-sort: root.history-sort;
                        history-filter: root.history-filter;
                        accent: root.accent;
                        filter-selected(filter) => {
                            root.history-filter = filter;
                            root.history-visible-items = root.filter-history(filter);
                            root.history-page = 1;
                            root.refresh-history-page();
                        }
                        page-size-selected(value) => {
                            root.history-page-size = value == "10" ? 10 : value == "50" ? 50 : value == "100" ? 100 : 20;
                            root.history-page = 1;
                            root.refresh-history-page();
                        }
                        sort-selected(value) => {
                            root.history-sort = value;
                            root.history-load-generation += 1;
                            root.history-loading = true;
                            root.history-loader-visible = true;
                            root.history-load-error = "";
                            root.history-page = 1;
                            root.load-history(value);
                        }
                        retry => {
                            root.history-load-generation += 1;
                            root.history-loading = true;
                            root.history-loader-visible = true;
                            root.history-load-error = "";
                            root.load-history(root.history-sort);
                        }
                        request-selected(id, collection-name) => {
                            root.selected-collection-name = collection-name;
                            root.open-saved-request-tab(id);
                        }
                        previous-page => {
                            root.history-page -= 1;
                            root.refresh-history-page();
                        }
                        next-page => {
                            root.history-page += 1;
                            root.refresh-history-page();
                        }
                    }
                    // ───────── Variables ─────────
                    if root.active-view == "Variables" : HorizontalLayout {
                        padding: 24px;
                        Rectangle { horizontal-stretch: 1; }
                        VerticalLayout {
                            horizontal-stretch: 100;
                            max-width: 1000px;
                            spacing: 14px;

                            HorizontalLayout {
                                height: 40px;
                                Text {
                                    text: "Values available to requests in " + root.selected-collection-name;
                                    color: Theme.fg-2;
                                    font-size: Theme.fs-label;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                                Btn {
                                    text: "Back to requests";
                                    clicked => {
                                        root.cancel-variable-edit();
                                        root.active-view = "Request";
                                    }
                                }
                            }

                            Rectangle {
                                background: Theme.view-bg;
                                border-width: 1px;
                                border-color: Theme.border;
                                border-radius: Theme.radius-card;

                                VerticalLayout {
                                    padding: 18px;
                                    spacing: 10px;
                                    Text { text: "Add a variable"; color: Theme.fg; font-size: Theme.fs-label; font-weight: 700; }
                                    Text { text: "Use {variable_name} in a request, or {{variable_name}} for compatibility."; color: Theme.fg-2; font-size: Theme.fs-small; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        height: 38px;
                                        AdwLineEdit { width: 200px; text: root.variable-key; placeholder-text: "Variable name"; edited(value) => { root.variable-key = value; } }
                                        AdwLineEdit { horizontal-stretch: 1; text: root.variable-value; placeholder-text: "Value"; edited(value) => { root.variable-value = value; } }
                                        Btn { text: root.variable-is-secret ? "Secret ✓" : "Plain"; clicked => { root.variable-is-secret = !root.variable-is-secret; } }
                                        Btn {
                                            kind: "suggested";
                                            text: "Add variable";
                                            enabled: root.selected-collection-id > 0 && root.variable-key != "";
                                            clicked => { root.create-collection-variable(root.selected-collection-id, root.variable-key, root.variable-value, root.variable-is-secret); }
                                        }
                                    }
                                    Text {
                                        text: root.variables-message;
                                        color: root.variables-message == "Variable added." || root.variables-message == "Variable deleted."
                                            ? Theme.success : root.variables-message == "" ? Theme.fg-3 : Theme.danger;
                                        font-size: Theme.fs-small;
                                    }
                                }
                            }

                            HorizontalLayout {
                                height: 32px;
                                Text { text: "Variables · " + root.collection-variables.length; color: Theme.fg; font-size: Theme.fs-heading; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
                                Btn { height: 30px; text: root.show-variable-values ? "Hide values" : "Show values"; clicked => { root.show-variable-values = !root.show-variable-values; } }
                            }

                            ScrollView {
                                vertical-stretch: 1;
                                VerticalLayout {
                                    alignment: start;
                                    spacing: 8px;

                                    if root.collection-variables.length == 0 : Rectangle {
                                        height: 180px;
                                        background: Theme.view-bg;
                                        border-width: 1px;
                                        border-color: Theme.border;
                                        border-radius: Theme.radius-card;
                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 8px;
                                            Text { text: "No variables in this collection yet"; color: Theme.fg; font-size: Theme.fs-label; font-weight: 700; horizontal-alignment: center; }
                                            Text { text: "Add a key and value above to reuse it in requests."; color: Theme.fg-2; font-size: Theme.fs-body; horizontal-alignment: center; }
                                        }
                                    }

                                    for variable in root.collection-variables : Rectangle {
                                        property <bool> editing: root.editing-variable-key == variable.key
                                            && root.editing-variable-collection-id == root.selected-collection-id;
                                        height: editing ? (root.editing-variable-message == "" ? 68px : 92px) : 58px;
                                        background: Theme.view-bg;
                                        border-width: editing ? 2px : 1px;
                                        border-color: editing ? Theme.accent : Theme.border;
                                        border-radius: 10px;
                                        if editing : Rectangle {
                                            background: transparent;
                                            HorizontalLayout {
                                                x: 8px;
                                                y: (parent.height - self.height) / 2;
                                                width: parent.width - 16px;
                                                height: 38px;
                                                spacing: 8px;
                                                cross-axis-alignment: center;
                                                AdwLineEdit {
                                                    width: 200px;
                                                    text: root.editing-variable-draft-key;
                                                    placeholder-text: "Variable name";
                                                    edited(value) => { root.editing-variable-draft-key = value; }
                                                }
                                                AdwLineEdit {
                                                    horizontal-stretch: 1;
                                                    text: root.editing-variable-draft-value;
                                                    placeholder-text: "Value";
                                                    edited(value) => { root.editing-variable-draft-value = value; }
                                                }
                                                Btn {
                                                    text: root.editing-variable-draft-secret ? "Secret ✓" : "Plain";
                                                    clicked => { root.editing-variable-draft-secret = !root.editing-variable-draft-secret; }
                                                }
                                                Btn {
                                                    kind: "suggested";
                                                    text: "Save";
                                                    enabled: root.editing-variable-draft-key != "";
                                                    clicked => {
                                                        root.update-collection-variable(
                                                            root.editing-variable-collection-id,
                                                            root.editing-variable-key,
                                                            root.editing-variable-draft-key,
                                                            root.editing-variable-draft-value,
                                                            root.editing-variable-draft-secret
                                                        );
                                                    }
                                                }
                                                Btn {
                                                    kind: "flat";
                                                    icon: Icons.x;
                                                    accessible-name: "Cancel variable edit";
                                                    clicked => { root.cancel-variable-edit(); }
                                                }
                                            }
                                            if root.editing-variable-message != "" : Text {
                                                x: 16px;
                                                y: parent.height - self.height - 4px;
                                                width: parent.width - 32px;
                                                height: 18px;
                                                text: root.editing-variable-message;
                                                color: Theme.danger;
                                                font-size: Theme.fs-small;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                        }
                                        if !editing : HorizontalLayout {
                                            padding: 10px;
                                            padding-left: 16px;
                                            spacing: 12px;
                                            Text { width: 220px; text: variable.key; color: Theme.fg; font-family: Theme.font-mono; font-size: Theme.fs-body; font-weight: 700; vertical-alignment: center; overflow: elide; }
                                            Text {
                                                horizontal-stretch: 1;
                                                text: root.show-variable-values ? variable.value : "••••••••";
                                                color: Theme.fg-2;
                                                font-family: Theme.font-mono;
                                                font-size: Theme.fs-body;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                            Btn {
                                                kind: "flat";
                                                icon: Icons.pencil;
                                                accessible-name: "Edit " + variable.key;
                                                clicked => { root.begin-variable-edit(variable.key, variable.value, variable.is-secret); }
                                            }
                                            Btn {
                                                kind: "destructive";
                                                icon: Icons.trash;
                                                accessible-name: "Delete " + variable.key;
                                                clicked => { root.delete-collection-variable(root.selected-collection-id, variable.key); }
                                            }
                                        }
                                    }
                                }
                            }
                            Text { text: "Regular values are stored in SQLite. Secret values are stored in your operating-system credential store."; color: Theme.fg-3; font-size: Theme.fs-small; wrap: word-wrap; }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }

                    // ───────── Request / Response workspace ─────────
                    request-workspace := Rectangle {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: parent.height;
                        visible: root.active-view == "Request";
                        if root.active-request-id <= 0 && root.active-request-tab-index < 0 : Rectangle {
                            x: 0px;
                            y: 0px;
                            width: parent.width;
                            height: parent.height;

                            VerticalLayout {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                width: min(parent.width - 64px, 560px);
                                height: 300px;
                                alignment: center;
                                cross-axis-alignment: center;
                                spacing: 14px;

                                Image {
                                    source: @image-url("../assets/logo/cosmic-api-logo.svg");
                                    width: 112px;
                                    height: 112px;
                                    image-fit: contain;
                                }

                                Text {
                                    text: root.selected-collection-id > 0 ? "Choose a saved request" : "Your workspace starts here";
                                    color: Theme.fg;
                                    font-size: 26px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: root.selected-collection-id > 0
                                        ? "Select a saved request from the sidebar, or create a new request."
                                        : root.collections.length == 0
                                        ? "Create a collection to keep your API requests together. Then add a request and start testing."
                                        : "Choose a collection from the sidebar to open a request, or create a new collection to get started.";
                                    color: Theme.fg-2;
                                    font-size: Theme.fs-label;
                                    horizontal-alignment: center;
                                    wrap: word-wrap;
                                }

                                HorizontalLayout {
                                    spacing: 10px;
                                    alignment: center;
                                    Rectangle { width: 1px; height: 1px; horizontal-stretch: 1; }
                                    Btn {
                                        kind: "pill";
                                        text: root.selected-collection-id > 0 ? "New request" : root.collections.length == 0 ? "Create a collection" : "Browse collections";
                                        icon: root.selected-collection-id > 0 ? Icons.plus : root.collections.length == 0 ? Icons.plus : Icons.folder;
                                        clicked => {
                                            if root.selected-collection-id > 0 {
                                                root.start-new-request(root.selected-collection-id, root.selected-collection-name);
                                            } else if root.collections.length == 0 {
                                                root.begin-new-collection();
                                            } else {
                                                root.open-view("Collections");
                                            }
                                        }
                                    }
                                    if root.collections.length > 0 && root.selected-collection-id <= 0 : Btn {
                                        kind: "flat";
                                        text: "Create collection";
                                        icon: Icons.plus;
                                        clicked => { root.begin-new-collection(); }
                                    }
                                    Rectangle { width: 1px; height: 1px; horizontal-stretch: 1; }
                                }
                            }
                        }

                        VerticalLayout {
                        padding: 16px;
                        padding-top: 14px;
                        spacing: 12px;

                        // URL bar
                        Rectangle {
                            visible: root.active-request-id > 0 || root.active-request-tab-index >= 0;
                            height: 54px;
                            background: Theme.card-bg;
                            border-width: 1px;
                            border-color: Theme.border;
                            border-radius: Theme.radius-card;

                            HorizontalLayout {
                                padding: 9px;
                                spacing: 8px;

                                ChoiceDropdown {
                                    width: 108px;
                                    options: ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"];
                                    current-value: root.active-method;
                                    dark-mode: Theme.dark;
                                    accent-button: true;
                                    accent-color: Theme.method-button-color(root.active-method);
                                    selected(value) => { root.active-method = value; }
                                }

                                Btn {
                                    kind: "flat";
                                    text: "Import cURL";
                                    clicked => {
                                        root.curl-import-command = "";
                                        root.curl-import-error = "";
                                        root.show-curl-import = true;
                                    }
                                }

                                url-field := AdwLineEdit {
                                    horizontal-stretch: 1;
                                    text <=> root.request-url;
                                    placeholder-text: "Enter request URL…   (Ctrl+L to focus, Ctrl+Enter to send)";
                                    font-size: Theme.fs-label;
                                    font-family: Theme.font-mono;
                                    accepted(value) => { root.send-current-request(); }
                                }

                                Btn {
                                    kind: "flat";
                                    text: "Copy cURL";
                                    enabled: root.request-url != "";
                                    clicked => {
                                        let command = root.build-curl(
                                            root.active-method,
                                            root.request-url,
                                            root.request-body,
                                            root.request-headers,
                                            root.request-params,
                                            root.body-format,
                                            root.auth-type,
                                            root.auth-value,
                                            root.auth-secret
                                        );
                                        root.copy-text(command);
                                        root.response-status = "cURL command copied";
                                    }
                                }

                                Btn {
                                    kind: "suggested";
                                    width: 120px;
                                    text: root.is-loading ? "Sending…" : "Send";
                                    icon: Icons.send;
                                    enabled: !root.is-loading && root.selected-collection-id > 0 && root.request-url != "" && root.active-request != "";
                                    clicked => { root.send-current-request(); }
                                }
                            }
                        }

                        // Request editor above the response with a draggable horizontal divider.
                        split-area := Rectangle {
                            visible: root.active-request-id > 0 || root.active-request-tab-index >= 0;
                            vertical-stretch: 1;
                            // Request pane
                            Rectangle {
                                x: 0px;
                                y: 0px;
                                width: parent.width;
                                height: parent.height * root.split-ratio - 6px;
                                background: Theme.view-bg;
                                border-width: 1px;
                                border-color: Theme.border;
                                border-radius: Theme.radius-card;
                                clip: true;

                                VerticalLayout {
                                    spacing: 0px;

                                    HorizontalLayout {
                                        height: 48px;
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 8px;

                                        VerticalLayout {
                                            height: 48px;
                                            alignment: center;
                                            TabBar {
                                                tabs: ["Params", "Headers", "Body", "Auth", "Assertions", "Settings"];
                                                counts: [
                                                    root.request-param-rows.length > 0 ? "" + root.request-param-rows.length : "",
                                                    root.request-header-rows.length > 0 ? "" + root.request-header-rows.length : "",
                                                    "", "", root.request-assertions != "[]" ? "✓" : "", ""
                                                ];
                                                current: root.active-tab;
                                                selected(t) => { root.active-tab = t; }
                                            }
                                        }

                                        Rectangle { horizontal-stretch: 1; }

                                        if root.active-tab == "Body" : VerticalLayout {
                                            height: 48px;
                                            alignment: center;
                                            ChoiceDropdown {
                                                accent-color: root.accent;
                                                width: 96px;
                                                height: 30px;
                                                options: ["JSON", "Text", "HTML", "XML"];
                                                current-value: root.body-format;
                                                dark-mode: Theme.dark;
                                                selected(value) => { root.body-format = value; }
                                            }
                                        }
                                        if root.active-tab == "Headers" : VerticalLayout {
                                            height: 48px;
                                            alignment: center;
                                            ChoiceDropdown {
                                                accent-color: root.accent;
                                                width: 160px;
                                                height: 30px;
                                                options: ["Add a preset…", "Accept", "Content-Type", "Cache-Control", "User-Agent", "X-Request-ID"];
                                                current-value: root.header-preset;
                                                dark-mode: Theme.dark;
                                                selected(value) => { root.add-header-preset(value); }
                                            }
                                        }
                                    }

                                    Rectangle { height: 1px; background: Theme.border; }

                                    Rectangle {
                                        vertical-stretch: 1;
                                        background: Theme.view-bg;

                                        if root.active-tab == "Body" : AdwTextEdit {
                                            width: parent.width;
                                            height: parent.height;
                                            text: root.request-body;
                                            placeholder-text: "Write " + root.body-format + " request data here…";
                                            font-family: Theme.font-mono;
                                            font-size: 13px;
                                            wrap: word-wrap;
                                            auto-complete: true;
                                            language: root.body-format;
                                            auto-pair-key(text, cursor, anchor, key, language) => { root.auto-pair-request-body(text, cursor, anchor, key, language) }
                                            edited(value) => { root.request-body = value; }
                                        }

                                        if root.active-tab == "Assertions" : VerticalLayout {
                                            VerticalLayout {
                                                padding: 12px;
                                                spacing: 8px;
                                                HorizontalLayout {
                                                    height: 38px;
                                                    spacing: 6px;
                                                    ChoiceDropdown {
                                                        width: 150px;
                                                        height: 32px;
                                                        options: ["HTTP status", "HTTP status class", "HTTP status any of", "Latency under (ms)", "Body contains", "JSON Pointer equals", "Header exists", "Header equals", "Header contains", "Capture JSON Pointer"];
                                                        current-value: root.assertion-kind;
                                                        dark-mode: Theme.dark;
                                                        selected(value) => { root.assertion-kind = value; }
                                                    }
                                                    AdwLineEdit {
                                                        horizontal-stretch: 1;
                                                        text: root.assertion-first-value;
                                                        placeholder-text: root.assertion-kind == "HTTP status" ? "Code, e.g. 200" : root.assertion-kind == "HTTP status class" ? "Class, e.g. 2xx" : root.assertion-kind == "HTTP status any of" ? "Codes, e.g. 200, 201" : root.assertion-kind == "Latency under (ms)" ? "Milliseconds, e.g. 500" : root.assertion-kind == "Body contains" ? "Text to find" : root.assertion-kind == "Header exists" || root.assertion-kind == "Header equals" || root.assertion-kind == "Header contains" ? "Response header name" : "JSON Pointer, e.g. /data/id";
                                                        edited(value) => { root.assertion-first-value = value; }
                                                    }
                                                    if root.assertion-kind == "JSON Pointer equals" || root.assertion-kind == "Header equals" || root.assertion-kind == "Header contains" || root.assertion-kind == "Capture JSON Pointer" : AdwLineEdit {
                                                        horizontal-stretch: 1;
                                                        text: root.assertion-second-value;
                                                        placeholder-text: root.assertion-kind == "JSON Pointer equals" ? "Expected JSON value" : root.assertion-kind == "Header equals" ? "Expected header value" : root.assertion-kind == "Header contains" ? "Text to find in header" : "Variable name for captured value";
                                                        edited(value) => { root.assertion-second-value = value; }
                                                    }
                                                    Btn {
                                                        kind: "suggested";
                                                        text: root.editing-assertion-index >= 0 ? "Update" : "Add";
                                                        clicked => {
                                                            let updated = root.editing-assertion-index >= 0
                                                                ? root.update-assertion(root.request-assertions, root.editing-assertion-index, root.assertion-kind, root.assertion-first-value, root.assertion-second-value)
                                                                : root.append-assertion(root.request-assertions, root.assertion-kind, root.assertion-first-value, root.assertion-second-value);
                                                            if updated == "" {
                                                                root.assertion-editor-message = "Check the value and try again. JSON Pointer expected values must be valid JSON.";
                                                            } else {
                                                                root.request-assertions = updated;
                                                                root.assertion-editor-message = root.editing-assertion-index >= 0 ? "Check updated. Save the request to keep it." : "Check added. Save the request to keep it.";
                                                                root.editing-assertion-index = -1;
                                                                root.assertion-first-value = "";
                                                                root.assertion-second-value = "";
                                                                root.store-active-request-tab();
                                                            }
                                                        }
                                                    }
                                                    if root.editing-assertion-index >= 0 : Btn {
                                                        kind: "flat";
                                                        text: "Cancel";
                                                        clicked => {
                                                            root.editing-assertion-index = -1;
                                                            root.assertion-first-value = "";
                                                            root.assertion-second-value = "";
                                                        }
                                                    }
                                                }
                                                Text { text: root.assertion-editor-message; color: root.assertion-editor-message == "" ? Theme.fg-3 : Theme.fg-2; font-size: Theme.fs-small; }
                                                HorizontalLayout {
                                                    height: 34px;
                                                    Text { horizontal-stretch: 1; text: "Checks for this request"; color: Theme.fg-2; font-size: Theme.fs-small; vertical-alignment: center; }
                                                    Btn {
                                                        kind: "flat";
                                                        text: root.assertion-advanced ? "Hide advanced JSON" : "Advanced JSON";
                                                        clicked => { root.assertion-advanced = !root.assertion-advanced; }
                                                    }
                                                }
                                                if root.assertion-items.length == 0 && !root.assertion-advanced : VerticalLayout {
                                                    vertical-stretch: 1;
                                                    alignment: center;
                                                    spacing: 6px;
                                                    Text { text: "No checks added"; color: Theme.fg; font-size: Theme.fs-label; font-weight: 700; horizontal-alignment: center; }
                                                    Text { text: "Add a status, response, timing, or header check above."; color: Theme.fg-3; font-size: Theme.fs-small; horizontal-alignment: center; }
                                                }
                                                if root.assertion-items.length > 0 && !root.assertion-advanced : ScrollView {
                                                    vertical-stretch: 1;
                                                    content-width: self.width;
                                                    content-height: max(self.height, root.assertion-items.length * 58px);
                                                    VerticalLayout {
                                                        spacing: 6px;
                                                        for item in root.assertion-items : Rectangle {
                                                            height: 52px;
                                                            border-radius: 7px;
                                                            background: Theme.view-bg;
                                                            border-width: 1px;
                                                            border-color: Theme.border;
                                                            HorizontalLayout {
                                                                padding: 8px;
                                                                spacing: 8px;
                                                                VerticalLayout {
                                                                    horizontal-stretch: 1;
                                                                    alignment: center;
                                                                    spacing: 2px;
                                                                    Text { text: item.title; color: Theme.fg; font-size: Theme.fs-small; font-weight: 700; overflow: elide; }
                                                                    Text { text: item.summary; color: Theme.fg-3; font-size: Theme.fs-caption; overflow: elide; }
                                                                }
                                                                Btn {
                                                                    kind: "flat";
                                                                    text: "Edit";
                                                                    accessible-name: "Edit assertion";
                                                                    clicked => {
                                                                        root.editing-assertion-index = item.index;
                                                                        root.assertion-kind = item.kind;
                                                                        root.assertion-first-value = item.first;
                                                                        root.assertion-second-value = item.second;
                                                                        root.assertion-editor-message = "Edit the check above, then choose Update.";
                                                                    }
                                                                }
                                                                Btn {
                                                                    kind: "flat";
                                                                    text: "Remove";
                                                                    accessible-name: "Remove assertion";
                                                                    clicked => {
                                                                        if root.editing-assertion-index == item.index {
                                                                            root.editing-assertion-index = -1;
                                                                            root.assertion-first-value = "";
                                                                            root.assertion-second-value = "";
                                                                        } else if root.editing-assertion-index > item.index {
                                                                            root.editing-assertion-index -= 1;
                                                                        }
                                                                        let updated = root.remove-assertion(root.request-assertions, item.index);
                                                                        if updated != "" {
                                                                            root.request-assertions = updated;
                                                                            root.store-active-request-tab();
                                                                        } else {
                                                                            root.assertion-editor-message = "Could not remove this check. Open Advanced JSON to inspect it.";
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                                if root.assertion-advanced : AdwTextEdit {
                                                    vertical-stretch: 1;
                                                    text: root.request-assertions;
                                                    placeholder-text: "Assertions as JSON";
                                                    font-family: Theme.font-mono;
                                                    font-size: 13px;
                                                    wrap: word-wrap;
                                                    edited(value) => { root.request-assertions = value; root.store-active-request-tab(); }
                                                }
                                            }
                                        }

                                        if root.active-tab == "Headers" : KeyValueEditor {
                                            accent-color: root.accent;
                                            width: parent.width;
                                            height: parent.height;
                                            rows: root.request-header-rows;
                                            key-placeholder: "Header name";
                                            value-placeholder: "Header value";
                                            add-label: "Add header";
                                            dark-mode: Theme.dark;
                                            changed(rows) => {
                                                root.request-headers = root.serialize-header-rows(rows);
                                            }
                                        }

                                        if root.active-tab == "Params" : KeyValueEditor {
                                            accent-color: root.accent;
                                            width: parent.width;
                                            height: parent.height;
                                            rows: root.request-param-rows;
                                            key-placeholder: "Parameter name";
                                            value-placeholder: "Parameter value";
                                            add-label: "Add parameter";
                                            dark-mode: Theme.dark;
                                            changed(rows) => {
                                                root.request-params = root.serialize-param-rows(rows);
                                            }
                                        }

                                        if root.active-tab == "Auth" : VerticalLayout {
                                            padding: 20px;
                                            spacing: 10px;
                                            alignment: start;
                                            Text { text: "Authentication type"; color: Theme.fg-2; font-size: Theme.fs-small; font-weight: 600; }
                                            ChoiceDropdown {
                                                accent-color: root.accent;
                                                width: 200px;
                                                options: ["None", "Bearer", "Basic", "API Key"];
                                                current-value: root.auth-type;
                                                dark-mode: Theme.dark;
                                                selected(value) => {
                                                    root.auth-type = value;
                                                    root.auth-value = "";
                                                    root.auth-secret = "";
                                                }
                                            }
                                            if root.auth-type == "Bearer" : AdwLineEdit {
                                                max-width: 420px;
                                                text: root.auth-value;
                                                placeholder-text: "Bearer token";
                                                input-type: password;
                                                edited(value) => { root.auth-value = value; }
                                            }
                                            if root.auth-type == "Basic" : HorizontalLayout {
                                                max-width: 560px;
                                                spacing: 8px;
                                                AdwLineEdit { horizontal-stretch: 1; text: root.auth-value; placeholder-text: "Username"; edited(value) => { root.auth-value = value; } }
                                                AdwLineEdit { horizontal-stretch: 1; text: root.auth-secret; placeholder-text: "Password"; input-type: password; edited(value) => { root.auth-secret = value; } }
                                            }

                                            if root.auth-type == "None" : Text {
                                                text: "This request is sent without authentication.";
                                                color: Theme.fg-3;
                                                font-size: Theme.fs-body;
                                            }
                                        }

                                        if root.active-tab == "Settings" : VerticalLayout {
                                            padding: 20px;
                                            spacing: 12px;
                                            alignment: start;
                                            Text { text: "Redirect behavior"; color: Theme.fg-2; font-size: Theme.fs-small; font-weight: 600; }
                                            ChoiceDropdown {
                                                accent-color: root.accent;
                                                width: 230px;
                                                options: ["Follow same-origin", "Do not follow"];
                                                current-value: root.follow-redirects ? "Follow same-origin" : "Do not follow";
                                                dark-mode: Theme.dark;
                                                selected(value) => { root.follow-redirects = value == "Follow same-origin"; }
                                            }
                                            Text {
                                                text: root.follow-redirects
                                                    ? "Same-origin redirects are followed. Cross-origin redirects are always stopped to protect credentials."
                                                    : "Redirects are disabled for this request. The first response is returned as-is.";
                                                color: Theme.fg-3;
                                                font-size: Theme.fs-body;
                                                wrap: word-wrap;
                                                max-width: 560px;
                                            }
                                            Text { text: "Request timeout (milliseconds)"; color: Theme.fg-2; font-size: Theme.fs-small; font-weight: 600; }
                                            AdwLineEdit {
                                                width: 180px;
                                                input-type: InputType.number;
                                                text <=> root.request-timeout-ms;
                                                placeholder-text: "30000";
                                            }
                                            Text { text: "Allowed: 100–600000 ms. Default: 30000 ms."; color: Theme.fg-3; font-size: Theme.fs-small; }
                                        }
                                    }
                                }
                            }

                            // Response pane
                            Rectangle {
                                x: 0px;
                                y: parent.height * root.split-ratio + 6px;
                                width: parent.width;
                                height: parent.height * (1 - root.split-ratio) - 6px;
                                background: Theme.view-bg;
                                border-width: 1px;
                                border-color: Theme.border;
                                border-radius: Theme.radius-card;
                                clip: true;

                                VerticalLayout {
                                    spacing: 0px;

                                    HorizontalLayout {
                                        height: 48px;
                                        padding-left: 8px;
                                        padding-right: 12px;
                                        padding-top: 0px;
                                        padding-bottom: 0px;
                                        spacing: 10px;

                                        VerticalLayout {
                                            height: 48px;
                                            alignment: center;
                                            TabBar {
                                                tabs: ["Body", "Headers", "Cookies"];
                                                counts: ["", "" + root.response-header-items.length, "" + root.response-cookie-items.length];
                                                current: root.response-tab;
                                                selected(t) => { root.response-tab = t; }
                                            }
                                        }

                                        Rectangle { horizontal-stretch: 1; }

                                        if root.response-state != "idle" && root.response-state != "loading" : VerticalLayout {
                                            height: 48px;
                                            alignment: center;
                                            Text {
                                                text: root.response-format;
                                                color: Theme.fg-3;
                                                font-size: Theme.fs-small;
                                                font-weight: 600;
                                                vertical-alignment: center;
                                            }
                                        }
                                        VerticalLayout {
                                            height: 48px;
                                            alignment: center;
                                            StatusPill {
                                                status: root.response-status;
                                                state: root.response-state;
                                            }
                                        }
                                        VerticalLayout {
                                            height: 48px;
                                            alignment: center;
                                            Text {
                                                text: root.response-time == "---" ? "" : root.response-time;
                                                color: Theme.fg-2;
                                                font-size: Theme.fs-small;
                                                font-weight: 600;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    Rectangle { height: 1px; background: Theme.border; }

                                    Rectangle {
                                        vertical-stretch: 1;
                                        background: Theme.view-bg;

                                        if root.response-state == "idle" || root.response-state == "loading" : VerticalLayout {
                                            alignment: center;
                                            cross-axis-alignment: center;
                                            spacing: 8px;
                                            if root.response-state == "loading" : Rectangle {
                                                width: 56px;
                                                height: 56px;
                                                background: transparent;
                                                Rectangle {
                                                    x: 6px;
                                                    y: 6px;
                                                    width: 44px;
                                                    height: 44px;
                                                    border-radius: 22px;
                                                    border-width: 1px;
                                                    border-color: Theme.accent.with-alpha(0.24);
                                                    background: Theme.accent.with-alpha(0.035);
                                                }
                                                Rectangle {
                                                    x: 25px + 20px * sin(360deg * animation-tick() / 1.35s);
                                                    y: 25px - 20px * cos(360deg * animation-tick() / 1.35s);
                                                    width: 6px;
                                                    height: 6px;
                                                    border-radius: 3px;
                                                    background: Theme.accent;
                                                }
                                                Rectangle {
                                                    x: 25px + 20px * sin(360deg * animation-tick() / 1.35s + 120deg);
                                                    y: 25px - 20px * cos(360deg * animation-tick() / 1.35s + 120deg);
                                                    width: 6px;
                                                    height: 6px;
                                                    border-radius: 3px;
                                                    background: Theme.accent.with-alpha(0.72);
                                                }
                                                Rectangle {
                                                    x: 25px + 20px * sin(360deg * animation-tick() / 1.35s + 240deg);
                                                    y: 25px - 20px * cos(360deg * animation-tick() / 1.35s + 240deg);
                                                    width: 6px;
                                                    height: 6px;
                                                    border-radius: 3px;
                                                    background: Theme.accent.with-alpha(0.44);
                                                }
                                                Rectangle {
                                                    x: 23px;
                                                    y: 23px;
                                                    width: 10px;
                                                    height: 10px;
                                                    border-radius: 5px;
                                                    background: Theme.accent.with-alpha(0.18 + 0.22 * abs(sin(180deg * animation-tick() / 1s)));
                                                }
                                            }
                                            if root.response-state == "idle" : Rectangle {
                                                height: 64px;
                                                Image {
                                                    source: Icons.braces;
                                                    width: 64px;
                                                    height: 64px;
                                                    x: (parent.width - self.width) / 2;
                                                    colorize: Theme.fg.with-alpha(0.45);
                                                }
                                            }
                                            Text {
                                                text: root.response-state == "loading" ? "Sending request…"
                                                    : root.active-request-id <= 0 && root.selected-collection-id > 0 ? "Your new request is ready"
                                                    : "Your response will appear here";
                                                color: Theme.fg;
                                                font-size: 20px;
                                                font-weight: 700;
                                                horizontal-alignment: center;
                                            }
                                            Text {
                                                text: root.response-state == "loading" ? "Waiting for the server response. You can switch tabs while it continues."
                                                    : root.active-request-id <= 0 && root.selected-collection-id > 0 ? root.request-url == "" ? "Enter a URL above to start. Save it or press Ctrl+Enter to send and save." : "This is an unsaved draft. Save it, or press Ctrl+Enter to send and save."
                                                    : "Press Ctrl+Enter to send the request.";
                                                color: Theme.fg-2;
                                                font-size: Theme.fs-body;
                                                horizontal-alignment: center;
                                            }
                                        }

                                        if root.response-state != "idle" && root.response-state != "loading" && root.response-tab == "Body" : ResponseBody {
                                            width: parent.width;
                                            height: parent.height;
                                            raw: root.response-body;
                                            pretty: root.response-body-formatted;
                                            format: root.response-format;
                                            dark: root.dark-mode;
                                            large-response: root.response-large;
                                            tree-scope: "" + root.active-request-tab-key;
                                            tokenize-response(source, format, dark, max-columns) => { root.tokenize-response(source, format, dark, max-columns); }
                                            build-json-tree(scope, source, dark) => { root.build-json-tree(scope, source, dark); }
                                            toggle-json-tree-node(scope, path) => { root.toggle-json-tree-node(scope, path); }
                                            copy-all(text) => { root.copy-text(text); }
                                        }

                                        if root.response-state != "idle" && root.response-state != "loading" && root.response-tab == "Headers" && root.response-header-items.length == 0 : VerticalLayout {
                                            alignment: center;
                                            spacing: 6px;
                                            Text { text: "No response headers"; color: Theme.fg; font-size: Theme.fs-label; font-weight: 700; horizontal-alignment: center; }
                                            Text { text: "The server did not return any headers."; color: Theme.fg-3; font-size: Theme.fs-body; horizontal-alignment: center; }
                                        }

                                        if root.response-state != "idle" && root.response-state != "loading" && root.response-tab == "Headers" && root.response-header-items.length > 0 : ScrollView {
                                            mouse-drag-pan-enabled: true;
                                            content-width: self.width;
                                            content-height: max(self.height, response-header-list.preferred-height + 20px);

                                            response-header-list := VerticalLayout {
                                                x: 12px;
                                                y: 10px;
                                                width: parent.width - 24px;
                                                spacing: 0px;

                                                for item in root.response-header-items : Rectangle {
                                                    height: max(68px, header-value-measure.preferred-height + 24px);
                                                    border-radius: 6px;
                                                    background: header-touch.has-hover ? Theme.hover : transparent;
                                                    header-value-measure := Text {
                                                        visible: false;
                                                        x: 0px;
                                                        y: 0px;
                                                        width: max(80px, parent.width - 236px);
                                                        text: item.value;
                                                        color: Theme.fg;
                                                        font-family: Theme.font-mono;
                                                        font-size: Theme.fs-small;
                                                        wrap: char-wrap;
                                                    }
                                                    header-touch := TouchArea { }
                                                    HorizontalLayout {
                                                        padding-left: 10px;
                                                        padding-right: 10px;
                                                        spacing: 16px;
                                                        AdwSelectableText {
                                                            width: 200px;
                                                            text: item.name;
                                                            text-color: Theme.accent-text;
                                                            font-family: Theme.font-mono;
                                                            font-size: Theme.fs-small;
                                                            font-weight: 700;
                                                            wrap: word-wrap;
                                                        }
                                                        AdwSelectableText {
                                                            horizontal-stretch: 1;
                                                            text: item.value;
                                                            text-color: Theme.fg;
                                                            font-family: Theme.font-mono;
                                                            font-size: Theme.fs-small;
                                                            wrap: char-wrap;
                                                        }
                                                    }
                                                }
                                            }
                                        }

                                        if root.response-state != "idle" && root.response-state != "loading" && root.response-tab == "Cookies" && root.response-cookie-items.length == 0 : VerticalLayout {
                                            alignment: center;
                                            spacing: 6px;
                                            Text { text: "No cookies returned"; color: Theme.fg; font-size: Theme.fs-label; font-weight: 700; horizontal-alignment: center; }
                                            Text { text: "This response did not include any Set-Cookie values."; color: Theme.fg-3; font-size: Theme.fs-body; horizontal-alignment: center; }
                                        }

                                        if root.response-state != "idle" && root.response-state != "loading" && root.response-tab == "Cookies" && root.response-cookie-items.length > 0 : ScrollView {
                                            mouse-drag-pan-enabled: true;
                                            content-width: self.width;
                                            content-height: root.response-cookie-items.length * 96px + 20px;

                                            VerticalLayout {
                                                padding: 12px;
                                                spacing: 8px;
                                                alignment: start;

                                                for item in root.response-cookie-items : Rectangle {
                                                    height: 88px;
                                                    border-radius: 10px;
                                                    border-width: 1px;
                                                    border-color: Theme.border;
                                                    background: Theme.card-bg;

                                                    VerticalLayout {
                                                        padding: 12px;
                                                        spacing: 6px;
                                                        Text { text: item.name; color: Theme.fg; font-size: Theme.fs-body; font-weight: 700; }
                                                        Text { text: item.value == "" ? "(empty)" : item.value; color: Theme.fg-2; font-family: Theme.font-mono; font-size: Theme.fs-small; overflow: elide; }
                                                        if item.attributes != "" : Text { text: item.attributes; color: Theme.fg-3; font-size: Theme.fs-small; overflow: elide; }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // Drag handle between the panes
                            Rectangle {
                                x: 0px;
                                y: parent.height * root.split-ratio - 6px;
                                width: parent.width;
                                height: 12px;

                                Rectangle {
                                    width: 44px;
                                    height: 4px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: 2px;
                                    background: handle-touch.has-hover || handle-touch.pressed ? Theme.accent : Theme.border-strong;
                                }

                                handle-touch := TouchArea {
                                    mouse-cursor: MouseCursor.row-resize;
                                    moved => {
                                        root.split-ratio = Math.clamp(root.split-ratio + (self.mouse-y - self.pressed-y) / split-area.height, 0.25, 0.75);
                                    }
                                }
                            }
                        }
                    }
                    }
                }
            }
        }
            }
        }

        if root.show-shortcuts : ShortcutsDialog {
            x: root.shadow-margin;
            y: root.shadow-margin;
            width: parent.width - 2 * root.shadow-margin;
            height: parent.height - 2 * root.shadow-margin;
            primary-modifier: root.shortcut-modifier;
            alternate-modifier: root.shortcut-alt-modifier;
            close => { root.show-shortcuts = false; }
        }
        if root.show-about : AboutDialog {
            x: root.shadow-margin;
            y: root.shadow-margin;
            width: parent.width - 2 * root.shadow-margin;
            height: parent.height - 2 * root.shadow-margin;
            close => { root.show-about = false; }
        }
        if root.show-curl-import : CurlImportDialog {
            x: root.shadow-margin;
            y: root.shadow-margin;
            width: parent.width - 2 * root.shadow-margin;
            height: parent.height - 2 * root.shadow-margin;
            command <=> root.curl-import-command;
            error: root.curl-import-error;
            close => { root.show-curl-import = false; }
            import(command) => {
                let draft = root.parse-curl(command);
                if draft.error != "" {
                    root.curl-import-error = draft.error;
                } else {
                    root.active-method = draft.method;
                    root.request-url = draft.url;
                    root.request-header-rows = root.parse-header-rows("" + draft.headers);
                    root.request-headers = draft.headers;
                    root.request-params = "";
                    root.request-body = draft.body;
                    root.body-format = draft.body-format;
                    root.auth-type = draft.auth-type;
                    root.auth-value = draft.auth-value;
                    root.auth-secret = draft.auth-secret;
                    root.show-curl-import = false;
                    root.store-active-request-tab();
                }
            }
        }

        // ───────── Keyboard shortcuts ─────────
        KeyBinding { keys: @keys(Control + Return); enabled: root.app-shortcuts-enabled && root.active-view == "Request"; activated => { root.send-current-request(); } }
        KeyBinding { keys: @keys(Control + S); enabled: root.app-shortcuts-enabled && root.active-view == "Request"; activated => { root.save-current-request(); } }
        KeyBinding { keys: @keys(Control + N); enabled: root.app-shortcuts-enabled && root.selected-collection-id > 0; activated => { root.start-new-request(root.selected-collection-id, root.selected-collection-name); } }
        KeyBinding {
            keys: @keys(Control + Shift + N);
            enabled: root.app-shortcuts-enabled;
            activated => {
                root.begin-new-collection();
            }
        }
        KeyBinding { keys: @keys(F2); enabled: root.app-shortcuts-enabled && root.active-view == "Request"; activated => { root.begin-rename(); } }
        KeyBinding { keys: @keys(Control + L); enabled: root.app-shortcuts-enabled; activated => { root.active-view = "Request"; url-field.focus(); } }
        KeyBinding { keys: @keys(Control + K); enabled: root.app-shortcuts-enabled; activated => { root.show-navigation-sidebar = true; request-search-field.focus(); } }
        KeyBinding { keys: @keys(Control + F); enabled: root.app-shortcuts-enabled; activated => { root.show-navigation-sidebar = true; request-search-field.focus(); } }
        KeyBinding { keys: @keys(Control + B); enabled: root.app-shortcuts-enabled; activated => { root.show-navigation-sidebar = !root.show-navigation-sidebar; } }
        KeyBinding { keys: @keys(Control + W); enabled: root.app-shortcuts-enabled && root.active-view == "Request" && root.active-request-tab-index >= 0; activated => { root.close-request-tab(root.active-request-tab-index); } }
        KeyBinding { keys: @keys(Control + Tab); enabled: root.app-shortcuts-enabled && root.active-view == "Request"; activated => { root.cycle-request-tab(1); } }
        KeyBinding { keys: @keys(Control + Shift + Tab); enabled: root.app-shortcuts-enabled && root.active-view == "Request"; activated => { root.cycle-request-tab(-1); } }
        KeyBinding { keys: @keys(Control + Q); enabled: root.app-shortcuts-enabled; activated => { root.close(); } }
        KeyBinding { keys: @keys(Control + Digit1); enabled: root.app-shortcuts-enabled && root.active-view == "Request"; activated => { root.set-request-tab("Params"); } }
        KeyBinding { keys: @keys(Control + Digit2); enabled: root.app-shortcuts-enabled && root.active-view == "Request"; activated => { root.set-request-tab("Headers"); } }
        KeyBinding { keys: @keys(Control + Digit3); enabled: root.app-shortcuts-enabled && root.active-view == "Request"; activated => { root.set-request-tab("Body"); } }
        KeyBinding { keys: @keys(Control + Digit4); enabled: root.app-shortcuts-enabled && root.active-view == "Request"; activated => { root.set-request-tab("Auth"); } }
        KeyBinding { keys: @keys(Control + Digit6); enabled: root.app-shortcuts-enabled && root.active-view == "Request"; activated => { root.set-request-tab("Settings"); } }
        KeyBinding { keys: @keys(Alt + Digit1); enabled: root.app-shortcuts-enabled && root.active-view == "Request"; activated => { root.response-tab = "Body"; } }
        KeyBinding { keys: @keys(Alt + Digit2); enabled: root.app-shortcuts-enabled && root.active-view == "Request"; activated => { root.response-tab = "Headers"; } }
        KeyBinding { keys: @keys(Alt + Digit3); enabled: root.app-shortcuts-enabled && root.active-view == "Request"; activated => { root.response-tab = "Cookies"; } }
        KeyBinding { keys: @keys(Control + Shift + C); enabled: root.app-shortcuts-enabled && root.active-view == "Request"; activated => { root.copy-response(); } }
        KeyBinding { keys: @keys(Control + H); enabled: root.app-shortcuts-enabled; activated => { root.open-view("History"); } }
        KeyBinding { keys: @keys(Control + E); enabled: root.app-shortcuts-enabled; activated => { root.open-view("Environments"); } }
        KeyBinding { keys: @keys(Control + Shift + O); enabled: root.app-shortcuts-enabled; activated => { root.open-view("Collections"); } }
        KeyBinding { keys: @keys(F11); enabled: root.app-shortcuts-enabled; activated => { root.full-screen = !root.full-screen; } }
        KeyBinding { keys: @keys(F1); activated => { root.show-shortcuts = !root.show-shortcuts; } }
        KeyBinding { keys: @keys(Control + Slash); enabled: root.app-shortcuts-enabled; activated => { root.show-shortcuts = !root.show-shortcuts; } }
        KeyBinding {
            keys: @keys(Escape);
            activated => {
                if root.show-shortcuts {
                    root.show-shortcuts = false;
                } else if root.show-about {
                    root.show-about = false;
                } else if root.collection-menu-id > 0 {
                    root.collection-menu-id = -1;
                } else if root.confirm-delete-collection-id > 0 {
                    root.confirm-delete-collection-id = -1;
                } else if root.editing-request-name {
                    root.request-name-draft = root.active-request;
                    root.editing-request-name = false;
                } else if root.editing-collection-id > 0 {
                    root.editing-collection-id = -1;
                } else if root.show-new-collection {
                    root.show-new-collection = false;
                    root.new-collection-name = "";
                }
            }
        }
    }
}
