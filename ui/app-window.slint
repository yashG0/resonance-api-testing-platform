
import {
    Button,
    LineEdit,
    TextEdit,
    ScrollView
} from "std-widgets.slint";

export component AppWindow inherits Window {
    title: "Resonance";
    width: 1200px;
    height: 760px;

    
callback send-request(string, string, string, string, string);
in-out property <string> request-params: "name=Yash\npage=1";
in-out property <string> request-body: "{\n  \"name\": \"Yash\"\n}";
in-out property <string> request-headers: "Accept: application/json";
in-out property <string> response-status: "No response yet";
in-out property <string> response-body: "Send a request to inspect its response.";
in-out property <string> response-time: "---";
in-out property <bool> is-loading: false;

in-out property <bool> dark-mode: true;
in-out property <string> active-request: "Get Users";
in-out property <string> active-method: "GET";
in-out property <string> request-url: "https://httpbin.org/get";
in-out property <string> active-tab: "Body";



    property <color> window-bg: dark-mode ? #242424 : #f6f5f4;
    property <color> sidebar-bg: dark-mode ? #303030 : #ebebeb;
    property <color> panel-bg: dark-mode ? #2b2b2b : #ffffff;
    property <color> editor-bg: dark-mode ? #1e1e1e : #ffffff;
    property <color> border-color: dark-mode ? #454545 : #d8d5d2;
    property <color> text-primary: dark-mode ? #ffffff : #241f31;
    property <color> text-secondary: dark-mode ? #c0bfbc : #5e5c64;
    property <color> accent: #3584e4;
    property <color> selected-bg: dark-mode ? #454052 : #dce8f8;

    background: window-bg;

    HorizontalLayout {
        spacing: 0;

        // LEFT PANE — Navigation
        Rectangle {
            width: 220px;
            background: sidebar-bg;

            VerticalLayout {
                padding: 12px;
                spacing: 12px;

                HorizontalLayout {
                    spacing: 8px;
                    height: 38px;

                    Text {
                        text: "◉";
                        color: accent;
                        font-size: 22px;
                        vertical-alignment: center;
                    }

                    Text {
                        text: "Resonance";
                        color: text-primary;
                        font-size: 18px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }

                Button {
                    text: "+ New Request";
                    primary: true;

                    clicked => {
                        root.active-request = "New Request";
                        root.active-method = "GET";
                        root.request-url = "";
                        root.active-tab = "Body";
                    }
                }

                Rectangle {
                    height: 1px;
                    background: border-color;
                }

                Text {
                    text: "WORKSPACE";
                    color: text-secondary;
                    font-size: 11px;
                    font-weight: 700;
                }

                Button {
                    text: "Collections";
                    horizontal-stretch: 1;
                }

                Button {
                    text: "History";
                    horizontal-stretch: 1;
                }

                Button {
                    text: "Environments";
                    horizontal-stretch: 1;
                }

                Rectangle {
                    height: 1px;
                    background: border-color;
                }

                Text {
                    text: "COLLECTIONS";
                    color: text-secondary;
                    font-size: 11px;
                    font-weight: 700;
                }

                Button {
                    text: "Public API";
                    horizontal-stretch: 1;
                }

                Button {
                    text: "My Backend";
                    horizontal-stretch: 1;
                }

                Rectangle {
                    vertical-stretch: 1;
                    background: transparent;
                }

                Button {
                    text: root.dark-mode
                        ? "Light Appearance"
                        : "Dark Appearance";

                    clicked => {
                        root.dark-mode = !root.dark-mode;
                    }
                }

                Text {
                    text: "v0.1.0 · Early Development";
                    color: text-secondary;
                    font-size: 10px;
                    horizontal-alignment: center;
                }
            }
        }

        // MIDDLE PANE — Request list
        Rectangle {
            width: 250px;
            background: panel-bg;
            border-width: 1px;
            border-color: border-color;

            VerticalLayout {
                padding: 12px;
                spacing: 12px;

                Text {
                    text: "Requests";
                    color: text-primary;
                    font-size: 17px;
                    font-weight: 700;
                }

                LineEdit {
                    placeholder-text: "Search requests...";
                }

                Text {
                    text: "PUBLIC API";
                    color: text-secondary;
                    font-size: 11px;
                    font-weight: 700;
                }

                // GET request
                Rectangle {
                    height: 54px;
                    background: root.active-request == "Get Users"
                        ? selected-bg : transparent;
                    border-radius: 6px;

                    TouchArea {
                        clicked => {
                            root.active-request = "Get Users";
                            root.active-method = "GET";
                            root.request-url = "https://httpbin.org/get";
                        }
                    }

                    VerticalLayout {
                        padding: 8px;
                        spacing: 3px;

                        HorizontalLayout {
                            spacing: 8px;

                            Text {
                                text: "GET";
                                color: #2ec27e;
                                font-size: 11px;
                                font-weight: 700;
                            }

                            Text {
                                text: "Get Users";
                                color: text-primary;
                                font-size: 12px;
                                font-weight: 600;
                            }
                        }

                        Text {
                            text: "/get";
                            color: text-secondary;
                            font-size: 11px;
                        }
                    }
                }

                // POST request
                Rectangle {
                    height: 54px;
                    background: root.active-request == "Create User"
                        ? selected-bg : transparent;
                    border-radius: 6px;

                    TouchArea {
                        clicked => {
                            root.active-request = "Create User";
                            root.active-method = "POST";
                            root.request-url = "https://httpbin.org/post";
                        }
                    }

                    VerticalLayout {
                        padding: 8px;
                        spacing: 3px;

                        HorizontalLayout {
                            spacing: 8px;

                            Text {
                                text: "POST";
                                color: #3584e4;
                                font-size: 11px;
                                font-weight: 700;
                            }

                            Text {
                                text: "Create User";
                                color: text-primary;
                                font-size: 12px;
                                font-weight: 600;
                            }
                        }

                        Text {
                            text: "/post";
                            color: text-secondary;
                            font-size: 11px;
                        }
                    }
                }

                // PUT request
                Rectangle {
                    height: 54px;
                    background: root.active-request == "Update User"
                        ? selected-bg : transparent;
                    border-radius: 6px;

                    TouchArea {
                        clicked => {
                            root.active-request = "Update User";
                            root.active-method = "PUT";
                            root.request-url = "https://httpbin.org/put";
                        }
                    }

                    VerticalLayout {
                        padding: 8px;
                        spacing: 3px;

                        HorizontalLayout {
                            spacing: 8px;

                            Text {
                                text: "PUT";
                                color: #e5a50a;
                                font-size: 11px;
                                font-weight: 700;
                            }

                            Text {
                                text: "Update User";
                                color: text-primary;
                                font-size: 12px;
                                font-weight: 600;
                            }
                        }

                        Text {
                            text: "/put";
                            color: text-secondary;
                            font-size: 11px;
                        }
                    }
                }

                // DELETE request
                Rectangle {
                    height: 54px;
                    background: root.active-request == "Delete User"
                        ? selected-bg : transparent;
                    border-radius: 6px;

                    TouchArea {
                        clicked => {
                            root.active-request = "Delete User";
                            root.active-method = "DELETE";
                            root.request-url = "https://httpbin.org/delete";
                        }
                    }

                    VerticalLayout {
                        padding: 8px;
                        spacing: 3px;

                        HorizontalLayout {
                            spacing: 8px;

                            Text {
                                text: "DEL";
                                color: #e01b24;
                                font-size: 11px;
                                font-weight: 700;
                            }

                            Text {
                                text: "Delete User";
                                color: text-primary;
                                font-size: 12px;
                                font-weight: 600;
                            }
                        }

                        Text {
                            text: "/delete";
                            color: text-secondary;
                            font-size: 11px;
                        }
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                    background: transparent;
                }

                Text {
                    text: "4 example requests";
                    color: text-secondary;
                    font-size: 11px;
                }
            }
        }

        // RIGHT PANE — Request editor and response
        Rectangle {
            horizontal-stretch: 1;
            background: window-bg;

            VerticalLayout {
                padding: 20px;
                spacing: 16px;

                HorizontalLayout {
                    spacing: 8px;

                    Text {
                        text: root.active-request;
                        color: text-primary;
                        font-size: 21px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        background: transparent;
                    }

                    Button {
                        text: "Save";
                    }
                }

                // URL and method controls
                Rectangle {
                    background: panel-bg;
                    border-width: 1px;
                    border-color: border-color;
                    border-radius: 8px;

                    HorizontalLayout {
                        padding: 8px;
                        spacing: 8px;

                        Button {
                            width: 90px;
                            text: root.active-method;

                            clicked => {
                                root.active-method =
                                    root.active-method == "GET" ? "POST" :
                                    root.active-method == "POST" ? "PUT" :
                                    root.active-method == "PUT" ? "DELETE" :
                                    "GET";
                            }
                        }

                        LineEdit {
                            horizontal-stretch: 1;
                            text: root.request-url;
                            placeholder-text: "Enter request URL...";

                            edited(value) => {
                                root.request-url = value;
                            }
                        }

                        Button {
    text: root.is-loading ? "Sending..." : "Send";
    enabled: !root.is-loading && root.request-url != "";

    clicked => {
        root.is-loading = true;
        root.response-status = "Sending...";
        root.response-body = "Waiting for response...";
        root.response-time = "---";

        root.send-request(
    root.active-method,
    root.request-url,
    root.request-body,
    root.request-headers,
    root.request-params
);
    }
}
                    }
                }

                // Request configuration tabs
                HorizontalLayout {
                    spacing: 4px;

                    for tab in ["Params", "Headers", "Body", "Auth"] : Rectangle {
                        background: root.active-tab == tab
                            ? selected-bg : transparent;
                        border-radius: 5px;

                        HorizontalLayout {
                            padding: 10px;

                            Text {
                                text: tab;
                                color: root.active-tab == tab
                                    ? accent : text-secondary;
                                font-size: 12px;
                                font-weight: root.active-tab == tab ? 700 : 400;
                            }

                            TouchArea {
                                clicked => {
                                    root.active-tab = tab;
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: border-color;
                }

                Text {
                    text: "Request configuration";
                    color: text-primary;
                    font-size: 14px;
                    font-weight: 600;
                }

                
Rectangle {
    vertical-stretch: 1;
    min-height: 100px;
    background: panel-bg;
    border-width: 1px;
    border-color: border-color;
    border-radius: 8px;

    if root.active-tab == "Body" : TextEdit {
        text: root.request-body;
        font-family: "monospace";
        font-size: 12px;
        wrap: word-wrap;

        edited(value) => {
            root.request-body = value;
        }
    }

    if root.active-tab == "Headers" : TextEdit {
        text: root.request-headers;
        font-family: "monospace";
        font-size: 12px;
        wrap: word-wrap;

        edited(value) => {
            root.request-headers = value;
        }
    }

    if root.active-tab == "Params" : TextEdit {
    text: root.request-params;
    font-family: "monospace";
    font-size: 12px;
    wrap: word-wrap;

    edited(value) => {
        root.request-params = value;
    }
}

    if root.active-tab == "Auth" : Text {
        text: "Authentication support will be added later.";
        color: text-secondary;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}


                Rectangle {
                    vertical-stretch: 1;
                    background: transparent;
                }

                Rectangle {
                    height: 1px;
                    background: border-color;
                }

                HorizontalLayout {
    spacing: 12px;

    Text {
        text: "Response";
        color: text-primary;
        font-size: 16px;
        font-weight: 700;
    }

    Text {
        text: root.response-status;
        color: text-secondary;
        font-size: 12px;
    }

    Rectangle {
        horizontal-stretch: 1;
        background: transparent;
    }

    Text {
        text: root.response-time;
        color: text-secondary;
        font-size: 11px;
    }
}

                Rectangle {
                    height: 170px;
                    background: editor-bg;
                    border-width: 1px;
                    border-color: border-color;
                    border-radius: 8px;

                    
ScrollView {
    Text {
        text: root.response-body;
        color: text-primary;
        font-family: "monospace";
        font-size: 12px;
        wrap: word-wrap;
    }
}

                }
            }
        }
    }
}
