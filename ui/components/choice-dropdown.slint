import { ThemedButton } from "themed-button.slint";
import { Theme } from "theme.slint";

export component ChoiceDropdown inherits Rectangle {
    in property <[string]> options: [];
    in-out property <string> current-value: "";
    in property <bool> dark-mode: true;
    in property <bool> accent-button: false;
    in property <color> accent-color: #3584e4;

    callback selected(string);

    height: 36px;

    ThemedButton {
        width: 100%;
        height: parent.height;
        text: root.current-value + "  ▾";
        dark-mode: root.dark-mode;
        accent-button: root.accent-button;
        accent-color: root.accent-color;
        clicked => popup.show();
    }

    popup := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: root.width;
        height: root.options.length * 34px + 8px;
        close-policy: close-on-click-outside;

        Rectangle {
            background: Theme.popover-bg;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: 10px;
            drop-shadow-color: #00000066;
            drop-shadow-blur: 20px;
            drop-shadow-offset-y: 6px;

            VerticalLayout {
                padding: 4px;
                spacing: 2px;

                for option in root.options : Rectangle {
                    height: 32px;
                    border-radius: 7px;
                    background: option == root.current-value
                        ? (Theme.dark ? root.accent-color.with-alpha(0.24) : root.accent-color.with-alpha(0.14))
                        : option-touch.has-hover
                            ? Theme.hover
                            : transparent;

                    option-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.current-value = option;
                            root.selected(option);
                            popup.close();
                        }
                    }

                    Text {
                        x: 10px;
                        width: parent.width - 20px;
                        height: parent.height;
                        text: option;
                        font-family: Theme.font-ui;
                        color: option == root.current-value ? Theme.fg : Theme.fg-2;
                        font-size: Theme.fs-body;
                        font-weight: option == root.current-value ? 600 : 450;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
        }
    }
}
