import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Btn } from "btn.slint";

component Kbd inherits Rectangle {
    in property <string> label;
    height: 22px;
    min-width: 22px;
    preferred-width: t.preferred-width + 14px;
    border-radius: 5px;
    background: Theme.kbd-bg;
    border-width: 1px;
    border-color: Theme.border;
    t := Text {
        text: root.label;
        color: Theme.fg-2;
        font-size: Theme.fs-caption;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component Row inherits Rectangle {
    in property <string> label;
    in property <[string]> keys;
    height: 30px;
    HorizontalLayout {
        spacing: 12px;
        Text { text: root.label; color: Theme.fg; font-size: Theme.fs-body; vertical-alignment: center; horizontal-stretch: 1; }
        HorizontalLayout {
            spacing: 4px;
            alignment: end;
            for k in root.keys : Kbd { label: k; y: (parent.height - self.height) / 2; }
        }
    }
}

component Heading inherits Text {
    color: Theme.fg-3;
    font-size: Theme.fs-small;
    font-weight: 700;
    height: 30px;
    vertical-alignment: bottom;
}

export component ShortcutsDialog inherits Rectangle {
    callback close();
    background: Theme.overlay;

    TouchArea { clicked => { root.close(); } }

    Rectangle {
        width: min(660px, parent.width - 48px);
        height: min(600px, parent.height - 48px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.dialog-bg;
        border-radius: 14px;
        border-width: 1px;
        border-color: Theme.border-strong;
        clip: true;

        TouchArea { }

        VerticalLayout {
            HorizontalLayout {
                height: 56px;
                padding-left: 20px;
                padding-right: 10px;
                Text { text: "Keyboard shortcuts"; color: Theme.fg; font-size: Theme.fs-heading; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
                Btn { kind: "flat"; icon: Icons.x; y: 11px; clicked => { root.close(); } }
            }
            Rectangle { height: 1px; background: Theme.border; }
            ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    padding: 20px;
                    padding-top: 6px;
                    spacing: 0px;
                    Heading { text: "Requests"; }
                    Row { label: "Send request"; keys: ["Ctrl", "Enter"]; }
                    Row { label: "Save request"; keys: ["Ctrl", "S"]; }
                    Row { label: "New request"; keys: ["Ctrl", "N"]; }
                    Row { label: "New collection"; keys: ["Ctrl", "Shift", "N"]; }
                    Row { label: "Rename request"; keys: ["F2"]; }
                    Row { label: "Focus URL bar"; keys: ["Ctrl", "L"]; }
                    Row { label: "Search requests"; keys: ["Ctrl", "K"]; }
                    Row { label: "Request tabs: Params, Headers, Body, Auth"; keys: ["Ctrl", "1 – 4"]; }
                    Row { label: "Beautify / edit request body"; keys: ["Ctrl", "Shift", "F"]; }
                    Heading { text: "Response"; }
                    Row { label: "Response tabs: Body, Headers, Cookies"; keys: ["Alt", "1 – 3"]; }
                    Row { label: "Copy response body"; keys: ["Ctrl", "Shift", "C"]; }
                    Heading { text: "Navigation and view"; }
                    Row { label: "Collections"; keys: ["Ctrl", "Shift", "O"]; }
                    Row { label: "History"; keys: ["Ctrl", "H"]; }
                    Row { label: "Environments"; keys: ["Ctrl", "E"]; }
                    Row { label: "Toggle sidebar"; keys: ["Ctrl", "B"]; }
                    Row { label: "Full screen"; keys: ["F11"]; }
                    Row { label: "Show this dialog"; keys: ["F1"]; }
                    Row { label: "Close dialogs and menus"; keys: ["Esc"]; }
                }
            }
        }
    }
}
