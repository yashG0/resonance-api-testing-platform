
 // Resonance design tokens.
//
// Refined GNOME-inspired palette with layered charcoal surfaces.
export global Theme {
    in property <bool> dark: true;
    in property <color> accent: #3584e4;

    // Fonts
    out property <string> font-ui: "Adwaita Sans";
    out property <string> font-mono: "JetBrains Mono";

    // Type scale
    out property <length> fs-caption: 11px;
    out property <length> fs-small: 12px;
    out property <length> fs-body: 14px;
    out property <length> fs-label: 14px;
    out property <length> fs-heading: 17px;
    out property <length> fs-title: 22px;

    // Shape and rhythm
    out property <length> radius-card: 12px;
    out property <length> radius-control: 8px;
    out property <length> control-h: 34px;

    // ── Surfaces ────────────────────────────────────────────────────────
    out property <color> window-bg:     dark ? #171819 : #e5e5e5;
    out property <color> view-bg:       dark ? #202124 : #ffffff;
    out property <color> headerbar-bg:  dark ? #252629 : #e5e3e0;
    out property <color> sidebar-bg:    dark ? #1c1d1f : #f3f2f0;
    out property <color> card-bg:       dark ? #232427 : #ffffff;
    out property <color> dialog-bg:     dark ? #252629 : #ffffff;
    out property <color> popover-bg:    dark ? #292a2d : #ffffff;
    out property <color> input-bg:      dark ? #191a1c : #ffffff;
    out property <color> button-bg:     dark ? #303135 : #ffffff;
    out property <color> button-border: dark ? #414348 : #d5d3d1;
    out property <color> kbd-bg:        dark ? #36373b : #e9e8e7;
    out property <color> overlay: #00000099;

    // Code viewer
    out property <color> code-gutter:      dark ? #1d1e20 : #f5f6f8;
    out property <color> code-line-number: dark ? #9296a0 : #858b96;

    // Header bar separators and unfocused backdrop
    out property <color> headerbar-border:   dark ? #ffffff12 : #d4d2d0;
    out property <color> headerbar-backdrop: dark ? #222326 : #eae8e5;

    // ── Foreground ──────────────────────────────────────────────────────
    out property <color> fg:          dark ? #f5f5f5 : #241f31;
    out property <color> fg-2:        dark ? #c2c3c7 : #00000099;
    out property <color> fg-3:        dark ? #92949a : #00000073;
    out property <color> fg-disabled: dark ? #77797e : #0000005c;

    // ── Lines and states ────────────────────────────────────────────────
    out property <color> border:           dark ? #ffffff1b : #0000001c;
    out property <color> border-unfocused: dark ? #ffffff0c : #0000000e;
    out property <color> border-strong:    dark ? #ffffff30 : #00000032;
    out property <color> hover:            dark ? #ffffff0a : #00000009;
    out property <color> active:           dark ? #ffffff14 : #00000012;

    // ── Accent ──────────────────────────────────────────────────────────
    out property <color> accent-fg:   #ffffff;
    out property <color> accent-text: dark ? #78aeed : #1c71d8;
    out property <color> accent-bg:   accent;
    out property <color> accent-hover: accent.darker(0.12);

    // ── Semantic ────────────────────────────────────────────────────────
    out property <color> success:      dark ? #26a269 : #1b8553;
    out property <color> success-bg:   #26a26926;
    out property <color> warning:      dark ? #f5c211 : #9c6e03;
    out property <color> warning-bg:   #f5c21126;
    out property <color> danger:       dark ? #ff7b63 : #c01c28;
    out property <color> danger-bg:    #c01c2826;
    out property <color> destructive:  #c01c28;

    // ── HTTP method colors ─────────────────────────────────────────────
    pure public function method-color(method: string) -> color {
        if method == "GET" { return dark ? #57e389 : #26a269; }
        if method == "POST" { return dark ? #ffa348 : #c64600; }
        if method == "PUT" { return dark ? #62a0ea : #1c71d8; }
        if method == "PATCH" { return dark ? #dc8add : #813d9c; }
        if method == "DELETE" { return dark ? #ff7b63 : #c01c28; }
        return dark ? #c0bfbc : #5e5c64;
    }

    // Filled method selectors retain readable white labels.
    pure public function method-button-color(method: string) -> color {
        if method == "GET" { return dark ? #176b3a : #1f7a4b; }
        if method == "POST" { return dark ? #8a4300 : #a84300; }
        if method == "PUT" { return dark ? #245c9b : #1c71d8; }
        if method == "PATCH" { return dark ? #713b83 : #813d9c; }
        if method == "DELETE" { return dark ? #9b3028 : #c01c28; }
        return dark ? #4b4a48 : #5e5c64;
    }
}
