import { Theme } from "theme.slint";

// Legacy button kept for components that still reference it (e.g. ChoiceDropdown).
// Prefer the themed `Btn` component for new UI.
export component ThemedButton inherits Rectangle {
    in property <string> text: "";
    in property <image> icon;
    in property <bool> dark-mode: true;
    in property <bool> accent-button: false;
    in property <bool> destructive-button: false;
    in property <bool> enabled: true;
    in property <color> accent-color: #3584e4;
    in property <color> hover-accent-color: root.accent-color.brighter(0.08);
    in property <color> pressed-accent-color: root.accent-color.darker(0.12);

    callback clicked();

    height: 36px;
    border-radius: root.accent-button ? 9px : 7px;
    clip: true;

    background: {
        if (!root.enabled) {
            return Theme.input-bg;
        }
        if (root.accent-button) {
            return touch.pressed ? root.pressed-accent-color
                : touch.has-hover ? root.hover-accent-color
                : root.accent-color;
        }
        if (root.destructive-button && (touch.has-hover || touch.pressed)) {
            return Theme.danger-bg;
        }
        if (touch.pressed) {
            return Theme.active;
        }
        if (touch.has-hover) {
            return Theme.hover;
        }
        return Theme.button-bg;
    }

    border-width: root.accent-button ? 0px : 1px;
    border-color: Theme.button-border;

    HorizontalLayout {
        x: 5px;
        y: 0px;
        width: parent.width - 10px;
        height: parent.height;
        spacing: 6px;
        alignment: center;

        if root.icon.width > 0 && root.icon.height > 0 : Image {
            y: (parent.height - self.height) / 2;
            width: 16px;
            height: 16px;
            source: root.icon;
            image-fit: contain;
            colorize: {
                if (!root.enabled) {
                    return Theme.fg-disabled;
                }
                if (root.accent-button || (root.destructive-button && (touch.has-hover || touch.pressed))) {
                    return Theme.accent-fg;
                }
                if (root.destructive-button) {
                    return Theme.danger;
                }
                return Theme.fg;
            }
        }

        if root.text != "" : Text {
            text: root.text;
            max-width: parent.width - (root.icon.width > 0 ? 28px : 10px);
            overflow: elide;
            color: {
                if (!root.enabled) {
                    return Theme.fg-disabled;
                }
                if (root.accent-button || (root.destructive-button && (touch.has-hover || touch.pressed))) {
                    return Theme.accent-fg;
                }
                if (root.destructive-button) {
                    return Theme.danger;
                }
                return Theme.fg;
            }
            horizontal-alignment: center;
            vertical-alignment: center;
            font-size: Theme.fs-body;
            font-weight: root.accent-button ? 600 : 500;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}
