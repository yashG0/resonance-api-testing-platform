import { ThemedButton } from "themed-button.slint";
import { AdwLineEdit } from "adw-inputs.slint";
import { Theme } from "theme.slint";

export struct KeyValueRow {
    key: string,
    value: string,
    enabled: bool,
}

export component KeyValueEditor inherits Rectangle {
    in-out property <[KeyValueRow]> rows: [];
    in property <string> key-placeholder: "Key";
    in property <string> value-placeholder: "Value";
    in property <string> add-label: "Add row";
    in property <bool> dark-mode: true;
    in property <color> accent-color: #3584e4;
    callback changed([KeyValueRow]);

    background: transparent;

    VerticalLayout {
        padding: 12px;
        spacing: 8px;

        HorizontalLayout {
            height: 24px;
            spacing: 8px;
            Text { text: "Key"; color: Theme.fg-3; font-size: 10px; font-weight: 600; horizontal-stretch: 1; vertical-alignment: center; }
            Text { text: "Value"; color: Theme.fg-3; font-size: 10px; font-weight: 600; horizontal-stretch: 2; vertical-alignment: center; }
            Rectangle { width: 34px; background: transparent; }
        }

        if root.rows.length == 0 : Text {
            text: "No rows yet. Add a key and value to get started.";
            color: Theme.fg-3;
            font-size: 11px;
            height: 32px;
            vertical-alignment: center;
        }

        for row[index] in root.rows : Rectangle {
            height: 36px;
            border-radius: 6px;
            background: row-touch.has-hover ? Theme.hover : transparent;

            row-touch := TouchArea {
                width: parent.width;
                height: parent.height;
            }

            HorizontalLayout {
                spacing: 8px;

                Rectangle {
                    width: 22px;
                    height: 30px;
                    background: transparent;
                    TouchArea {
                        clicked => {
                            let updated = root.rows;
                            updated.remove(index);
                            updated.insert(index, { key: row.key, value: row.value, enabled: !row.enabled });
                            root.rows = updated;
                            root.changed(root.rows);
                        }
                    }
                    Text {
                        text: row.enabled ? "☑" : "□";
                        color: row.enabled ? root.accent-color : Theme.fg-3;
                        font-size: 16px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                AdwLineEdit {
                    horizontal-stretch: 1;
                    text: row.key;
                    placeholder-text: root.key-placeholder;
                    edited(value) => {
                        let updated = root.rows;
                        updated.remove(index);
                        updated.insert(index, { key: value, value: row.value, enabled: row.enabled });
                        root.rows = updated;
                        root.changed(root.rows);
                    }
                }
                AdwLineEdit {
                    horizontal-stretch: 2;
                    text: row.value;
                    placeholder-text: root.value-placeholder;
                    edited(value) => {
                        let updated = root.rows;
                        updated.remove(index);
                        updated.insert(index, { key: row.key, value: value, enabled: row.enabled });
                        root.rows = updated;
                        root.changed(root.rows);
                    }
                }
                ThemedButton {
                    width: 34px;
                    text: "×";
                    dark-mode: root.dark-mode;
                    accent-button: false;
                    destructive-button: true;
                    clicked => {
                        let updated = root.rows;
                        updated.remove(index);
                        root.rows = updated;
                        root.changed(root.rows);
                    }
                }
            }
        }

        ThemedButton {
            width: 112px;
            height: 32px;
            text: "+ " + root.add-label;
            dark-mode: root.dark-mode;
            accent-button: false;
            clicked => {
                let updated = root.rows;
                updated.push({ key: "", value: "", enabled: true });
                root.rows = updated;
                root.changed(root.rows);
            }
        }
    }
}
