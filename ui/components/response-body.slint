import { AdwTextEdit } from "adw-inputs.slint";
import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Btn } from "btn.slint";
import { TabBar } from "tab-bar.slint";
import { ScrollView } from "std-widgets.slint";

export struct JsonToken {
    text: string,
    color: color,
}

export struct JsonLine {
    number: int,
    tokens: [JsonToken],
}

export struct JsonTreeNode {
    depth: int,
    key-label: string,
    preview: string,
    path: string,
    has-children: bool,
    expanded: bool,
    key-color: color,
    value-color: color,
}

// Selectable, copyable response body with a slim toolbar (Pretty/Raw only when a distinct
// pretty version exists, line wrapping, Copy). Emoji render via the renderer's font fallback.
export component ResponseBody inherits Rectangle {
    in property <string> raw;
    in property <string> pretty;
    in-out property <string> mode: "Pretty";
    in-out property <bool> wrap-lines: false;
    callback copy-all(string);
    callback tokenize-response(string, string, bool, float) -> [JsonLine];
    callback build-json-tree(string, string, bool) -> [JsonTreeNode];
    callback toggle-json-tree-node(string, string);
    in property <string> format: "JSON";
    in property <bool> dark: true;
    in property <bool> large-response: false;

    property <bool> structured-format: root.format == "JSON" || root.format == "HTML" || root.format == "XML";
    property <bool> has-pretty: root.structured-format || (root.pretty != "" && root.pretty != root.raw);
    property <string> displayed-text: (root.has-pretty && root.mode == "Pretty" && root.pretty != "") ? root.pretty : root.raw;
    in property <string> tree-scope;
    in-out property <[JsonTreeNode]> tree-nodes: [];
    property <float> wrap-columns: max(16, (root.width - 72px) / 8px);

in-out property <[JsonLine]> json-lines: [];

function refresh-json-lines() {
    if (root.structured-format && root.mode == "Pretty" && !root.large-response) {
        root.json-lines = root.tokenize-response(
            root.displayed-text,
            root.format,
            root.dark,
            root.wrap-lines ? root.wrap-columns : 0
        );
    } else {
        root.json-lines = [];
    }
}

function refresh-tree() {
    if (root.format == "JSON" && root.mode == "Tree" && !root.large-response) {
        root.tree-nodes = root.build-json-tree(root.tree-scope, root.raw, root.dark);
    } else {
        root.tree-nodes = [];
    }
}

function toggle-tree-node(path: string) {
    root.toggle-json-tree-node(root.tree-scope, path);
    root.refresh-tree();
}
    background: Theme.view-bg;
    border-radius: Theme.radius-card;
    clip: true;

    init => {
    root.mode = "Pretty";
    root.refresh-json-lines();
    root.refresh-tree();
}

changed displayed-text => {
    root.refresh-json-lines();
}

changed format => {
    if root.mode == "Tree" && root.format != "JSON" { root.mode = "Pretty"; }
    root.refresh-json-lines();
    root.refresh-tree();
}

changed raw => {
    root.refresh-tree();
}

changed mode => {
    root.refresh-json-lines();
    root.refresh-tree();
}

changed tree-scope => {
    root.refresh-tree();
}

changed large-response => {
    root.refresh-tree();
}

changed dark => {
    root.refresh-json-lines();
    root.refresh-tree();
}

changed width => {
    root.refresh-json-lines();
}

changed wrap-lines => {
    root.refresh-json-lines();
}

    VerticalLayout {
        spacing: 0px;

        HorizontalLayout {
            // Match the request/response header rhythm while keeping the action row compact.
            height: 44px;
            padding-left: 12px;
            padding-right: 12px;
            spacing: 8px;

            if root.has-pretty : VerticalLayout {
                height: 44px;
                alignment: center;
                TabBar {
                    style: "pill";
                    height: 30px;
                    tabs: root.format == "JSON" ? ["Tree", "Pretty", "Raw"] : ["Pretty", "Raw"];
                    current: root.mode;
                    selected(m) => { root.mode = m; }
                }
            }
            Rectangle { horizontal-stretch: 1; }
            if root.mode != "Tree" : VerticalLayout {
                height: 44px;
                alignment: center;
                Btn {
                    height: 30px;
                    kind: "flat";
                    icon: Icons.wrap;
                    text: "Wrap";
                    active: root.wrap-lines;
                    clicked => { root.wrap-lines = !root.wrap-lines; }
                }
            }
            VerticalLayout {
                height: 44px;
                alignment: center;
                Btn {
                    height: 30px;
                    kind: "default";
                    icon: Icons.copy;
                    text: "Copy";
                    clicked => { root.copy-all(root.displayed-text); }
                }
            }
        }

        Rectangle { height: 1px; background: Theme.border; }

        if root.format == "JSON" && root.mode == "Tree" && !root.large-response : Rectangle {
            vertical-stretch: 1;
            background: Theme.view-bg;
            clip: true;
            ScrollView {
                width: parent.width;
                height: parent.height;
                content-width: self.width;
                content-height: max(self.height, root.tree-nodes.length * 28px + 12px);
                VerticalLayout {
                    x: 6px;
                    y: 6px;
                    width: parent.width - 12px;
                    spacing: 0px;
                    for node in root.tree-nodes : Rectangle {
                        height: 27px;
                        border-radius: 4px;
                        background: tree-row.has-hover ? Theme.hover : transparent;
                        tree-row := TouchArea {
                            mouse-cursor: node.has-children ? pointer : default;
                            clicked => { if node.has-children { root.toggle-tree-node(node.path); } }
                        }
                        HorizontalLayout {
                            spacing: 0px;
                            Rectangle {
                                width: 20px + node.depth * 18px;
                                height: parent.height;
                                Text {
                                    x: 0px;
                                    width: 20px;
                                    height: parent.height;
                                    text: node.has-children ? (node.expanded ? "▾" : "▸") : "";
                                    color: Theme.accent-text;
                                    font-size: 13px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                            Text {
                                text: node.key-label;
                                color: node.key-color;
                                font-family: Theme.font-mono;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                            Text {
                                text: node.preview;
                                color: node.value-color;
                                font-family: Theme.font-mono;
                                font-size: 12px;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }
                }
            }
        }

        if root.format == "JSON" && root.mode == "Tree" && root.large-response : Rectangle {
            vertical-stretch: 1;
            background: Theme.view-bg;
            Text {
                text: "Tree view is unavailable for large responses. Switch to Pretty or Raw to inspect the body.";
                color: Theme.fg-3;
                font-size: Theme.fs-body;
                horizontal-alignment: center;
                vertical-alignment: center;
                wrap: word-wrap;
            }
        }

        // Keep structured bodies in the token renderer in both wrap modes so colors
        // and line numbers remain intact when long lines flow to the next display row.
        if root.structured-format && root.mode == "Pretty" && !root.large-response : Rectangle {
            // ScrollView has no background property; paint the containing surface.
            vertical-stretch: 1;
            background: Theme.view-bg;
            clip: true;

            ScrollView {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                content-width: self.width;
                content-height: max(self.height, root.json-lines.length * 22px + 16px);

                VerticalLayout {
                    padding-top: 8px;
                    width: parent.width;
                    spacing: 0px;

                    for line in root.json-lines : HorizontalLayout {
                        height: 22px;
                        spacing: 0px;
                        Rectangle {
                            width: 42px;
                            height: parent.height;
                            background: Theme.code-gutter;
                            Text {
                                x: 0px;
                                width: parent.width - 8px;
                                height: parent.height;
                                text: line.number > 0 ? "" + line.number : "";
                                color: Theme.code-line-number;
                                font-family: Theme.font-mono;
                                font-size: 12px;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }
                        }
                        Rectangle { width: 1px; height: parent.height; background: Theme.border-unfocused; }
                        HorizontalLayout {
                            // Keep tokens packed in source order. Without explicit
                            // start alignment and zero stretch, the layout can spread
                            // key, colon, and value across the full available width.
                            alignment: start;
                            padding-left: 12px;
                            height: parent.height;
                            spacing: 0px;
                            for token in line.tokens : Text {
                                text: token.text;
                                color: token.color;
                                font-family: Theme.font-mono;
                                font-size: 13px;
                                horizontal-stretch: 0;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // Slint conditional elements are separate siblings; use the inverse
        // condition rather than an `else` element branch.
        if (!root.structured-format || root.mode == "Raw" || root.large-response) && !(root.format == "JSON" && root.mode == "Tree") : AdwTextEdit {
            vertical-stretch: 1;
            read-only: true;
            wrap: root.wrap-lines
                ? (root.format == "JSON" && root.mode == "Pretty" ? TextWrap.char-wrap : TextWrap.word-wrap)
                : TextWrap.no-wrap;
            font-family: Theme.font-mono;
            font-size: 13px;
            text: root.displayed-text;
        }
    }

    if root.raw == "" && root.pretty == "" : Rectangle {
        // Empty-state overlay. Kept below the toolbar so Copy/Wrap stay reachable.
        x: 0px;
        y: 42px;
        width: parent.width;
        height: parent.height - 42px;
        background: transparent;
        Text {
            text: "The server returned an empty response body.";
            color: Theme.fg-3;
            font-size: Theme.fs-body;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
